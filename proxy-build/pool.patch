diff --git a/sdk/cliproxy/live_models.go b/sdk/cliproxy/live_models.go
new file mode 100644
index 0000000000000000000000000000000000000000..bc4c7e034037ae6a03f9186e715ef37029bbf452
--- /dev/null
+++ b/sdk/cliproxy/live_models.go
@@ -0,0 +1,959 @@
+package cliproxy
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/clientversion"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/livemodels"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/util"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// Live model lists: every OAuth credential of a provider with a live source
+// registers the models its own account reports, read from the provider with
+// that credential, instead of the shared static catalog. A model offered to
+// two accounts but not a third is therefore registered, and routed, only to
+// those two (conductor selection uses ClientSupportsModel), and a model the
+// provider retired disappears. The last good list per credential survives a
+// failed read and, through the cache file, a restart. A credential that has
+// never produced a list serves no models: the static catalog lists models an
+// account may not be able to reach, so it is only used with live lists off.
+
+const (
+	liveModelsDefaultInterval = 15 * time.Minute
+	liveModelsMinInterval     = time.Minute
+	// liveModelsRetryInterval spaces reads for a credential that has no
+	// live list yet and therefore serves no models, and for one whose last
+	// read failed, so a transient failure (DNS on wake from sleep) clears
+	// within about a minute instead of a full refresh interval.
+	liveModelsRetryInterval = time.Minute
+	liveModelsTick          = 30 * time.Second
+	liveModelsFetchTimeout  = 20 * time.Second
+	// liveModelsVersionWait bounds how long the first pass waits for the
+	// installed client versions, which select what the providers return.
+	liveModelsVersionWait = 20 * time.Second
+	liveModelsMaxBody     = 8 << 20
+	liveModelsMaxPages    = 10
+	liveModelsCacheFormat = 1
+
+	anthropicModelsURL = "https://api.anthropic.com/v1/models"
+	codexModelsURL     = "https://chatgpt.com/backend-api/codex/models"
+)
+
+// liveModelList is one credential's last good list.
+type liveModelList struct {
+	Provider string `json:"provider"`
+	// Account identifies the account the list was read for, so a credential
+	// file replaced with another account never inherits it.
+	Account   string       `json:"account"`
+	FetchedAt time.Time    `json:"fetched_at"`
+	Models    []*ModelInfo `json:"models"`
+	// Templates are the provider's own Codex client templates (Codex only).
+	Templates []map[string]any `json:"templates,omitempty"`
+}
+
+type liveModelsCache struct {
+	Format int                       `json:"format"`
+	Lists  map[string]*liveModelList `json:"lists"`
+}
+
+// liveModelFetcher reads one credential's list from its provider.
+type liveModelFetcher func(ctx context.Context, cfg *config.Config, auth *coreauth.Auth) (*liveModelList, error)
+
+// liveModelSources maps provider ids to their live list readers. Adding a
+// provider here is all it takes to route it on live lists.
+var liveModelSources = map[string]liveModelFetcher{
+	"claude": fetchClaudeLiveModels,
+	"codex":  fetchCodexLiveModels,
+}
+
+type liveModelAttempt struct {
+	at  time.Time
+	err string
+	// account the attempt was made for; a replaced credential is due at once.
+	account string
+}
+
+type liveModelManager struct {
+	service *Service
+	fetch   map[string]liveModelFetcher
+	now     func() time.Time
+
+	mu        sync.RWMutex
+	persistMu sync.Mutex
+	lists     map[string]*liveModelList
+	attempts  map[string]liveModelAttempt
+	cacheFile string
+	// active records whether live lists were enabled on the last pass, so a
+	// disable re-registers the static catalog once.
+	active bool
+	// deactivated: switched off at runtime; the next enabled pass restores the
+	// cache and re-registers.
+	deactivated bool
+
+	wake chan struct{}
+	// full asks the loop to re-read every credential now.
+	full chan struct{}
+	// firstPass is closed once the first pass has read every credential.
+	firstPass     chan struct{}
+	firstPassOnce sync.Once
+}
+
+func newLiveModelManager(s *Service) *liveModelManager {
+	return &liveModelManager{
+		service:   s,
+		fetch:     liveModelSources,
+		now:       time.Now,
+		lists:     map[string]*liveModelList{},
+		attempts:  map[string]liveModelAttempt{},
+		wake:      make(chan struct{}, 1),
+		full:      make(chan struct{}, 1),
+		firstPass: make(chan struct{}),
+	}
+}
+
+// settledFirstPass reports whether the first pass is done (true without a
+// manager, as in home mode).
+func (m *liveModelManager) settledFirstPass() bool {
+	if m == nil {
+		return true
+	}
+	select {
+	case <-m.firstPass:
+		return true
+	default:
+		return false
+	}
+}
+
+// liveModelsSettings returns whether live lists are on, the refresh interval
+// and the cache file from the current config.
+func liveModelsSettings(cfg *config.Config) (bool, time.Duration, string) {
+	if cfg == nil || !cfg.LiveModels.Enabled {
+		return false, 0, ""
+	}
+	interval := liveModelsDefaultInterval
+	if raw := strings.TrimSpace(cfg.LiveModels.RefreshInterval); raw != "" {
+		if parsed, err := time.ParseDuration(raw); err == nil && parsed > 0 {
+			interval = parsed
+		} else {
+			log.Warnf("live-models: invalid refresh-interval %q, using %s", raw, liveModelsDefaultInterval)
+		}
+	}
+	if interval < liveModelsMinInterval {
+		interval = liveModelsMinInterval
+	}
+	return true, interval, strings.TrimSpace(cfg.LiveModels.CacheFile)
+}
+
+func (s *Service) currentConfig() *config.Config {
+	if s == nil {
+		return nil
+	}
+	s.cfgMu.RLock()
+	defer s.cfgMu.RUnlock()
+	return s.cfg
+}
+
+// configureInstalledClients points version detection at the configured
+// binaries; unchanged paths keep their cached versions.
+func configureInstalledClients(cfg *config.Config) {
+	var clients config.InstalledClientsConfig
+	if cfg != nil {
+		clients = cfg.InstalledClients
+	}
+	clientversion.Configure(map[clientversion.Client]string{
+		clientversion.ClaudeCode: clients.ClaudeCode,
+		clientversion.Codex:      clients.Codex,
+	})
+}
+
+// liveModelIdentityKeys are the credential metadata fields that identify the
+// account (and, for Claude, the organization) a list was read for.
+var liveModelIdentityKeys = []string{"account_uuid", "organization_uuid", "account_id", "email"}
+
+// liveModelAccount identifies the account behind a credential from every
+// identity field it carries. Lists are only used for the account they were
+// read for. It returns "" when the credential carries none of them.
+func liveModelAccount(auth *coreauth.Auth) string {
+	if auth == nil {
+		return ""
+	}
+	parts := make([]string, 0, len(liveModelIdentityKeys))
+	for _, key := range liveModelIdentityKeys {
+		if value, ok := auth.Metadata[key].(string); ok && strings.TrimSpace(value) != "" {
+			parts = append(parts, key+"="+strings.ToLower(strings.TrimSpace(value)))
+		}
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return strings.ToLower(strings.TrimSpace(auth.Provider)) + "|" + strings.Join(parts, "|")
+}
+
+// listFor returns auth's list when it was read for the same account; mu held.
+func (m *liveModelManager) listForLocked(auth *coreauth.Auth) *liveModelList {
+	list := m.lists[auth.ID]
+	if list == nil || list.Account != liveModelAccount(auth) {
+		return nil
+	}
+	return list
+}
+
+// liveModelEligible reports whether auth routes on a live list.
+func (m *liveModelManager) eligible(auth *coreauth.Auth) bool {
+	if m == nil || auth == nil || auth.ID == "" || auth.Disabled {
+		return false
+	}
+	if _, ok := m.fetch[strings.ToLower(strings.TrimSpace(auth.Provider))]; !ok {
+		return false
+	}
+	return !strings.EqualFold(auth.AuthKind(), coreauth.AuthKindAPIKey)
+}
+
+// liveModelsForAuth reports whether auth's models come from its live list
+// (managed) and returns a copy of the list. A managed credential whose list has
+// not been read yet gets no models, so it is not routed until its provider says
+// what it may use; the loop is asked for a prompt read. Unmanaged credentials
+// (live lists off, API keys, other providers) use the caller's static models.
+func (s *Service) liveModelsForAuth(auth *coreauth.Auth) (models []*ModelInfo, managed bool) {
+	if s == nil || s.liveModels == nil {
+		return nil, false
+	}
+	m := s.liveModels
+	if enabled, _, _ := liveModelsSettings(s.currentConfig()); !enabled || !m.eligible(auth) {
+		return nil, false
+	}
+	m.mu.RLock()
+	list := m.listForLocked(auth)
+	if list != nil {
+		models = cloneLiveModels(list.Models)
+	}
+	m.mu.RUnlock()
+	if list == nil {
+		m.nudge()
+		return nil, true
+	}
+	return models, true
+}
+
+func (m *liveModelManager) nudge() {
+	select {
+	case m.wake <- struct{}{}:
+	default:
+	}
+}
+
+// RefreshAll asks for an immediate read of every credential's list.
+func (m *liveModelManager) RefreshAll() bool {
+	if m == nil {
+		return false
+	}
+	select {
+	case m.full <- struct{}{}:
+	default:
+	}
+	return true
+}
+
+func (m *liveModelManager) forget(authID string) {
+	if m == nil || authID == "" {
+		return
+	}
+	m.mu.Lock()
+	_, had := m.lists[authID]
+	delete(m.lists, authID)
+	delete(m.attempts, authID)
+	m.mu.Unlock()
+	livemodels.Forget(authID)
+	if had {
+		m.persist()
+		m.applyCodexTemplates()
+	}
+}
+
+// loadCache restores the last good lists. It runs before the first auth
+// registration so a restart routes on live lists from its first request.
+func (m *liveModelManager) loadCache() {
+	enabled, _, file := liveModelsSettings(m.service.currentConfig())
+	m.mu.Lock()
+	m.cacheFile = file
+	m.mu.Unlock()
+	if !enabled || file == "" {
+		return
+	}
+	data, err := os.ReadFile(file)
+	if err != nil {
+		if !errors.Is(err, os.ErrNotExist) {
+			log.Warnf("live-models: cannot read cache %s: %v", file, err)
+		}
+		return
+	}
+	var cache liveModelsCache
+	if err = json.Unmarshal(data, &cache); err != nil || cache.Format != liveModelsCacheFormat {
+		log.Warnf("live-models: ignoring unreadable cache %s (format %d): %v", file, cache.Format, err)
+		return
+	}
+	loaded := 0
+	m.mu.Lock()
+	for authID, list := range cache.Lists {
+		if authID == "" || validLiveModelList(list) != nil {
+			continue
+		}
+		m.lists[authID] = list
+		loaded++
+		livemodels.Publish(authID, livemodels.Status{Source: livemodels.SourceLive, FetchedAt: list.FetchedAt, Models: len(list.Models)})
+	}
+	m.active = loaded > 0
+	m.mu.Unlock()
+	if loaded > 0 {
+		m.applyCodexTemplates()
+		log.Infof("live-models: restored %d credential model lists from %s", loaded, file)
+	}
+}
+
+// persist writes the lists. Writers are serialized and each marshals the state
+// current when it runs, so the last write carries the latest lists.
+func (m *liveModelManager) persist() {
+	m.persistMu.Lock()
+	defer m.persistMu.Unlock()
+	m.mu.RLock()
+	file := m.cacheFile
+	cache := liveModelsCache{Format: liveModelsCacheFormat, Lists: make(map[string]*liveModelList, len(m.lists))}
+	for id, list := range m.lists {
+		// Without an account identity a restart could not tell a replaced
+		// credential from the original, so such lists stay in memory only.
+		if list.Account != "" {
+			cache.Lists[id] = list
+		}
+	}
+	data, err := json.Marshal(cache)
+	m.mu.RUnlock()
+	if file == "" {
+		return
+	}
+	if err == nil {
+		err = writeFileAtomic(file, data)
+	}
+	if err != nil {
+		log.Warnf("live-models: cannot write cache %s: %v", file, err)
+	}
+}
+
+func writeFileAtomic(file string, data []byte) error {
+	if err := os.MkdirAll(filepath.Dir(file), 0o700); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(file), filepath.Base(file)+".*.tmp")
+	if err != nil {
+		return err
+	}
+	_, err = tmp.Write(data)
+	if errClose := tmp.Close(); err == nil {
+		err = errClose
+	}
+	if err == nil {
+		err = os.Rename(tmp.Name(), file)
+	}
+	if err != nil {
+		_ = os.Remove(tmp.Name())
+	}
+	return err
+}
+
+// applyCodexTemplates publishes the union of the Codex credentials' client
+// templates (first credential by id wins per slug) to the client catalog. Only
+// lists read for the account a current credential holds contribute.
+func (m *liveModelManager) applyCodexTemplates() {
+	m.mu.RLock()
+	lists := make(map[string]*liveModelList, len(m.lists))
+	ids := make([]string, 0, len(m.lists))
+	for id, list := range m.lists {
+		if strings.EqualFold(list.Provider, "codex") {
+			ids = append(ids, id)
+			lists[id] = list
+		}
+	}
+	m.mu.RUnlock()
+	sort.Strings(ids)
+	var templates []map[string]any
+	for _, id := range ids {
+		if m.service != nil && m.service.coreManager != nil {
+			if auth, ok := m.service.coreManager.GetByID(id); !ok || auth == nil || liveModelAccount(auth) != lists[id].Account {
+				continue
+			}
+		}
+		templates = append(templates, lists[id].Templates...)
+	}
+	if _, rejected := registry.SetCodexClientLiveTemplates(templates); len(rejected) > 0 {
+		for _, err := range rejected {
+			log.Warnf("live-models: %v", err)
+		}
+	}
+}
+
+// run reads lists until ctx ends: every credential on the first pass, then
+// each one when its interval is due, credentials without a list or whose last
+// read failed every minute,
+// and all of them on RefreshAll.
+func (m *liveModelManager) run(ctx context.Context) {
+	versionCtx, cancel := context.WithTimeout(ctx, liveModelsVersionWait)
+	for _, client := range clientversion.Clients {
+		clientversion.Await(versionCtx, client)
+	}
+	cancel()
+	m.pass(ctx, true)
+	m.firstPassOnce.Do(func() { close(m.firstPass) })
+	ticker := time.NewTicker(liveModelsTick)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-m.full:
+			m.pass(ctx, true)
+		case <-m.wake:
+			m.pass(ctx, false)
+		case <-ticker.C:
+			m.pass(ctx, false)
+		}
+	}
+}
+
+func (m *liveModelManager) pass(ctx context.Context, all bool) {
+	s := m.service
+	if s == nil || s.coreManager == nil || ctx.Err() != nil {
+		return
+	}
+	enabled, interval, file := liveModelsSettings(s.currentConfig())
+	if !enabled {
+		m.deactivate()
+		return
+	}
+	m.mu.Lock()
+	reactivated := m.deactivated
+	m.deactivated = false
+	m.active = true
+	cacheChanged := m.cacheFile != file
+	m.cacheFile = file
+	m.mu.Unlock()
+	if reactivated {
+		// Switched back on: restore the last good lists and move every
+		// credential off the static catalog it was given meanwhile.
+		m.loadCache()
+		m.mu.Lock()
+		m.active = true
+		m.mu.Unlock()
+		for _, auth := range s.coreManager.List() {
+			if m.eligible(auth) {
+				s.refreshModelRegistrationForAuth(auth)
+			}
+		}
+	}
+
+	now := m.now()
+	present := map[string]bool{}
+	var due []*coreauth.Auth
+	for _, auth := range s.coreManager.List() {
+		if !m.eligible(auth) {
+			continue
+		}
+		present[auth.ID] = true
+		m.mu.RLock()
+		attempt, attempted := m.attempts[auth.ID]
+		attempted = attempted && attempt.account == liveModelAccount(auth)
+		hasList := m.listForLocked(auth) != nil
+		m.mu.RUnlock()
+		wait := interval
+		if !hasList || attempt.err != "" {
+			wait = liveModelsRetryInterval
+		}
+		if all || !attempted || now.Sub(attempt.at) >= wait {
+			due = append(due, auth)
+		}
+	}
+
+	pruned := false
+	m.mu.Lock()
+	for id := range m.lists {
+		if !present[id] {
+			delete(m.lists, id)
+			delete(m.attempts, id)
+			livemodels.Forget(id)
+			pruned = true
+		}
+	}
+	m.mu.Unlock()
+	if pruned || cacheChanged {
+		m.persist()
+	}
+	if pruned {
+		m.applyCodexTemplates()
+	}
+
+	type result struct {
+		auth *coreauth.Auth
+		list *liveModelList
+		err  error
+	}
+	results := make(chan result, len(due))
+	var wg sync.WaitGroup
+	for _, auth := range due {
+		wg.Add(1)
+		go func(auth *coreauth.Auth) {
+			defer wg.Done()
+			fetchCtx, cancel := context.WithTimeout(ctx, liveModelsFetchTimeout)
+			defer cancel()
+			list, err := m.fetch[strings.ToLower(strings.TrimSpace(auth.Provider))](fetchCtx, s.currentConfig(), auth)
+			if err == nil {
+				err = validLiveModelList(list)
+			}
+			results <- result{auth: auth, list: list, err: err}
+		}(auth)
+	}
+	wg.Wait()
+	close(results)
+	for r := range results {
+		if ctx.Err() != nil {
+			return
+		}
+		m.record(r.auth, r.list, r.err)
+	}
+	// Credentials load after the cache, and one may have been replaced since
+	// its list was read; republish the templates for the current accounts (a
+	// no-op when nothing changed).
+	m.applyCodexTemplates()
+}
+
+// record stores one read. A changed list is persisted and re-registered; a
+// failure keeps the previous list.
+func (m *liveModelManager) record(auth *coreauth.Auth, list *liveModelList, err error) {
+	now := m.now()
+	account := liveModelAccount(auth)
+	// The credential may have been replaced by another account while the read
+	// ran; its result belongs to neither, so read again.
+	if latest, ok := m.service.coreManager.GetByID(auth.ID); !ok || latest == nil || liveModelAccount(latest) != account {
+		m.nudge()
+		return
+	}
+	m.mu.Lock()
+	previous := m.listForLocked(auth)
+	droppedForeign := false
+	if previous == nil && m.lists[auth.ID] != nil {
+		// A list read for a different account: never keep it.
+		delete(m.lists, auth.ID)
+		droppedForeign = true
+	}
+	prevAttempt := m.attempts[auth.ID]
+	status := livemodels.Status{Source: livemodels.SourcePending, CheckedAt: now}
+	if previous != nil {
+		status = livemodels.Status{Source: livemodels.SourceLive, CheckedAt: now, FetchedAt: previous.FetchedAt, Models: len(previous.Models)}
+	}
+	if err != nil {
+		m.attempts[auth.ID] = liveModelAttempt{at: now, err: err.Error(), account: account}
+		m.mu.Unlock()
+		if droppedForeign {
+			m.persist()
+			m.applyCodexTemplates()
+		}
+		status.Error = err.Error()
+		livemodels.Publish(auth.ID, status)
+		if prevAttempt.err != err.Error() {
+			if previous != nil {
+				log.Warnf("live-models: %s credential %s: %v (keeping its last good list)", auth.Provider, auth.ID, err)
+			} else {
+				log.Warnf("live-models: %s credential %s: %v (no list yet, not routed)", auth.Provider, auth.ID, err)
+			}
+		}
+		return
+	}
+	list.FetchedAt = now
+	list.Provider = strings.ToLower(strings.TrimSpace(auth.Provider))
+	list.Account = account
+	changed := previous == nil || !sameLiveModelList(previous, list)
+	if changed {
+		m.lists[auth.ID] = list
+	} else {
+		previous.FetchedAt = now
+	}
+	m.attempts[auth.ID] = liveModelAttempt{at: now, account: account}
+	m.mu.Unlock()
+	livemodels.Publish(auth.ID, livemodels.Status{Source: livemodels.SourceLive, CheckedAt: now, FetchedAt: now, Models: len(list.Models)})
+	if !changed {
+		return
+	}
+	m.persist()
+	if list.Provider == "codex" {
+		m.applyCodexTemplates()
+	}
+	log.Infof("live-models: %s credential %s now routes %d models: %s", list.Provider, auth.ID, len(list.Models), strings.Join(liveModelIDs(list.Models), ", "))
+	if latest, ok := m.service.coreManager.GetByID(auth.ID); ok && latest != nil && !latest.Disabled {
+		m.service.refreshModelRegistrationForAuth(latest)
+	}
+}
+
+// deactivate drops the live lists once after live models are switched off,
+// re-registering the static catalog. The cache file is left for re-enabling.
+func (m *liveModelManager) deactivate() {
+	m.mu.Lock()
+	if !m.active {
+		m.mu.Unlock()
+		return
+	}
+	m.active = false
+	m.deactivated = true
+	ids := make([]string, 0, len(m.lists))
+	for id := range m.lists {
+		ids = append(ids, id)
+	}
+	m.lists = map[string]*liveModelList{}
+	m.attempts = map[string]liveModelAttempt{}
+	m.mu.Unlock()
+	livemodels.Clear()
+	registry.SetCodexClientLiveTemplates(nil)
+	for _, id := range ids {
+		if auth, ok := m.service.coreManager.GetByID(id); ok && auth != nil && !auth.Disabled {
+			m.service.refreshModelRegistrationForAuth(auth)
+		}
+	}
+	log.Infof("live-models: disabled, %d credentials back on the static catalog", len(ids))
+}
+
+func validLiveModelList(list *liveModelList) error {
+	if list == nil || len(list.Models) == 0 {
+		return errors.New("provider returned no models")
+	}
+	for _, model := range list.Models {
+		if model == nil || strings.TrimSpace(model.ID) == "" {
+			return errors.New("provider returned a model without an id")
+		}
+	}
+	return nil
+}
+
+func sameLiveModelList(a, b *liveModelList) bool {
+	left, errLeft := json.Marshal(liveModelList{Provider: a.Provider, Models: a.Models, Templates: a.Templates})
+	right, errRight := json.Marshal(liveModelList{Provider: b.Provider, Models: b.Models, Templates: b.Templates})
+	return errLeft == nil && errRight == nil && string(left) == string(right)
+}
+
+func liveModelIDs(models []*ModelInfo) []string {
+	ids := make([]string, 0, len(models))
+	for _, model := range models {
+		ids = append(ids, model.ID)
+	}
+	return ids
+}
+
+func cloneLiveModels(models []*ModelInfo) []*ModelInfo {
+	out := make([]*ModelInfo, 0, len(models))
+	for _, model := range models {
+		if model == nil {
+			continue
+		}
+		clone := *model
+		if model.Thinking != nil {
+			thinking := *model.Thinking
+			thinking.Levels = append([]string(nil), model.Thinking.Levels...)
+			clone.Thinking = &thinking
+		}
+		clone.SupportedInputModalities = append([]string(nil), model.SupportedInputModalities...)
+		clone.SupportedOutputModalities = append([]string(nil), model.SupportedOutputModalities...)
+		clone.SupportedParameters = append([]string(nil), model.SupportedParameters...)
+		out = append(out, &clone)
+	}
+	return out
+}
+
+// liveModelThinkingLevels keeps the effort levels the thinking pipeline
+// understands, in canonical order; anything else (for example Codex "ultra")
+// stays in the client template but not in the routing metadata.
+var liveModelThinkingLevels = []string{"minimal", "low", "medium", "high", "xhigh", "max"}
+
+func orderedThinkingLevels(supported map[string]bool) []string {
+	levels := make([]string, 0, len(liveModelThinkingLevels))
+	for _, level := range liveModelThinkingLevels {
+		if supported[level] {
+			levels = append(levels, level)
+		}
+	}
+	return levels
+}
+
+func staticModelIndex(models []*ModelInfo) map[string]*ModelInfo {
+	index := make(map[string]*ModelInfo, len(models))
+	for _, model := range models {
+		if model != nil {
+			index[model.ID] = model
+		}
+	}
+	return index
+}
+
+func liveAccessToken(auth *coreauth.Auth) (string, error) {
+	if auth != nil && auth.Metadata != nil {
+		if token, ok := auth.Metadata["access_token"].(string); ok && strings.TrimSpace(token) != "" {
+			return strings.TrimSpace(token), nil
+		}
+	}
+	return "", errors.New("credential has no access token")
+}
+
+func liveModelsGet(ctx context.Context, cfg *config.Config, auth *coreauth.Auth, req *http.Request) ([]byte, error) {
+	client := helps.NewUtlsHTTPClient(ctx, cfg, auth, liveModelsFetchTimeout)
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, liveModelsMaxBody+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(body) > liveModelsMaxBody {
+		return nil, fmt.Errorf("model list larger than %d bytes", liveModelsMaxBody)
+	}
+	if resp.StatusCode < http.StatusOK || resp.StatusCode >= http.StatusMultipleChoices {
+		return nil, fmt.Errorf("model list returned HTTP %d", resp.StatusCode)
+	}
+	return body, nil
+}
+
+type anthropicModelsPage struct {
+	Data    []anthropicLiveModel `json:"data"`
+	HasMore bool                 `json:"has_more"`
+	LastID  string               `json:"last_id"`
+}
+
+type anthropicSupport struct {
+	Supported bool `json:"supported"`
+}
+
+type anthropicLiveModel struct {
+	ID             string `json:"id"`
+	Type           string `json:"type"`
+	DisplayName    string `json:"display_name"`
+	CreatedAt      string `json:"created_at"`
+	MaxInputTokens int    `json:"max_input_tokens"`
+	MaxTokens      int    `json:"max_tokens"`
+	Capabilities   struct {
+		Effort   map[string]json.RawMessage `json:"effort"`
+		Thinking struct {
+			Supported bool                        `json:"supported"`
+			Types     map[string]anthropicSupport `json:"types"`
+		} `json:"thinking"`
+		ImageInput anthropicSupport `json:"image_input"`
+	} `json:"capabilities"`
+}
+
+func fetchClaudeLiveModels(ctx context.Context, cfg *config.Config, auth *coreauth.Auth) (*liveModelList, error) {
+	token, err := liveAccessToken(auth)
+	if err != nil {
+		return nil, err
+	}
+	var models []anthropicLiveModel
+	after := ""
+	for page := 0; page < liveModelsMaxPages; page++ {
+		query := url.Values{"limit": {"1000"}}
+		if after != "" {
+			query.Set("after_id", after)
+		}
+		req, errReq := http.NewRequestWithContext(ctx, http.MethodGet, anthropicModelsURL+"?"+query.Encode(), nil)
+		if errReq != nil {
+			return nil, errReq
+		}
+		// Identify as the installed Claude Code, as usage reads do.
+		helps.ApplyClaudeDefaultDeviceProfileHeaders(req, cfg)
+		req.Header.Set("Authorization", "Bearer "+token)
+		req.Header.Set("Accept", "application/json")
+		req.Header.Set("Anthropic-Version", "2023-06-01")
+		req.Header.Set("Anthropic-Beta", "oauth-2025-04-20")
+		req.Header.Set("X-App", "cli")
+		body, errGet := liveModelsGet(ctx, cfg, auth, req)
+		if errGet != nil {
+			return nil, errGet
+		}
+		var parsed anthropicModelsPage
+		if errJSON := json.Unmarshal(body, &parsed); errJSON != nil {
+			return nil, fmt.Errorf("model list is not JSON: %w", errJSON)
+		}
+		models = append(models, parsed.Data...)
+		if !parsed.HasMore || parsed.LastID == "" || parsed.LastID == after {
+			break
+		}
+		after = parsed.LastID
+	}
+	return &liveModelList{Models: claudeModelInfos(models)}, nil
+}
+
+// claudeModelInfos maps Anthropic's model capabilities to routing metadata:
+// adaptive thinking with effort levels becomes discrete levels (thinking.type
+// adaptive plus output_config.effort), budget-only thinking a token range.
+func claudeModelInfos(models []anthropicLiveModel) []*ModelInfo {
+	static := staticModelIndex(registry.GetClaudeModels())
+	seen := map[string]bool{}
+	out := make([]*ModelInfo, 0, len(models))
+	for _, m := range models {
+		id := strings.TrimSpace(m.ID)
+		if id == "" || seen[id] || (m.Type != "" && m.Type != "model") {
+			continue
+		}
+		seen[id] = true
+		info := &ModelInfo{
+			ID:                        id,
+			Object:                    "model",
+			OwnedBy:                   "anthropic",
+			Type:                      "claude",
+			DisplayName:               strings.TrimSpace(m.DisplayName),
+			ContextLength:             m.MaxInputTokens,
+			MaxCompletionTokens:       m.MaxTokens,
+			SupportedInputModalities:  []string{"text"},
+			SupportedOutputModalities: []string{"text"},
+		}
+		if created, err := time.Parse(time.RFC3339, m.CreatedAt); err == nil {
+			info.Created = created.Unix()
+		}
+		if m.Capabilities.ImageInput.Supported {
+			info.SupportedInputModalities = append(info.SupportedInputModalities, "image")
+		}
+		if known := static[id]; known != nil {
+			info.Description = known.Description
+		}
+		if m.Capabilities.Thinking.Supported {
+			adaptive := m.Capabilities.Thinking.Types["adaptive"].Supported
+			budget := m.Capabilities.Thinking.Types["enabled"].Supported
+			efforts := map[string]bool{}
+			for level, raw := range m.Capabilities.Effort {
+				var support anthropicSupport
+				if level != "supported" && json.Unmarshal(raw, &support) == nil && support.Supported {
+					efforts[level] = true
+				}
+			}
+			thinking := &registry.ThinkingSupport{ZeroAllowed: true, DynamicAllowed: adaptive}
+			if adaptive {
+				thinking.Levels = orderedThinkingLevels(efforts)
+			}
+			if budget {
+				thinking.Min = 1024
+				thinking.Max = m.MaxTokens
+			}
+			if len(thinking.Levels) > 0 || budget || adaptive {
+				info.Thinking = thinking
+			}
+		}
+		out = append(out, info)
+	}
+	return out
+}
+
+func fetchCodexLiveModels(ctx context.Context, cfg *config.Config, auth *coreauth.Auth) (*liveModelList, error) {
+	token, err := liveAccessToken(auth)
+	if err != nil {
+		return nil, err
+	}
+	userAgent, originator, version := executor.CodexClientIdentity()
+	if cfg != nil && strings.TrimSpace(cfg.CodexHeaderDefaults.UserAgent) != "" {
+		userAgent = strings.TrimSpace(cfg.CodexHeaderDefaults.UserAgent)
+	}
+	// client_version selects the models this client may use, so it must be
+	// the installed Codex version.
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, codexModelsURL+"?"+url.Values{"client_version": {version}}.Encode(), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", userAgent)
+	req.Header.Set("Originator", originator)
+	if accountID, ok := auth.Metadata["account_id"].(string); ok && strings.TrimSpace(accountID) != "" {
+		req.Header.Set("Chatgpt-Account-Id", strings.TrimSpace(accountID))
+	}
+	util.ApplyCustomHeadersFromAttrs(req, auth.Attributes)
+	body, err := liveModelsGet(ctx, cfg, auth, req)
+	if err != nil {
+		return nil, err
+	}
+	var parsed struct {
+		Models []map[string]any `json:"models"`
+	}
+	if err = json.Unmarshal(body, &parsed); err != nil {
+		return nil, fmt.Errorf("model list is not JSON: %w", err)
+	}
+	models, templates := codexModelInfos(parsed.Models)
+	return &liveModelList{Models: models, Templates: templates}, nil
+}
+
+// codexModelInfos maps the Codex backend's client templates to routing
+// metadata and keeps the templates for the Codex client catalog.
+func codexModelInfos(entries []map[string]any) ([]*ModelInfo, []map[string]any) {
+	static := staticModelIndex(registry.GetCodexProModels())
+	seen := map[string]bool{}
+	models := make([]*ModelInfo, 0, len(entries))
+	templates := make([]map[string]any, 0, len(entries))
+	for _, entry := range entries {
+		slug, _ := entry["slug"].(string)
+		slug = strings.TrimSpace(slug)
+		if slug == "" || seen[slug] {
+			continue
+		}
+		seen[slug] = true
+		info := &ModelInfo{
+			ID:                        slug,
+			Object:                    "model",
+			OwnedBy:                   "openai",
+			Type:                      "openai",
+			SupportedOutputModalities: []string{"text"},
+		}
+		info.DisplayName, _ = entry["display_name"].(string)
+		info.Description, _ = entry["description"].(string)
+		if window, ok := entry["context_window"].(float64); ok && window > 0 {
+			info.ContextLength = int(window)
+		}
+		if modalities, ok := entry["input_modalities"].([]any); ok {
+			for _, raw := range modalities {
+				if modality, ok := raw.(string); ok && strings.TrimSpace(modality) != "" {
+					info.SupportedInputModalities = append(info.SupportedInputModalities, strings.TrimSpace(modality))
+				}
+			}
+		}
+		if len(info.SupportedInputModalities) == 0 {
+			info.SupportedInputModalities = []string{"text"}
+		}
+		efforts := map[string]bool{}
+		if levels, ok := entry["supported_reasoning_levels"].([]any); ok {
+			for _, raw := range levels {
+				if level, ok := raw.(map[string]any); ok {
+					if effort, ok := level["effort"].(string); ok {
+						efforts[strings.ToLower(strings.TrimSpace(effort))] = true
+					}
+				}
+			}
+		}
+		if levels := orderedThinkingLevels(efforts); len(levels) > 0 {
+			info.Thinking = &registry.ThinkingSupport{Levels: levels}
+		}
+		if known := static[slug]; known != nil {
+			info.Created = known.Created
+		}
+		models = append(models, info)
+		templates = append(templates, entry)
+	}
+	return models, templates
+}
