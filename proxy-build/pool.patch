+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"sync/atomic"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/interfaces"
+	"github.com/tidwall/sjson"
+)
+
+// modelRoutingNotReady is set while the service is still registering the
+// models of its credentials at startup. The zero value means ready, so SDK
+// embedders that never call SetModelRoutingReady keep the historical 400.
+var modelRoutingNotReady atomic.Bool
+
+// SetModelRoutingReady marks whether model routing has finished its initial
+// load. While not ready, an unroutable model is reported as a retryable 503
+// instead of the terminal 400, because the model is most likely one whose
+// credential has not been registered yet.
+func SetModelRoutingReady(ready bool) {
+	modelRoutingNotReady.Store(!ready)
+}
+
+// ModelRoutingReady reports whether unroutable models are treated as terminal.
+func ModelRoutingReady() bool {
+	return !modelRoutingNotReady.Load()
+}
+
+// modelRoutingNotReadyError builds the retryable error returned for an
+// unroutable model during startup. The model name is client supplied and is
+// inserted through sjson for the same reason as the 400 body.
+func modelRoutingNotReadyError(modelName string) *interfaces.ErrorMessage {
+	body := `{"error":{"message":"","type":"server_error","code":"server_not_ready","param":"model"}}`
+	body, errSet := sjson.Set(body, "error.message", "model routing is still loading, retry shortly: "+modelName)
+	if errSet != nil {
+		body = `{"error":{"message":"model routing is still loading, retry shortly","type":"server_error","code":"server_not_ready","param":"model"}}`
+	}
+	return &interfaces.ErrorMessage{
+		StatusCode: http.StatusServiceUnavailable,
+		Error:      errors.New(body),
+	}
+}
