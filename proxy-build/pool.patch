+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+// The error text the Claude refresh client returned on 2026-09-29.
+const recordedInvalidGrant = `token refresh failed after 3 attempts: token refresh failed with status 400: {"error": "invalid_grant", "error_description": "Refresh token not found or invalid"}`
+
+type refreshFailureExecutor struct {
+	mu   sync.Mutex
+	err  error
+	next string
+}
+
+func (e *refreshFailureExecutor) Identifier() string { return "claude" }
+
+func (e *refreshFailureExecutor) Execute(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return cliproxyexecutor.Response{}, nil
+}
+
+func (e *refreshFailureExecutor) ExecuteStream(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	return nil, &Error{HTTPStatus: http.StatusNotImplemented, Message: "not implemented"}
+}
+
+func (e *refreshFailureExecutor) Refresh(_ context.Context, auth *Auth) (*Auth, error) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.err != nil {
+		return nil, e.err
+	}
+	auth.Metadata["access_token"] = e.next
+	return auth, nil
+}
+
+func (e *refreshFailureExecutor) CountTokens(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return cliproxyexecutor.Response{}, &Error{HTTPStatus: http.StatusNotImplemented, Message: "not implemented"}
+}
+
+func (e *refreshFailureExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func (e *refreshFailureExecutor) set(err error, next string) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.err, e.next = err, next
+}
+
+func newRefreshFailureFixture(t *testing.T, err error) (*Manager, *refreshFailureExecutor, string) {
+	t.Helper()
+	m := NewManager(nil, nil, nil)
+	executor := &refreshFailureExecutor{err: err}
+	m.RegisterExecutor(executor)
+	auth := &Auth{
+		ID:       "claude-reauth.json",
+		Provider: "claude",
+		Metadata: map[string]any{
+			"access_token":  "old-access",
+			"refresh_token": "old-refresh",
+			"expired":       time.Now().Add(4 * time.Hour).Format(time.RFC3339),
+		},
+	}
+	if _, errRegister := m.Register(context.Background(), auth); errRegister != nil {
+		t.Fatalf("register: %v", errRegister)
+	}
+	return m, executor, auth.ID
+}
+
+func refreshFailureOf(t *testing.T, m *Manager, id string) *RefreshFailure {
+	t.Helper()
+	current, ok := m.GetByID(id)
+	if !ok {
+		t.Fatalf("auth %s missing", id)
+	}
+	return current.RefreshFailure
+}
+
+func TestRefreshFailure_InvalidGrantNeedsReauthSurvivesRewritesAndClearsOnNewLogin(t *testing.T) {
+	m, _, id := newRefreshFailureFixture(t, errors.New(recordedInvalidGrant))
+	ctx := context.Background()
+
+	if _, err := m.ForceRefreshAuth(ctx, id); err == nil {
+		t.Fatal("expected refresh error")
+	}
+	first := refreshFailureOf(t, m, id)
+	if first == nil || first.Code != RefreshFailureReauthRequired || first.Attempts != 1 {
+		t.Fatalf("refresh failure = %+v, want reauth_required after one attempt", first)
+	}
+	if !strings.Contains(first.Message, "invalid_grant") {
+		t.Fatalf("message %q lost the provider verdict", first.Message)
+	}
+
+	if _, err := m.ForceRefreshAuth(ctx, id); err == nil {
+		t.Fatal("expected refresh error")
+	}
+	second := refreshFailureOf(t, m, id)
+	if second.Attempts != 2 || !second.Since.Equal(first.Since) || second.At.Before(first.At) {
+		t.Fatalf("second failure = %+v, want the streak from %v extended", second, first.Since)
+	}
+
+	// A file rewrite that keeps the tokens (the supervisor's priority PATCH
+	// rewrote this file at 08:03:23) arrives without the in-memory record.
+	current, _ := m.GetByID(id)
+	rewrite := current.Clone()
+	rewrite.RefreshFailure = nil
+	rewrite.Label = "priority changed"
+	if _, err := m.Update(ctx, rewrite); err != nil {
+		t.Fatalf("update: %v", err)
+	}
+	if got := refreshFailureOf(t, m, id); got == nil || got.Code != RefreshFailureReauthRequired {
+		t.Fatalf("refresh failure after rewrite = %+v, want it kept", got)
+	}
+
+	relogin := rewrite.Clone()
+	relogin.Metadata["access_token"] = "new-access"
+	relogin.Metadata["refresh_token"] = "new-refresh"
+	if _, err := m.Update(ctx, relogin); err != nil {
+		t.Fatalf("update: %v", err)
+	}
+	if got := refreshFailureOf(t, m, id); got != nil {
+		t.Fatalf("refresh failure after a new login = %+v, want nil", got)
+	}
+}
+
+func TestRefreshFailure_TransientFailureIsRetryingUntilARefreshSucceeds(t *testing.T) {
+	m, executor, id := newRefreshFailureFixture(t, errors.New(`token refresh request failed: Post "https://platform.claude.com/v1/oauth/token": context deadline exceeded`))
+	ctx := context.Background()
+
+	if _, err := m.ForceRefreshAuth(ctx, id); err == nil {
+		t.Fatal("expected refresh error")
+	}
+	if got := refreshFailureOf(t, m, id); got == nil || got.Code != RefreshFailureRetrying {
+		t.Fatalf("refresh failure = %+v, want refresh_failed", got)
+	}
+
+	executor.set(nil, "fresh-access")
+	if _, err := m.ForceRefreshAuth(ctx, id); err != nil {
+		t.Fatalf("refresh: %v", err)
+	}
+	if got := refreshFailureOf(t, m, id); got != nil {
+		t.Fatalf("refresh failure after success = %+v, want nil", got)
+	}
+}
+
+func TestIsReauthRefreshError(t *testing.T) {
+	for message, want := range map[string]bool{
+		recordedInvalidGrant:                       true,
+		"token refresh failed with status 401: {}": true,
+		"token refresh failed with status 400: {\"error\":{\"code\":\"refresh_token_reused\"}}": true,
+		"token refresh failed with status 429: rate limited":                                    false,
+		"token refresh failed with status 503: overloaded":                                      false,
+		"token refresh request failed: context deadline exceeded":                               false,
+	} {
+		if got := isReauthRefreshError(errors.New(message)); got != want {
+			t.Errorf("isReauthRefreshError(%q) = %v, want %v", message, got, want)
+		}
+	}
+}
