diff --git a/internal/clientversion/hide_windows.go b/internal/clientversion/hide_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ca6b742539c4dca780986951c300ef9cd32b91c5
--- /dev/null
+++ b/internal/clientversion/hide_windows.go
@@ -0,0 +1,16 @@
+//go:build windows
+
+package clientversion
+
+import (
+	"os/exec"
+	"syscall"
+)
+
+// createNoWindow keeps a console child of the windowless proxy from opening
+// a console window (CREATE_NO_WINDOW).
+const createNoWindow = 0x08000000
+
+func hideWindow(cmd *exec.Cmd) {
+	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, CreationFlags: createNoWindow}
+}
