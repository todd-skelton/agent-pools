+func TestPortableClaudeCompactionRealExecutorAndReplay(t *testing.T) {
+	cfg := portableTestConfig(t)
+	var captured []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		captured, _ = io.ReadAll(r.Body)
+		portableClaudeSSE(w, "end_turn")
+	}))
+	defer server.Close()
+	auth := &coreauth.Auth{ID: "fixture", Provider: "claude", Attributes: map[string]string{"api_key": "test-key", "base_url": server.URL}}
+	exec := NewClaudeExecutor(cfg)
+	opts := portableTestOptions()
+	request := coreexecutor.Request{Model: "claude-opus-5-5", Payload: []byte(`{"model":"claude-opus-5-5","tools":[{"type":"function","name":"run","parameters":{"type":"object"}}],"input":[{"type":"function_call","call_id":"x","name":"run","arguments":"{}"},{"type":"function_call_output","call_id":"x","output":"ALPHA"},{"type":"compaction_trigger"}]}`)}
+	opts.OriginalRequest = request.Payload
+	stream, err := exec.ExecuteStream(context.Background(), auth, request, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var capsule string
+	done := 0
+	for chunk := range stream.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		for _, line := range strings.Split(string(chunk.Payload), "\n") {
+			if strings.HasPrefix(line, "data: ") {
+				v := gjson.Parse(strings.TrimPrefix(line, "data: "))
+				if v.Get("type").String() == "response.output_item.done" {
+					done++
+					capsule = v.Get("item.encrypted_content").String()
+				}
+			}
+		}
+	}
+	if done != 1 || !strings.HasPrefix(capsule, helps.PortableCompactionPrefix) {
+		t.Fatal("missing single checkpoint")
+	}
+	if gjson.GetBytes(captured, "tools").Exists() || !strings.Contains(string(captured), "ALPHA") {
+		t.Fatalf("invalid summary request: %s", captured)
+	}
+	summaryRequest := captured
+	for _, item := range gjson.GetBytes(captured, "messages").Array() {
+		for _, part := range item.Get("content").Array() {
+			if part.Get("type").String() == "tool_use" || part.Get("type").String() == "tool_result" {
+				t.Fatal("summary contains executable history")
+			}
+		}
+	}
+	// The summary gets the same output limit and thinking settings as an
+	// ordinary request from this caller, not a pool-specific cap.
+	ordinary := coreexecutor.Request{Model: "claude-opus-5-5", Payload: []byte(`{"model":"claude-opus-5-5","reasoning":{"effort":"high"},"input":[{"type":"message","role":"user","content":"hello"}]}`)}
+	ordinaryOpts := portableTestOptions()
+	ordinaryOpts.OriginalRequest = ordinary.Payload
+	if _, err = exec.Execute(context.Background(), auth, ordinary, ordinaryOpts); err != nil {
+		t.Fatal(err)
+	}
+	withEffort := coreexecutor.Request{Model: "claude-opus-5-5", Payload: []byte(`{"model":"claude-opus-5-5","reasoning":{"effort":"high"},"input":[{"type":"message","role":"user","content":"ALPHA"},{"type":"compaction_trigger"}]}`)}
+	effortOpts := portableTestOptions()
+	effortOpts.OriginalRequest = withEffort.Payload
+	ordinaryRequest := captured
+	if _, err = exec.Execute(context.Background(), auth, withEffort, effortOpts); err != nil {
+		t.Fatal(err)
+	}
+	for _, field := range []string{"max_tokens", "thinking", "output_config.effort"} {
+		if got, want := gjson.GetBytes(captured, field).Raw, gjson.GetBytes(ordinaryRequest, field).Raw; got != want {
+			t.Fatalf("summary %s = %s, ordinary request = %s", field, got, want)
+		}
+	}
+	if gjson.GetBytes(summaryRequest, "max_tokens").Int() != gjson.GetBytes(ordinaryRequest, "max_tokens").Int() {
+		t.Fatalf("summary max_tokens %d differs from ordinary %d", gjson.GetBytes(summaryRequest, "max_tokens").Int(), gjson.GetBytes(ordinaryRequest, "max_tokens").Int())
+	}
+	replay, _ := json.Marshal(map[string]any{"model": "claude-opus-5-5", "input": []any{map[string]any{"type": "compaction", "encrypted_content": capsule}, map[string]any{"type": "message", "role": "user", "content": "continue"}}})
+	request.Payload = replay
+	opts.OriginalRequest = replay
+	if _, err = NewClaudeExecutor(cfg).Execute(context.Background(), auth, request, opts); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(gjson.GetBytes(captured, "system").Raw, "Checkpoint ALPHA") || !strings.Contains(gjson.GetBytes(captured, "messages").Raw, "Checkpoint ALPHA") {
+		t.Fatal("summary was lost or elevated to system")
+	}
+	// Repeat compaction using the saved checkpoint and a rotated upstream account.
+	var doc map[string]any
+	_ = json.Unmarshal(replay, &doc)
+	doc["input"] = append(doc["input"].([]any), map[string]any{"type": "compaction_trigger"})
+	request.Payload, _ = json.Marshal(doc)
+	opts.OriginalRequest = request.Payload
+	auth.ID = "other-account"
+	response, err := exec.Execute(context.Background(), auth, request, opts)
+	if err != nil || gjson.GetBytes(response.Payload, "output.0.type").String() != "compaction" {
+		t.Fatalf("repeat: %v", err)
+	}
+	if !strings.Contains(string(captured), "Checkpoint ALPHA") {
+		t.Fatal("repeat lost prior checkpoint")
+	}
+	// Standalone endpoint has its own object type.
+	opts.Alt = "responses/compact"
+	response, err = exec.Execute(context.Background(), auth, request, opts)
+	if err != nil || gjson.GetBytes(response.Payload, "object").String() != "response.compaction" {
+		t.Fatalf("standalone: %v", err)
+	}
+}
