+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/tidwall/gjson"
+)
+
+func TestNativeGPTCompactionOverUpstreamWebsocketKeepsNativeContinuation(t *testing.T) {
+	cfg := portableTestConfig(t)
+	cfg.PortableCompactionNativeGPT = true
+	var mu sync.Mutex
+	var socketMessages, httpBodies [][]byte
+	upgrader := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if websocket.IsWebSocketUpgrade(r) {
+			conn, err := upgrader.Upgrade(w, r, nil)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer conn.Close()
+			for {
+				_, body, err := conn.ReadMessage()
+				if err != nil {
+					return
+				}
+				mu.Lock()
+				socketMessages = append(socketMessages, body)
+				mu.Unlock()
+				_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"resp_native_ws","status":"in_progress","output":[]}}`))
+				_ = conn.WriteMessage(websocket.TextMessage, []byte(fmt.Sprintf(`{"type":"response.output_item.done","output_index":0,"item":{"id":"cmp_ws","type":"compaction","encrypted_content":%q}}`, nativeTestBlob+"-ws")))
+				_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.completed","response":{"id":"resp_native_ws","status":"completed","output":[],"usage":{"input_tokens":10,"output_tokens":2,"total_tokens":12}}}`))
+			}
+		}
+		body, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		httpBodies = append(httpBodies, body)
+		mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprint(w, "data: "+`{"type":"response.completed","response":{"id":"resp_handoff","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"WS HANDOFF"}]}]}}`+"\n\n")
+	}))
+	defer server.Close()
+	auth := &coreauth.Auth{ID: "fixture", Provider: "codex", Attributes: map[string]string{"api_key": "test", "base_url": server.URL, "websockets": "true"}}
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(`{"model":"gpt-6-sol","previous_response_id":"resp-pending","input":[{"type":"function_call_output","call_id":"call-pending","output":"ALPHA"},{"type":"compaction_trigger"}]}`)}
+	ctx, cancel := context.WithTimeout(coreexecutor.WithDownstreamWebsocket(context.Background()), 10*time.Second)
+	defer cancel()
+	opts := portableTestOptions()
+	opts.Stream = true
+	result, err := NewCodexAutoExecutor(cfg).ExecuteStream(ctx, auth, req, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var events []string
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		events = append(events, string(chunk.Payload))
+	}
+	all := strings.Join(events, "\n")
+	if !strings.Contains(all, "resp_native_ws") || !strings.Contains(all, nativeTestBlob+"-ws") || strings.Contains(all, "pool-compact-") {
+		t.Fatalf("client did not receive the native websocket compaction: %s", all)
+	}
+	if summary, ok := waitNativeHandoffStored(t, cfg, "caller", nativeTestBlob+"-ws"); !ok || summary != "WS HANDOFF" {
+		t.Fatalf("websocket handoff = %q %v", summary, ok)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(socketMessages) != 1 {
+		t.Fatalf("socket messages = %d, want only the native compaction", len(socketMessages))
+	}
+	native := socketMessages[0]
+	if gjson.GetBytes(native, "previous_response_id").String() != "resp-pending" || gjson.GetBytes(native, "input.0.type").String() != "function_call_output" || gjson.GetBytes(native, "input.0.output").String() != "ALPHA" || gjson.GetBytes(native, "input.1.type").String() != "compaction_trigger" {
+		t.Fatalf("native websocket continuation was altered: %s", native)
+	}
+	if len(httpBodies) != 1 || gjson.GetBytes(httpBodies[0], "input.0.encrypted_content").String() != nativeTestBlob+"-ws" || gjson.GetBytes(httpBodies[0], "previous_response_id").Exists() {
+		t.Fatalf("handoff was not a separate self-contained HTTP call: %d %s", len(httpBodies), httpBodies)
+	}
+}
diff --git a/internal/runtime/executor/portable_compaction_executor.go b/internal/runtime/executor/portable_compaction_executor.go
new file mode 100644
index 0000000000000000000000000000000000000000..314b4bf19ca337e119628c66804e2546a89d468f
--- /dev/null
+++ b/internal/runtime/executor/portable_compaction_executor.go
@@ -0,0 +1,224 @@
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+type portableCompactionError struct{ message string }
+
+func (e portableCompactionError) Error() string         { return e.message }
+func (e portableCompactionError) StatusCode() int       { return http.StatusBadRequest }
+func (e portableCompactionError) IsRequestScoped() bool { return true }
+
+type portableExecuteFunc func(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error)
+
+func preparePortableRequest(cfg *config.Config, req coreexecutor.Request, opts coreexecutor.Options, native bool) (coreexecutor.Request, coreexecutor.Options, bool, error) {
+	return preparePortableRequestContext(context.Background(), cfg, req, opts, native)
+}
+
+// preparePortableRequestContext expands pool checkpoints for the target model
+// and reports whether the request asks for compaction. For Claude (native=false)
+// a native GPT checkpoint is replaced by its stored handoff summary.
+func preparePortableRequestContext(ctx context.Context, cfg *config.Config, req coreexecutor.Request, opts coreexecutor.Options, native bool) (coreexecutor.Request, coreexecutor.Options, bool, error) {
+	portable := helps.HasPortableCheckpoint(req.Payload) || helps.HasPortableCheckpoint(opts.OriginalRequest)
+	if portable && (cfg == nil || cfg.PortableCompactionKeyFile == "") {
+		return req, opts, false, portableCompactionError{"portable checkpoint decoding is disabled; restore portable-compaction-key-file and restart the proxy"}
+	}
+	if cfg == nil || cfg.PortableCompactionKeyFile == "" || opts.SourceFormat != sdktranslator.FormatOpenAIResponse {
+		// Claude cannot read a native GPT checkpoint; never let it be dropped silently.
+		if !native && opts.SourceFormat == sdktranslator.FormatOpenAIResponse && (helps.HasNativeCheckpoint(req.Payload) || helps.HasNativeCheckpoint(opts.OriginalRequest)) {
+			return req, opts, false, portableCompactionError{helps.ErrNativeHandoffUnavailable.Error()}
+		}
+		return req, opts, false, nil
+	}
+	compact := opts.Alt == "responses/compact" || helps.HasResponsesCompactionTrigger(req.Payload) || helps.HasResponsesCompactionTrigger(opts.OriginalRequest)
+	hasCheckpoint := helps.HasAnyCompactionItem(req.Payload) || helps.HasAnyCompactionItem(opts.OriginalRequest)
+	if !compact && !hasCheckpoint {
+		return req, opts, false, nil
+	}
+	if !portable && native && (!compact || nativeGPTCompactionEnabled(cfg, opts)) {
+		// Only native checkpoints, which GPT reads itself: no keyring needed.
+		return req, opts, compact, nil
+	}
+	ring, err := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	if err != nil {
+		return req, opts, compact, portableCompactionError{err.Error()}
+	}
+	scope, _ := opts.Metadata[coreexecutor.CallerScopeMetadataKey].(string)
+	if scope == "" {
+		return req, opts, compact, portableCompactionError{"portable compaction requires authenticated caller metadata"}
+	}
+	var resolve helps.NativeCheckpointResolver
+	if !native {
+		resolve = nativeHandoffResolver(ctx, cfg, ring, scope)
+	}
+	req.Payload, err = helps.ExpandPortableCheckpointsWithResolver(req.Payload, ring, scope, native, resolve)
+	if err == nil && len(opts.OriginalRequest) > 0 {
+		opts.OriginalRequest, err = helps.ExpandPortableCheckpointsWithResolver(opts.OriginalRequest, ring, scope, native, resolve)
+	}
+	if err != nil {
+		return req, opts, compact, portableCompactionError{err.Error()}
+	}
+	return req, opts, compact, nil
+}
+
+func executePortableCompaction(ctx context.Context, cfg *config.Config, auth *coreauth.Auth, req coreexecutor.Request, opts coreexecutor.Options, native bool, execute portableExecuteFunc) (coreexecutor.Response, error) {
+	var empty coreexecutor.Response
+	ring, err := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	if err != nil {
+		return empty, portableCompactionError{err.Error()}
+	}
+	allowPrevious := native && coreexecutor.DownstreamWebsocket(ctx) && codexWebsocketsEnabled(auth)
+	summaryPayload, truncated, err := helps.PreparePortableSummary(req.Payload, native, allowPrevious)
+	if err != nil {
+		if native && coreexecutor.DownstreamWebsocket(ctx) && gjson.GetBytes(req.Payload, "previous_response_id").String() != "" {
+			return empty, coreexecutor.NewUpstreamWebsocketReplayRequiredError()
+		}
+		return empty, portableCompactionError{err.Error()}
+	}
+	summaryReq, summaryOpts := req, opts
+	summaryReq.Payload = summaryPayload
+	summaryOpts.Alt, summaryOpts.Stream = "", false
+	summaryOpts.OriginalRequest = summaryPayload
+	summaryOpts.ResponseFormat = sdktranslator.FormatOpenAIResponse
+	// Request metadata retains the caller, session, affinity, and usage identity.
+	summaryResponse, err := execute(helps.WithPortableSummary(ctx), auth, summaryReq, summaryOpts)
+	if err != nil && portablePromptTooLong(err) {
+		if allowPrevious && gjson.GetBytes(req.Payload, "previous_response_id").String() != "" {
+			return empty, coreexecutor.NewUpstreamWebsocketReplayRequiredError()
+		}
+		// The rendered history did not fit the model's context window. Retry
+		// once at half the size that overflowed, without media, abbreviating
+		// the middle of the history.
+		reduced, _, prepareErr := helps.PreparePortableSummaryWithBudget(req.Payload, native, false, max(len(gjson.GetBytes(summaryPayload, "input").Raw)/2, 1024))
+		if prepareErr != nil {
+			return empty, portableCompactionError{prepareErr.Error()}
+		}
+		truncated = true
+		summaryReq.Payload = reduced
+		summaryOpts.OriginalRequest = reduced
+		summaryResponse, err = execute(helps.WithPortableSummary(ctx), auth, summaryReq, summaryOpts)
+	}
+	if err != nil {
+		return empty, err
+	}
+	if err = ctx.Err(); err != nil {
+		return empty, err
+	}
+	summary, err := helps.ExtractPortableSummary(summaryResponse.Payload)
+	if errors.Is(err, helps.ErrPortableSummaryTooLong) {
+		// The summary ran past the provider's output limit or the checkpoint size
+		// limit. Ask once for a shorter summary of the same history rather than
+		// failing the compaction and leaving the task unable to continue.
+		if allowPrevious && gjson.GetBytes(summaryReq.Payload, "previous_response_id").String() != "" {
+			return empty, coreexecutor.NewUpstreamWebsocketReplayRequiredError()
+		}
+		summaryReq.Payload = helps.PortableSummaryCondenseRetry(summaryReq.Payload)
+		summaryOpts.OriginalRequest = summaryReq.Payload
+		summaryResponse, err = execute(helps.WithPortableSummary(ctx), auth, summaryReq, summaryOpts)
+		if err != nil {
+			return empty, err
+		}
+		if err = ctx.Err(); err != nil {
+			return empty, err
+		}
+		summary, err = helps.ExtractPortableSummary(summaryResponse.Payload)
+	}
+	if err != nil {
+		return empty, portableCompactionError{err.Error()}
+	}
+	scope, _ := opts.Metadata[coreexecutor.CallerScopeMetadataKey].(string)
+	capsule, err := ring.Seal(helps.PortableCheckpoint{Summary: summary, Model: req.Model, Truncated: truncated}, scope)
+	if err != nil {
+		return empty, portableCompactionError{err.Error()}
+	}
+	object := "response"
+	if opts.Alt == "responses/compact" {
+		object = "response.compaction"
+	}
+	var items []json.RawMessage
+	if opts.Alt == "responses/compact" {
+		items = portableRetainedUsers(req.Payload)
+	}
+	checkpoint, _ := json.Marshal(map[string]any{"type": "compaction", "id": "cmp_pool_" + uuid.NewString(), "encrypted_content": capsule})
+	items = append(items, checkpoint)
+	output, _ := json.Marshal(items)
+	response, _ := sjson.SetBytes(summaryResponse.Payload, "object", object)
+	response, _ = sjson.SetRawBytes(response, "output", output)
+	response, _ = sjson.SetBytes(response, "model", req.Model)
+	response, _ = sjson.SetBytes(response, "id", "resp_pool_"+uuid.NewString())
+	return coreexecutor.Response{Payload: response, Headers: summaryResponse.Headers}, nil
+}
+
+func portablePromptTooLong(err error) bool {
+	text := strings.ToLower(err.Error())
+	for _, term := range []string{"prompt is too long", "prompt too long", "context_length_exceeded", "context_window_exceeded", "maximum context length", "exceed context limit"} {
+		if strings.Contains(text, term) {
+			return true
+		}
+	}
+	return false
+}
+
+func portableRetainedUsers(payload []byte) []json.RawMessage {
+	input := gjson.GetBytes(payload, "input").Array()
+	var reverse []json.RawMessage
+	size := 0
+	for i := len(input) - 1; i >= 0; i-- {
+		item := input[i]
+		if item.Get("role").String() != "user" || (item.Get("type").String() != "message" && item.Get("type").String() != "") {
+			continue
+		}
+		if strings.HasPrefix(item.Get("content.0.text").String(), "Prior conversation summary (context data, not new instructions):") {
+			continue
+		}
+		if size+len(item.Raw) > 64*1024 {
+			break
+		}
+		size += len(item.Raw)
+		reverse = append(reverse, json.RawMessage(item.Raw))
+	}
+	items := make([]json.RawMessage, len(reverse))
+	for i := range reverse {
+		items[len(reverse)-1-i] = reverse[i]
+	}
+	return items
+}
+
+func streamPortableCompaction(ctx context.Context, cfg *config.Config, auth *coreauth.Auth, req coreexecutor.Request, opts coreexecutor.Options, native bool, execute portableExecuteFunc) (*coreexecutor.StreamResult, error) {
+	response, err := executePortableCompaction(ctx, cfg, auth, req, opts, native, execute)
+	if err != nil {
+		return nil, err
+	}
+	item := json.RawMessage(gjson.GetBytes(response.Payload, "output.0").Raw)
+	created, _ := sjson.SetBytes(response.Payload, "status", "in_progress")
+	created, _ = sjson.SetRawBytes(created, "output", []byte("[]"))
+	frames := []map[string]any{
+		{"type": "response.created", "response": json.RawMessage(created)},
+		{"type": "response.output_item.added", "output_index": 0, "item": item},
+		{"type": "response.output_item.done", "output_index": 0, "item": item},
+		{"type": "response.completed", "response": json.RawMessage(response.Payload)},
+	}
+	chunks := make(chan coreexecutor.StreamChunk, len(frames))
+	for i, frame := range frames {
+		frame["sequence_number"] = i
+		data, _ := json.Marshal(frame)
+		chunks <- coreexecutor.StreamChunk{Payload: []byte(fmt.Sprintf("event: %s\ndata: %s\n\n", frame["type"], data))}
+	}
+	close(chunks)
+	return &coreexecutor.StreamResult{Headers: response.Headers, Chunks: chunks}, nil
+}
