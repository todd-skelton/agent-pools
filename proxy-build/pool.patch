@@ -0,0 +1,31 @@
+package helps
+
+import (
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/clientversion"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+)
+
+func TestDefaultClaudeProfileFollowsInstalledClaudeCode(t *testing.T) {
+	if got := DefaultClaudeVersion(nil); got != "2.1.280" {
+		t.Fatalf("compiled default = %q", got)
+	}
+	restore := clientversion.SetForTesting(clientversion.ClaudeCode, "2.1.284")
+	defer restore()
+	if got := defaultClaudeDeviceProfile(nil).UserAgent; got != "claude-cli/2.1.284 (external, cli)" {
+		t.Fatalf("baseline user agent = %q", got)
+	}
+	if got := DefaultClaudeVersion(nil); got != "2.1.284" {
+		t.Fatalf("billing version = %q", got)
+	}
+	// A native request from the installed version is now plausible.
+	if !plausibleClaudeCodeUserAgent("claude-cli/2.1.284 (external, cli)", nil) {
+		t.Fatal("installed Claude Code user agent rejected")
+	}
+	// An explicit user-agent still wins over the installed version.
+	cfg := &config.Config{ClaudeHeaderDefaults: config.ClaudeHeaderDefaults{UserAgent: "claude-cli/2.1.290 (external, cli)"}}
+	if got := DefaultClaudeVersion(cfg); got != "2.1.290" {
+		t.Fatalf("configured override = %q", got)
+	}
+}
diff --git a/internal/runtime/executor/helps/claude_tool_threads.go b/internal/runtime/executor/helps/claude_tool_threads.go
new file mode 100644
index 0000000000000000000000000000000000000000..e72ae05e5945507efe21a344c6cabd1376d201dc
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_tool_threads.go
@@ -0,0 +1,191 @@
+package helps
+
+import (
+	"bytes"
+	"container/list"
+	"crypto/sha256"
+	"encoding/json"
+	"maps"
+	"net/http"
+	"sync"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/tidwall/gjson"
+)
+
+// Only tool symbols are retained, never prompts, tool arguments or credentials.
+// Missing state uses the Messages API replay contract, including after rotation.
+var claudeToolThreads = newClaudeToolThreadCache(1024, 8<<20, 5*time.Minute, time.Now)
+
+type claudeToolThreadEntry struct {
+	key       [32]byte
+	reverse   map[string]string
+	aliases   bool
+	expiresAt time.Time
+	bytes     int
+}
+
+type claudeToolThreadCache struct {
+	mu                   sync.Mutex
+	entries              map[[32]byte]*list.Element
+	order                *list.List
+	maxEntries, maxBytes int
+	bytes                int
+	ttl                  time.Duration
+	now                  func() time.Time
+}
+
+func newClaudeToolThreadCache(maxEntries, maxBytes int, ttl time.Duration, now func() time.Time) *claudeToolThreadCache {
+	return &claudeToolThreadCache{entries: make(map[[32]byte]*list.Element), order: list.New(), maxEntries: maxEntries, maxBytes: maxBytes, ttl: ttl, now: now}
+}
+
+type ClaudeToolThread struct {
+	cache   *claudeToolThreadCache
+	scope   [32]byte
+	aliases bool
+	Reverse map[string]string
+}
+
+type claudeToolThreadReplayError struct {
+	*cliproxyexecutor.RequestTerminatedError
+}
+
+func (*claudeToolThreadReplayError) IsRequestScoped() bool { return true }
+
+func (e *claudeToolThreadReplayError) Unwrap() error { return e.RequestTerminatedError }
+
+func claudeToolThreadReplay() error {
+	return &claudeToolThreadReplayError{&cliproxyexecutor.RequestTerminatedError{
+		HTTPStatus: http.StatusNotFound,
+		Body:       []byte(`{"type":"error","error":{"type":"not_found_error","message":"Thread tool state is unavailable; replay the full conversation in a new create request.","details":{"error_code":"thread_not_found"}}}`),
+	}}
+}
+
+// Preserve the API's replay signal; rebuilding a generic error drops details.
+func ClaudeThreadReplayErrorResponse(status int, headers http.Header, body []byte) error {
+	code := gjson.GetBytes(body, "error.details.error_code").String()
+	if !(status == http.StatusNotFound && code == "thread_not_found") &&
+		!(status == http.StatusBadRequest && (code == "thread_already_continued" || code == "thread_continue_in_flight")) {
+		return nil
+	}
+	header := headers.Clone()
+	header.Del("Content-Encoding")
+	header.Del("Content-Length")
+	return &claudeToolThreadReplayError{&cliproxyexecutor.RequestTerminatedError{HTTPStatus: status, Header: header, Body: bytes.Clone(body)}}
+}
+
+func BeginClaudeToolThread(caller, account, upstream, model string, body []byte, aliases bool) (*ClaudeToolThread, error) {
+	return claudeToolThreads.begin(caller, account, upstream, model, body, aliases)
+}
+
+func (c *claudeToolThreadCache) begin(caller, account, upstream, model string, body []byte, aliases bool) (*ClaudeToolThread, error) {
+	kind := gjson.GetBytes(body, "thread.type").String()
+	if kind != "create" && kind != "continue" {
+		return nil, nil
+	}
+	if caller == "" || account == "" {
+		if kind == "continue" {
+			return nil, claudeToolThreadReplay()
+		}
+		return nil, nil
+	}
+	scope, _ := json.Marshal([]string{caller, account, upstream, model})
+	state := &ClaudeToolThread{cache: c, scope: sha256.Sum256(scope), aliases: aliases}
+	if kind == "create" {
+		return state, nil
+	}
+	// A tool-set update requires rebuilding declarations. Let the client replay
+	// its authoritative full history instead of guessing a new symbol table.
+	if claudeThreadHasToolChanges(gjson.ParseBytes(body)) {
+		return nil, claudeToolThreadReplay()
+	}
+	key := state.key(gjson.GetBytes(body, "thread.previous_message_id").String())
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	el := c.entries[key]
+	if el == nil {
+		return nil, claudeToolThreadReplay()
+	}
+	entry := el.Value.(*claudeToolThreadEntry)
+	if !c.now().Before(entry.expiresAt) {
+		c.remove(el)
+		return nil, claudeToolThreadReplay()
+	}
+	if entry.aliases != aliases {
+		return nil, claudeToolThreadReplay()
+	}
+	c.order.MoveToBack(el)
+	state.Reverse = maps.Clone(entry.reverse)
+	return state, nil
+}
+
+func claudeThreadHasToolChanges(value gjson.Result) bool {
+	if value.IsObject() {
+		if changes := value.Get("tool_changes"); changes.Exists() && changes.Raw != "[]" && changes.Raw != "null" {
+			return true
+		}
+	}
+	found := false
+	if value.IsArray() || value.IsObject() {
+		value.ForEach(func(key, child gjson.Result) bool {
+			// Do not interpret arbitrary user tool arguments as protocol fields.
+			if key.String() == "input" || key.String() == "input_schema" {
+				return true
+			}
+			found = claudeThreadHasToolChanges(child)
+			return !found
+		})
+	}
+	return found
+}
+
+func (s *ClaudeToolThread) key(messageID string) [32]byte {
+	return sha256.Sum256(append(append([]byte(nil), s.scope[:]...), []byte(messageID)...))
+}
+
+// Commit must run before publishing message_stop to avoid a next-turn race.
+// Callers must never commit an incomplete or failed upstream response.
+func (s *ClaudeToolThread) Commit(messageID string, reverse map[string]string) {
+	if s == nil || messageID == "" {
+		return
+	}
+	size := 128
+	for alias, original := range reverse {
+		size += len(alias) + len(original) + 64
+	}
+	if size > 128<<10 {
+		return
+	}
+	c := s.cache
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	now := c.now()
+	for el := c.order.Front(); el != nil; {
+		next := el.Next()
+		if !now.Before(el.Value.(*claudeToolThreadEntry).expiresAt) {
+			c.remove(el)
+		}
+		el = next
+	}
+	key := s.key(messageID)
+	if old := c.entries[key]; old != nil {
+		c.remove(old)
+	}
+	for c.order.Len() > 0 && (c.order.Len() >= c.maxEntries || c.bytes+size > c.maxBytes) {
+		c.remove(c.order.Front())
+	}
+	if c.maxEntries < 1 || size > c.maxBytes {
+		return
+	}
+	entry := &claudeToolThreadEntry{key: key, reverse: maps.Clone(reverse), aliases: s.aliases, expiresAt: now.Add(c.ttl), bytes: size}
+	c.entries[key] = c.order.PushBack(entry)
+	c.bytes += size
+}
+
+func (c *claudeToolThreadCache) remove(el *list.Element) {
+	entry := el.Value.(*claudeToolThreadEntry)
+	delete(c.entries, entry.key)
+	c.bytes -= entry.bytes
+	c.order.Remove(el)
+}
diff --git a/internal/runtime/executor/helps/claude_tool_threads_test.go b/internal/runtime/executor/helps/claude_tool_threads_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c84d337010b89ff305e80edac54b763aede6c684
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_tool_threads_test.go
@@ -0,0 +1,153 @@
+package helps
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/tidwall/gjson"
+)
+
+func TestClaudeToolThreadsUpstreamReplayError(t *testing.T) {
+	for _, tc := range []struct {
+		status int
+		code   string
+		replay bool
+	}{
+		{404, "thread_not_found", true}, {400, "thread_already_continued", true},
+		{400, "thread_continue_in_flight", true}, {400, "thread_fingerprint_mismatch", false},
+		{429, "thread_not_found", false}, {404, "not_a_thread_error", false},
+	} {
+		body := []byte(fmt.Sprintf(`{"type":"error","error":{"details":{"error_code":%q}}}`, tc.code))
+		err := ClaudeThreadReplayErrorResponse(tc.status, http.Header{"Content-Encoding": {"gzip"}, "Content-Length": {"123"}}, body)
+		if (err != nil) != tc.replay {
+			t.Fatalf("%+v: %v", tc, err)
+		}
+		if err != nil {
+			var direct *cliproxyexecutor.RequestTerminatedError
+			if !errors.As(err, &direct) || string(direct.Body) != string(body) || direct.Header.Get("Content-Encoding") != "" || direct.Header.Get("Content-Length") != "" {
+				t.Fatal("lost upstream replay signal")
+			}
+		}
+	}
+}
+
+func assertClaudeThreadReplay(t *testing.T, err error) {
+	t.Helper()
+	var direct *cliproxyexecutor.RequestTerminatedError
+	if !errors.As(err, &direct) || direct.HTTPStatus != 404 || gjson.GetBytes(direct.Body, "error.details.error_code").String() != "thread_not_found" {
+		t.Fatalf("expected replayable 404, got %T %v", err, err)
+	}
+	if scoped, ok := err.(cliproxyexecutor.RequestScopedError); !ok || !scoped.IsRequestScoped() {
+		t.Fatal("replay must not cool or retry another account")
+	}
+}
+
+func TestClaudeToolThreadsContinuationAndAccountRotation(t *testing.T) {
+	c := newClaudeToolThreadCache(10, 1<<20, time.Minute, time.Now)
+	create := []byte(`{"thread":{"type":"create"}}`)
+	continued := []byte(`{"thread":{"type":"continue","previous_message_id":"msg_a"},"messages":[]}`)
+	s, err := c.begin("caller-a", "account-a", "origin", "model", create, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := map[string]string{"mcp__server__read": "Read"}
+	s.Commit("msg_a", original)
+	original["mcp__server__read"] = "mutated"
+	loaded, err := c.begin("caller-a", "account-a", "origin", "model", continued, true)
+	if err != nil || loaded.Reverse["mcp__server__read"] != "Read" {
+		t.Fatalf("continuation: %+v %v", loaded, err)
+	}
+	loaded.Reverse["mcp__server__read"] = "local-change"
+	for _, test := range []struct {
+		caller, account, origin, model string
+		aliases                        bool
+	}{
+		{"caller-b", "account-a", "origin", "model", true},
+		{"caller-a", "account-b", "origin", "model", true},
+		{"caller-a", "account-a", "other-origin", "model", true},
+		{"caller-a", "account-a", "origin", "other-model", true},
+		{"caller-a", "account-a", "origin", "model", false},
+		{"", "account-a", "origin", "model", true},
+	} {
+		_, err = c.begin(test.caller, test.account, test.origin, test.model, continued, test.aliases)
+		assertClaudeThreadReplay(t, err)
+	}
+	// Rotation replays full declarations on B; it cannot steal or mutate A's state.
+	b, err := c.begin("caller-a", "account-b", "origin", "model", create, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b.Commit("msg_b", map[string]string{"mcp__server__grep": "Grep"})
+	b, err = c.begin("caller-a", "account-b", "origin", "model", []byte(`{"thread":{"type":"continue","previous_message_id":"msg_b"}}`), true)
+	if err != nil || b.Reverse["mcp__server__grep"] != "Grep" {
+		t.Fatalf("rotated continuation: %+v %v", b, err)
+	}
+	a, err := c.begin("caller-a", "account-a", "origin", "model", continued, true)
+	if err != nil || a.Reverse["mcp__server__read"] != "Read" {
+		t.Fatalf("original state changed: %+v %v", a, err)
+	}
+	_, err = c.begin("caller-a", "account-b", "origin", "model", continued, true)
+	assertClaudeThreadReplay(t, err)
+}
+
+func TestClaudeToolThreadsExpiryEvictionAndToolChanges(t *testing.T) {
+	now := time.Unix(1000, 0)
+	c := newClaudeToolThreadCache(2, 1<<20, time.Minute, func() time.Time { return now })
+	s, _ := c.begin("caller", "account", "origin", "model", []byte(`{"thread":{"type":"create"}}`), true)
+	load := func(id string, extra string) error {
+		_, err := c.begin("caller", "account", "origin", "model", []byte(fmt.Sprintf(`{"thread":{"type":"continue","previous_message_id":%q},"messages":%s}`, id, extra)), true)
+		return err
+	}
+	s.Commit("one", map[string]string{"alias": "Read"})
+	assertClaudeThreadReplay(t, load("unknown", `[]`))
+	assertClaudeThreadReplay(t, load("one", `[{"role":"system","tool_changes":[{"type":"add"}]}]`))
+	if err := load("one", `[{"role":"assistant","content":[{"type":"tool_use","input":{"tool_changes":["data"]}}]}]`); err != nil {
+		t.Fatal(err)
+	}
+	s.Commit("two", nil)
+	if err := load("one", `[]`); err != nil {
+		t.Fatal(err)
+	}
+	s.Commit("three", nil)
+	assertClaudeThreadReplay(t, load("two", `[]`))
+	now = now.Add(time.Minute)
+	assertClaudeThreadReplay(t, load("one", `[]`))
+	s.Commit("four", nil)
+	if len(c.entries) != 1 {
+		t.Fatalf("expired entries retained: %d", len(c.entries))
+	}
+	s.Commit("oversized", map[string]string{"alias": strings.Repeat("x", 128<<10)})
+	assertClaudeThreadReplay(t, load("oversized", `[]`))
+	c.maxBytes = 128
+	s.Commit("five", nil)
+	if c.bytes > c.maxBytes || len(c.entries) != 1 {
+		t.Fatal("byte bound exceeded")
+	}
+}
+
+func TestClaudeToolThreadsConcurrentIsolation(t *testing.T) {
+	c := newClaudeToolThreadCache(128, 1<<20, time.Minute, time.Now)
+	var wg sync.WaitGroup
+	for i := range 40 {
+		wg.Go(func() {
+			caller := fmt.Sprint(i)
+			s, err := c.begin(caller, "account", "origin", "model", []byte(`{"thread":{"type":"create"}}`), true)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			s.Commit("same-message", map[string]string{"alias": caller})
+			s, err = c.begin(caller, "account", "origin", "model", []byte(`{"thread":{"type":"continue","previous_message_id":"same-message"}}`), true)
+			if err != nil || s.Reverse["alias"] != caller {
+				t.Errorf("caller isolation failed for %s", caller)
+			}
+		})
+	}
+	wg.Wait()
+}
diff --git a/internal/runtime/executor/helps/native_handoff_store.go b/internal/runtime/executor/helps/native_handoff_store.go
new file mode 100644
index 0000000000000000000000000000000000000000..3eddb728af607065ddaf7c2b26d27aa25666eee6
--- /dev/null
+++ b/internal/runtime/executor/helps/native_handoff_store.go
@@ -0,0 +1,153 @@
+package helps
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+)
+
+// nativeHandoffWriteMu serializes publication: Windows rejects concurrent
+// renames onto the same file with "Access is denied".
+var nativeHandoffWriteMu sync.Mutex
+
+const nativeHandoffVersion = "pool-handoff-v1"
+
+// NativeHandoffStore keeps Claude-readable summaries of native GPT compaction
+// checkpoints outside the conversation, so the checkpoint the client stores
+// stays exactly what OpenAI returned. Entries are keyed by caller scope and the
+// native checkpoint digest and sealed with the portable keyring. Losing the
+// store only affects switching a natively compacted task to Claude.
+type NativeHandoffStore struct {
+	dir  string
+	ring *PortableKeyring
+}
+
+type nativeHandoffRecord struct {
+	Summary string `json:"summary"`
+	Model   string `json:"model"`
+	Created string `json:"created"`
+}
+
+// NativeHandoffDir is the store directory next to the keyring file.
+func NativeHandoffDir(keyFile string) string {
+	return filepath.Join(filepath.Dir(keyFile), "compaction-handoffs")
+}
+
+func NewNativeHandoffStore(dir string, ring *PortableKeyring) (*NativeHandoffStore, error) {
+	if strings.TrimSpace(dir) == "" || ring == nil {
+		return nil, errors.New("native compaction handoff store is not configured")
+	}
+	return &NativeHandoffStore{dir: dir, ring: ring}, nil
+}
+
+// NativeHandoffKey identifies one native checkpoint for one caller.
+func NativeHandoffKey(callerScope, native string) string {
+	sum := sha256.Sum256([]byte(nativeHandoffVersion + "\x00" + callerScope + "\x00" + native))
+	return hex.EncodeToString(sum[:])
+}
+
+func (s *NativeHandoffStore) path(key string) string {
+	return filepath.Join(s.dir, key+".json")
+}
+
+func nativeHandoffAD(kid, key string) []byte {
+	return []byte(nativeHandoffVersion + ":" + kid + ":" + key)
+}
+
+// Put seals and atomically publishes the summary for a native checkpoint.
+func (s *NativeHandoffStore) Put(callerScope, native, summary, model string) error {
+	if callerScope == "" || strings.TrimSpace(native) == "" {
+		return errors.New("native compaction handoff requires caller scope and checkpoint")
+	}
+	if strings.TrimSpace(summary) == "" || len(summary) > PortableSummaryMaxBytes {
+		return errors.New("native compaction handoff summary is empty or too large")
+	}
+	aead, err := s.ring.aead(s.ring.Active)
+	if err != nil {
+		return err
+	}
+	key := NativeHandoffKey(callerScope, native)
+	plaintext, _ := json.Marshal(nativeHandoffRecord{Summary: summary, Model: model, Created: time.Now().UTC().Format(time.RFC3339)})
+	nonce := make([]byte, aead.NonceSize())
+	if _, err = rand.Read(nonce); err != nil {
+		return err
+	}
+	sealed := aead.Seal(nonce, nonce, plaintext, nativeHandoffAD(s.ring.Active, key))
+	value := nativeHandoffVersion + ":" + s.ring.Active + ":" + base64.RawURLEncoding.EncodeToString(sealed)
+	if err = os.MkdirAll(s.dir, 0o700); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(s.dir, key+".*.tmp")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	_, errWrite := tmp.WriteString(value)
+	errSync := tmp.Sync()
+	errClose := tmp.Close()
+	if err = errors.Join(errWrite, errSync, errClose); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	nativeHandoffWriteMu.Lock()
+	defer nativeHandoffWriteMu.Unlock()
+	for attempt := 0; ; attempt++ {
+		if err = os.Rename(tmpName, s.path(key)); err == nil {
+			return nil
+		}
+		// Another process may hold the target open briefly (Windows). An
+		// existing readable record for the same checkpoint is equivalent.
+		if _, ok, errGet := s.Get(callerScope, native); errGet == nil && ok {
+			_ = os.Remove(tmpName)
+			return nil
+		}
+		if attempt >= 4 {
+			_ = os.Remove(tmpName)
+			return err
+		}
+		time.Sleep(time.Duration(attempt+1) * 20 * time.Millisecond)
+	}
+}
+
+// Get returns the summary for a native checkpoint. ok=false means none exists.
+// A present but unreadable entry is an error, never silently ignored.
+func (s *NativeHandoffStore) Get(callerScope, native string) (string, bool, error) {
+	if callerScope == "" || strings.TrimSpace(native) == "" {
+		return "", false, nil
+	}
+	key := NativeHandoffKey(callerScope, native)
+	b, err := os.ReadFile(s.path(key))
+	if errors.Is(err, os.ErrNotExist) {
+		return "", false, nil
+	}
+	if err != nil {
+		return "", false, errors.New("native compaction handoff store is unreadable")
+	}
+	rest, ok := strings.CutPrefix(string(b), nativeHandoffVersion+":")
+	kid, encoded, okCut := strings.Cut(rest, ":")
+	if !ok || !okCut {
+		return "", false, errors.New("native compaction handoff entry is invalid")
+	}
+	aead, err := s.ring.aead(kid)
+	if err != nil {
+		return "", false, err
+	}
+	sealed, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || len(sealed) < aead.NonceSize()+aead.Overhead() {
+		return "", false, errors.New("native compaction handoff entry is invalid")
+	}
+	plaintext, err := aead.Open(nil, sealed[:aead.NonceSize()], sealed[aead.NonceSize():], nativeHandoffAD(kid, key))
+	var record nativeHandoffRecord
+	if err != nil || json.Unmarshal(plaintext, &record) != nil || strings.TrimSpace(record.Summary) == "" || len(record.Summary) > PortableSummaryMaxBytes {
+		return "", false, errors.New("native compaction handoff entry failed authentication; restore the original keyring")
+	}
+	return record.Summary, true, nil
+}
