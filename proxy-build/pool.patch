+	if _, _, _, err := preparePortableRequest(&config.Config{PortableCompactionKeyFile: "missing-file"}, native, opts, true); err != nil {
+		t.Fatal("native replay requires pool keyring", err)
+	}
+	cfg := portableTestConfig(t)
+	request = coreexecutor.Request{Model: "claude-opus-5-5", Payload: []byte(`{"input":[{"role":"user","content":"exact latest request"},{"type":"compaction_trigger"}]}`)}
+	calls := 0
+	execute := func(ctx context.Context, _ *coreauth.Auth, req coreexecutor.Request, _ coreexecutor.Options) (coreexecutor.Response, error) {
+		calls++
+		if calls == 1 {
+			return coreexecutor.Response{}, fmt.Errorf("prompt is too long")
+		}
+		if !helps.IsPortableSummary(ctx) {
+			t.Fatal("summary guard missing")
+		}
+		return coreexecutor.Response{Payload: []byte(`{"id":"upstream","status":"completed","output":[{"type":"message","content":[{"type":"output_text","text":"summary"}]}]}`)}, nil
+	}
+	opts.Alt = "responses/compact"
+	response, err := executePortableCompaction(context.Background(), cfg, nil, request, opts, false, execute)
+	if err != nil || calls != 2 {
+		t.Fatalf("context retry calls=%d err=%v", calls, err)
+	}
+	if gjson.GetBytes(response.Payload, "output.0.content").String() != "exact latest request" {
+		t.Fatal("standalone lost raw user message")
+	}
+	ring, _ := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	checkpoint, err := ring.Open(gjson.GetBytes(response.Payload, "output.1.encrypted_content").String(), "caller")
+	if err != nil || !checkpoint.Truncated {
+		t.Fatal("reduced context not declared")
+	}
+	calls = 0
+	_, err = executePortableCompaction(context.Background(), cfg, nil, request, opts, false, func(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+		calls++
+		return coreexecutor.Response{}, fmt.Errorf("context_length_exceeded")
+	})
+	if err == nil || calls != 2 {
+		t.Fatal("unbounded context retries")
+	}
+}
