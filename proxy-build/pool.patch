diff --git a/internal/auth/claude/anthropic_auth_refresh_failure_test.go b/internal/auth/claude/anthropic_auth_refresh_failure_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e2b9c289e1463581e6e1ce29ead3b0f23cf38f60
--- /dev/null
+++ b/internal/auth/claude/anthropic_auth_refresh_failure_test.go
@@ -0,0 +1,106 @@
+package claude
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+const invalidGrantBody = `{"error": "invalid_grant", "error_description": "Refresh token not found or invalid"}`
+
+func invalidGrantResponse(req *http.Request) *http.Response {
+	return &http.Response{
+		StatusCode: http.StatusBadRequest,
+		Body:       io.NopCloser(strings.NewReader(invalidGrantBody)),
+		Header:     make(http.Header),
+		Request:    req,
+	}
+}
+
+// 2026-09-29 08:01: the first POST timed out, the retry got invalid_grant. The
+// error has to say what most likely happened, and keep the endpoint status.
+func TestRefreshTokensWithRetry_InvalidGrantAfterTransitFailureIsExplained(t *testing.T) {
+	resetClaudeRefreshState()
+	defer resetClaudeRefreshState()
+
+	var calls int32
+	auth := &ClaudeAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if atomic.AddInt32(&calls, 1) == 1 {
+			return nil, context.DeadlineExceeded
+		}
+		return invalidGrantResponse(req), nil
+	})}}
+
+	_, err := auth.RefreshTokensWithRetry(context.Background(), "rotated-refresh-token", 3)
+	if err == nil {
+		t.Fatal("expected refresh error")
+	}
+	if got := atomic.LoadInt32(&calls); got != 2 {
+		t.Fatalf("refresh attempts = %d, want 2 (invalid_grant is not retried)", got)
+	}
+	for _, want := range []string{"invalid_grant", "rotated the refresh token", "sign in again"} {
+		if !strings.Contains(err.Error(), want) {
+			t.Fatalf("error %q does not mention %q", err, want)
+		}
+	}
+	var httpErr *refreshHTTPError
+	if !errors.As(err, &httpErr) || httpErr.RefreshHTTPStatus() != http.StatusBadRequest {
+		t.Fatalf("error %v does not carry the endpoint status 400", err)
+	}
+}
+
+func TestRefreshTokensWithRetry_PlainInvalidGrantIsNotAttributedToALostReply(t *testing.T) {
+	resetClaudeRefreshState()
+	defer resetClaudeRefreshState()
+
+	auth := &ClaudeAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		return invalidGrantResponse(req), nil
+	})}}
+	_, err := auth.RefreshTokensWithRetry(context.Background(), "revoked-refresh-token", 3)
+	if err == nil || !strings.Contains(err.Error(), "invalid_grant") {
+		t.Fatalf("error = %v, want invalid_grant", err)
+	}
+	if strings.Contains(err.Error(), "rotated") {
+		t.Fatalf("error %q blames a lost reply without a failed attempt", err)
+	}
+}
+
+func TestRefreshTokens_ProfileLookupHasItsOwnBudget(t *testing.T) {
+	resetClaudeRefreshState()
+	defer resetClaudeRefreshState()
+
+	var refreshDeadline, profileDeadline time.Time
+	auth := &ClaudeAuth{httpClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		deadline, ok := req.Context().Deadline()
+		if !ok {
+			t.Fatalf("%s request has no deadline", req.URL)
+		}
+		switch req.URL.String() {
+		case RefreshTokenURL:
+			refreshDeadline = deadline
+			return jsonResponse(req, `{"access_token":"new-access","refresh_token":"new-refresh","expires_in":3600}`), nil
+		case ProfileURL:
+			profileDeadline = deadline
+			return jsonResponse(req, `{"account":{"uuid":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","email":"a@example.com"},"organization":{"uuid":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","name":"Org"}}`), nil
+		default:
+			t.Fatalf("unexpected OAuth request URL %s", req.URL)
+			return nil, nil
+		}
+	})}}
+
+	start := time.Now()
+	if _, err := auth.RefreshTokens(context.Background(), "budget-refresh-token"); err != nil {
+		t.Fatalf("RefreshTokens() error = %v", err)
+	}
+	if got := refreshDeadline.Sub(start); got < 55*time.Second || got > 61*time.Second {
+		t.Fatalf("token POST budget = %s, want about %s", got, claudeRefreshTimeout)
+	}
+	if got := profileDeadline.Sub(start); got <= 0 || got > claudeRefreshProfileTimeout+time.Second {
+		t.Fatalf("profile budget = %s, want its own %s", got, claudeRefreshProfileTimeout)
+	}
+}
diff --git a/internal/client/codex/optimize-multi-agent-v2/delegation_content.go b/internal/client/codex/optimize-multi-agent-v2/delegation_content.go
new file mode 100644
index 0000000000000000000000000000000000000000..fb0d2210ae8dc268a2f449607693332008c25d87
--- /dev/null
+++ b/internal/client/codex/optimize-multi-agent-v2/delegation_content.go
@@ -0,0 +1,64 @@
+package multiagentv2
+
+import (
+	"encoding/base64"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// isOpaqueDelegationText recognizes the OpenAI/Fernet carrier, not arbitrary
+// reasoning or compaction ciphertext. This is detection, never decryption.
+func isOpaqueDelegationText(value string) bool {
+	value = strings.TrimSpace(value)
+	// Also reject damaged/truncated tokens with the known timestamp prefix.
+	if strings.HasPrefix(value, "gAAAA") {
+		return true
+	}
+	decoded, err := base64.RawURLEncoding.DecodeString(strings.TrimRight(value, "="))
+	// Version + timestamp + IV + at least one AES block + HMAC. A decoded
+	// prefix (or short plaintext such as "gA") is not evidence of encryption.
+	return err == nil && len(decoded) >= 73 && (len(decoded)-57)%16 == 0 && decoded[0] == 0x80
+}
+
+// HasUnreadableCodexDelegation checks only delegated task content. A plaintext
+// payload in the legacy encrypted_content wrapper remains supported. Unknown
+// future encryption formats require their own adapter; no keys are consulted.
+func HasUnreadableCodexDelegation(payload []byte) bool {
+	for _, item := range gjson.GetBytes(payload, "input").Array() {
+		if strings.TrimSpace(item.Get("type").String()) != "agent_message" {
+			continue
+		}
+		content := item.Get("content")
+		if content.Type == gjson.String {
+			if strings.TrimSpace(content.String()) == "" || isOpaqueDelegationText(content.String()) {
+				return true
+			}
+			continue
+		}
+		if !content.IsArray() || len(content.Array()) == 0 {
+			return true
+		}
+		for _, part := range content.Array() {
+			if !part.IsObject() || part.Get("type").Type != gjson.String {
+				return true
+			}
+			switch strings.TrimSpace(part.Get("type").String()) {
+			case "encrypted_content":
+				value := part.Get("encrypted_content")
+				if value.Type != gjson.String || strings.TrimSpace(value.String()) == "" || isOpaqueDelegationText(value.String()) {
+					return true
+				}
+			case "input_text":
+				value := part.Get("text")
+				if part.Get("encrypted_content").Exists() || value.Type != gjson.String || isOpaqueDelegationText(value.String()) {
+					return true
+				}
+			default:
+				// Do not silently drop an unsupported portion of a delegated task.
+				return true
+			}
+		}
+	}
+	return false
+}
