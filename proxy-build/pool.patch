+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+	"github.com/tidwall/gjson"
+)
+
+func TestResponsesModelSwitchCompactionQuotaTransports(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, transport := range []string{"http", "websocket"} {
+		for _, reason := range []string{"comp_hash_changed", "context_limit"} {
+			t.Run(transport+"/"+reason, func(t *testing.T) {
+				model := "switch-quota-" + transport + "-" + reason
+				executor := &prematureResponsesStreamExecutor{}
+				manager := coreauth.NewManager(nil, nil, nil)
+				manager.RegisterExecutor(executor)
+				next := time.Now().Add(time.Hour)
+				auth := &coreauth.Auth{ID: model, Provider: executor.Identifier(), Status: coreauth.StatusActive,
+					Unavailable: true, NextRetryAfter: next, Quota: coreauth.QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: next}}
+				if _, err := manager.Register(context.Background(), auth); err != nil {
+					t.Fatal(err)
+				}
+				registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: model}})
+				t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+				base := handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager)
+				h := NewOpenAIResponsesAPIHandler(base)
+				metadata, _ := json.Marshal(map[string]any{"request_kind": "compaction", "compaction": map[string]string{
+					"trigger": "auto", "reason": reason, "phase": "pre_turn", "implementation": "responses_compaction_v2"}})
+				body, _ := json.Marshal(map[string]any{"type": "response.create", "model": model, "stream": true,
+					"input": []any{map[string]string{"type": "compaction_trigger"}}, "client_metadata": map[string]string{"x-codex-turn-metadata": string(metadata)}})
+				_, _, errs := base.ExecuteStreamWithAuthManager(context.Background(), "openai-response", model, body, "")
+				errMsg := <-errs
+				if errMsg == nil {
+					t.Fatal("expected pool quota error")
+				}
+				switching := reason == "comp_hash_changed"
+				if shouldExposeResponsesUpstreamError(errMsg) != switching || shouldReplayResponsesWebsocketPinnedAuthFailure(errMsg) == switching {
+					t.Fatal("switch fallback and ordinary silent quota replay not isolated")
+				}
+				router := gin.New()
+				router.POST("/v1/responses", h.Responses)
+				router.GET("/v1/responses", h.ResponsesWebsocket)
+				if transport == "http" {
+					request := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(string(body)))
+					request.Header.Set("Content-Type", "application/json")
+					request.Header.Set("User-Agent", "codex_cli_rs/0.162.0")
+					recorder := httptest.NewRecorder()
+					router.ServeHTTP(recorder, request)
+					want := http.StatusServiceUnavailable
+					if switching {
+						want = http.StatusTooManyRequests
+					}
+					if recorder.Code != want || recorder.Header().Get("Retry-After") == "" {
+						t.Fatalf("HTTP quota = %d %s, want %d with Retry-After", recorder.Code, recorder.Body, want)
+					}
+					if switching && gjson.Get(recorder.Body.String(), "error.type").String() != "usage_limit_reached" {
+						t.Fatal("HTTP switch quota does not permit fallback")
+					}
+					return
+				}
+				server := httptest.NewServer(router)
+				defer server.Close()
+				conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses", nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer conn.Close()
+				if err := conn.WriteMessage(websocket.TextMessage, body); err != nil {
+					t.Fatal(err)
+				}
+				_, payload, err := conn.ReadMessage()
+				if !switching {
+					if err == nil {
+						t.Fatalf("ordinary quota should close silently, got %s", payload)
+					}
+					return
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				if gjson.GetBytes(payload, "status").Int() != 429 || gjson.GetBytes(payload, "error.type").String() != "usage_limit_reached" {
+					t.Fatalf("WebSocket switch quota does not permit fallback: %s", payload)
+				}
+			})
+		}
+	}
+}
