@@ -0,0 +1,130 @@
+package handlers
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/interfaces"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/tidwall/gjson"
+)
+
+func switchCompactionRequest(reason, trigger, phase, kind string, compact bool) []byte {
+	metadata, _ := json.Marshal(map[string]any{
+		"request_kind": kind,
+		"compaction":   map[string]string{"reason": reason, "trigger": trigger, "phase": phase, "implementation": "responses_compaction_v2"},
+	})
+	input := []any{map[string]string{"type": "message", "role": "user", "content": "fixture history"}}
+	if compact {
+		input = append(input, map[string]string{"type": "compaction_trigger"})
+	}
+	body, _ := json.Marshal(map[string]any{"model": "old-model", "input": input, "client_metadata": map[string]string{"x-codex-turn-metadata": string(metadata)}})
+	return body
+}
+
+func TestModelSwitchCompactionQuotaFallback(t *testing.T) {
+	cause := coreauth.NewModelCooldownError("old-model", "claude", 3601*time.Second)
+	msg := ExecutionErrorMessage(cause)
+	shaped := shapeModelSwitchCompactionError(switchCompactionRequest("comp_hash_changed", "auto", "pre_turn", "compaction", true), msg)
+	wire := ShapeCodexErrorMessage(shaped)
+	if wire.StatusCode != http.StatusTooManyRequests || gjson.Get(wire.Error.Error(), "error.type").String() != "usage_limit_reached" {
+		t.Fatalf("model switch quota must permit fallback, got %d %s", wire.StatusCode, wire.Error)
+	}
+	for _, key := range []string{"code", "model", "provider", "reset_seconds", "message"} {
+		if gjson.Get(wire.Error.Error(), "error."+key).Raw != gjson.Get(cause.Error(), "error."+key).Raw {
+			t.Fatalf("quota field %s changed", key)
+		}
+	}
+	if gjson.Get(wire.Error.Error(), "error.resets_in_seconds").Int() != 3601 || wire.Addon.Get("Retry-After") != "3601" || !errors.Is(wire.Error, cause) {
+		t.Fatal("reset header, reset seconds or error cause lost")
+	}
+	failed := BuildOpenAIResponsesStreamFailedChunk(wire.StatusCode, wire.Error.Error(), 2)
+	if gjson.GetBytes(failed, "response.error.type").String() != "usage_limit_reached" {
+		t.Fatal("stream error no longer permits fallback")
+	}
+	if !IsModelSwitchCompactionQuotaError(wire.Error) || IsModelSwitchCompactionQuotaError(cause) {
+		t.Fatal("fallback marker escaped its request scope")
+	}
+	wrapped := ExecutionErrorMessage(fmt.Errorf("selection wrapper: %w", cause))
+	wrapped = shapeModelSwitchCompactionError(switchCompactionRequest("comp_hash_changed", "auto", "pre_turn", "compaction", true), wrapped)
+	if !IsModelSwitchCompactionQuotaError(wrapped.Error) || !errors.Is(wrapped.Error, cause) || coreauth.SafeResponseHeaders(wrapped.Error).Get("Retry-After") != "3601" {
+		t.Fatal("wrapped cooldown lost fallback classification, cause or headers")
+	}
+}
+
+func TestModelSwitchCompactionKeepsOrdinaryCooldownRetryable(t *testing.T) {
+	for _, tc := range []struct {
+		name, reason, trigger, phase, kind string
+		compact                            bool
+	}{
+		{"same-model-context-limit", "context_limit", "auto", "pre_turn", "compaction", true},
+		{"manual", "comp_hash_changed", "manual", "pre_turn", "compaction", true},
+		{"post-turn", "comp_hash_changed", "auto", "post_turn", "compaction", true},
+		{"ordinary-inference", "comp_hash_changed", "auto", "pre_turn", "regular", true},
+		{"missing-trigger-item", "comp_hash_changed", "auto", "pre_turn", "compaction", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			msg := ExecutionErrorMessage(coreauth.NewModelCooldownError("old-model", "claude", time.Hour))
+			got := shapeModelSwitchCompactionError(switchCompactionRequest(tc.reason, tc.trigger, tc.phase, tc.kind, tc.compact), msg)
+			if got != msg || ShapeCodexErrorMessage(got).StatusCode != http.StatusServiceUnavailable {
+				t.Fatal("ordinary cooldown must remain retryable for auto-continue")
+			}
+		})
+	}
+}
+
+func TestModelSwitchCompactionDoesNotReclassifyOtherFailures(t *testing.T) {
+	body := switchCompactionRequest("comp_hash_changed", "auto", "pre_turn", "compaction", true)
+	for _, msg := range []*interfaces.ErrorMessage{
+		nil,
+		{StatusCode: 503, Error: fmt.Errorf("temporary outage")},
+		{StatusCode: 429, Error: fmt.Errorf(`{"error":{"code":"rate_limit_exceeded","message":"burst rate limit"}}`)},
+		{StatusCode: 429, Error: fmt.Errorf(`{"error":{"code":"model_cooldown","reset_seconds":3600}}`)},
+		{StatusCode: 429, Error: coreauth.NewModelCooldownError("old-model", "claude", time.Hour), DirectResponse: true},
+	} {
+		if got := shapeModelSwitchCompactionError(body, msg); got != msg {
+			t.Fatalf("unproven quota or direct response changed: %#v", msg)
+		}
+	}
+	msg := ExecutionErrorMessage(coreauth.NewModelCooldownError("old-model", "claude", time.Hour))
+	for _, malformed := range [][]byte{nil, []byte(`{`), []byte(`{"client_metadata":{"x-codex-turn-metadata":"not JSON"}}`)} {
+		if got := shapeModelSwitchCompactionError(malformed, msg); got != msg {
+			t.Fatal("missing or malformed metadata changed cooldown")
+		}
+	}
+}
+
+func TestModelSwitchCompactionMetadataFailsClosed(t *testing.T) {
+	for _, kind := range []string{"prewarm", "unknown-implementation", "metadata-object", "metadata-array", "input-object"} {
+		t.Run(kind, func(t *testing.T) {
+			var request map[string]any
+			_ = json.Unmarshal(switchCompactionRequest("comp_hash_changed", "auto", "pre_turn", "compaction", true), &request)
+			metadata := request["client_metadata"].(map[string]any)
+			switch kind {
+			case "prewarm":
+				request["generate"] = false
+			case "input-object":
+				request["input"] = map[string]string{"type": "compaction_trigger"}
+			case "metadata-object":
+				metadata["x-codex-turn-metadata"] = map[string]string{"request_kind": "compaction"}
+			case "metadata-array":
+				metadata["x-codex-turn-metadata"] = "[]"
+			case "unknown-implementation":
+				var turn map[string]any
+				_ = json.Unmarshal([]byte(metadata["x-codex-turn-metadata"].(string)), &turn)
+				turn["compaction"].(map[string]any)["implementation"] = "future-protocol"
+				encoded, _ := json.Marshal(turn)
+				metadata["x-codex-turn-metadata"] = string(encoded)
+			}
+			body, _ := json.Marshal(request)
+			msg := ExecutionErrorMessage(coreauth.NewModelCooldownError("old-model", "claude", time.Hour))
+			if got := shapeModelSwitchCompactionError(body, msg); got != msg {
+				t.Fatal("unrecognized switch metadata must retain ordinary retry behavior")
+			}
+		})
+	}
+}
