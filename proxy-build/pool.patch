+
+type holdTestStatusErr struct {
+	code int
+	msg  string
+}
+
+func (e holdTestStatusErr) Error() string   { return e.msg }
+func (e holdTestStatusErr) StatusCode() int { return e.code }
+
+// outageExecutor fails every call with `status` until `until` (or until
+// `healthy` is set), then succeeds. It records call times and the peak number
+// of concurrent calls.
+type outageExecutor struct {
+	identifier string
+	status     int
+	until      time.Time
+	latency    time.Duration
+	healthy    atomic.Bool
+	failIf     func(req cliproxyexecutor.Request) bool
+	mu         sync.Mutex
+	calls      []time.Time
+	inFlight   int
+	peak       int
+}
+
+func (e *outageExecutor) Identifier() string { return e.identifier }
+
+func (e *outageExecutor) attempt(req cliproxyexecutor.Request) error {
+	e.mu.Lock()
+	e.calls = append(e.calls, time.Now())
+	e.inFlight++
+	if e.inFlight > e.peak {
+		e.peak = e.inFlight
+	}
+	e.mu.Unlock()
+	if e.latency > 0 {
+		time.Sleep(e.latency)
+	}
+	e.mu.Lock()
+	e.inFlight--
+	e.mu.Unlock()
+	if e.failIf != nil {
+		if e.failIf(req) {
+			return holdTestStatusErr{code: e.status, msg: http.StatusText(e.status)}
+		}
+		return nil
+	}
+	if e.healthy.Load() || (!e.until.IsZero() && time.Now().After(e.until)) {
+		return nil
+	}
+	return holdTestStatusErr{code: e.status, msg: http.StatusText(e.status)}
+}
+
+func (e *outageExecutor) Execute(_ context.Context, _ *Auth, req cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	if err := e.attempt(req); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func (e *outageExecutor) ExecuteStream(_ context.Context, _ *Auth, req cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	if err := e.attempt(req); err != nil {
+		return nil, err
+	}
+	chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("ok")}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func (*outageExecutor) Refresh(_ context.Context, auth *Auth) (*Auth, error) { return auth, nil }
+
+func (e *outageExecutor) CountTokens(_ context.Context, auth *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(context.Background(), auth, req, opts)
+}
+
+func (*outageExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func (e *outageExecutor) callCount() int {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return len(e.calls)
+}
+
+func (e *outageExecutor) peakInFlight() int {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return e.peak
+}
