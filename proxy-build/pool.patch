+// input content as well as appearing at the top level.
+func sanitizeCodexUnsupportedInternalChatMetadata(rawJSON []byte) []byte {
+	if len(rawJSON) == 0 || !bytes.Contains(rawJSON, []byte(`"internal_chat_message_metadata_passthrough"`)) || !bytes.Contains(rawJSON, []byte(`"content_token_count"`)) || !gjson.ValidBytes(rawJSON) {
