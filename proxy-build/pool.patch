+
+func TestInjectCodexRuntimeIdentityAppendsModelAndEffort(t *testing.T) {
+	t.Parallel()
+
+	payload := []byte(`{"model":"claude-fable-5-1","reasoning":{"effort":"high","summary":"detailed"},"instructions":"You are a coding agent.","input":[]}`)
+	got := injectCodexRuntimeIdentity(payload)
+
+	instructions := gjson.GetBytes(got, "instructions").String()
+	want := "You are a coding agent.\n\n# Runtime identity\n\nThis request was routed through the account pool for model `claude-fable-5-1` at reasoning effort `high`. When asked what model you are, report exactly these values; the session log is the audit record."
+	if instructions != want {
+		t.Fatalf("instructions = %q, want %q", instructions, want)
+	}
+	if gjson.GetBytes(got, "reasoning.effort").String() != "high" || gjson.GetBytes(got, "model").String() != "claude-fable-5-1" {
+		t.Fatalf("other fields changed: %s", got)
+	}
+}
+
+func TestInjectCodexRuntimeIdentityOmitsMissingEffort(t *testing.T) {
+	t.Parallel()
+
+	payload := []byte(`{"model":"gpt-6-astra","instructions":"Base prompt.","input":[]}`)
+	instructions := gjson.GetBytes(injectCodexRuntimeIdentity(payload), "instructions").String()
+	if !strings.HasSuffix(instructions, "for model `gpt-6-astra`. When asked what model you are, report exactly these values; the session log is the audit record.") {
+		t.Fatalf("instructions = %q", instructions)
+	}
+	if strings.Contains(instructions, "reasoning effort") {
+		t.Fatalf("effort phrase present without effort: %q", instructions)
+	}
+}
+
+func TestInjectCodexRuntimeIdentityLeavesInstructionLessRequestsAlone(t *testing.T) {
+	t.Parallel()
+
+	for name, payload := range map[string]string{
+		"null":       `{"model":"gpt-6-astra","instructions":null,"input":[{"type":"compaction_trigger"}]}`,
+		"missing":    `{"model":"gpt-6-astra","input":"hello"}`,
+		"empty":      `{"model":"gpt-6-astra","instructions":"","input":"hello"}`,
+		"whitespace": `{"model":"gpt-6-astra","instructions":"  \n","input":"hello"}`,
+		"nonstring":  `{"model":"gpt-6-astra","instructions":["x"],"input":"hello"}`,
+	} {
+		if got := string(injectCodexRuntimeIdentity([]byte(payload))); got != payload {
+			t.Fatalf("%s: payload changed: %s", name, got)
+		}
+	}
+}
+
+func TestInjectCodexRuntimeIdentityIsIdempotent(t *testing.T) {
+	t.Parallel()
+
+	payload := []byte(`{"model":"gpt-5.6-sol","reasoning":{"effort":"medium"},"instructions":"Base prompt.","input":[]}`)
+	once := injectCodexRuntimeIdentity(payload)
+	twice := injectCodexRuntimeIdentity(once)
+	if string(once) != string(twice) {
+		t.Fatalf("second injection changed payload:\n%s\n%s", once, twice)
+	}
+	if strings.Count(gjson.GetBytes(twice, "instructions").String(), codexRuntimeIdentityMarker) != 1 {
+		t.Fatalf("heading count != 1: %q", gjson.GetBytes(twice, "instructions").String())
+	}
+}
+
+func TestInjectCodexRuntimeIdentityInjectsWhenBasePromptMentionsHeading(t *testing.T) {
+	t.Parallel()
+
+	// The pool's instructions file tells the model to look for the section by
+	// name, so the heading alone must not count as an existing section.
+	payload := []byte(`{"model":"gpt-6-astra","reasoning":{"effort":"high"},"instructions":"Look for the # Runtime identity section at the end of these instructions.","input":[]}`)
+	instructions := gjson.GetBytes(injectCodexRuntimeIdentity(payload), "instructions").String()
+	if strings.Count(instructions, codexRuntimeIdentityMarker) != 1 {
+		t.Fatalf("section not appended once: %q", instructions)
+	}
+}
+
+func TestInjectCodexRuntimeIdentityUsesFirstDeveloperMessageWithoutInstructions(t *testing.T) {
+	t.Parallel()
+
+	// Shape Codex sends for GPT models: no instructions field, an
+	// additional_tools developer item, the base prompt as the first developer
+	// message, the skills block as the second, then the user turn.
+	payload := []byte(`{"model":"gpt-5.6-luna","reasoning":{"effort":"low"},"input":[
+		{"type":"additional_tools","id":"at_1","role":"developer","tools":[]},
+		{"type":"message","role":"developer","content":[{"type":"input_text","text":"You are a coding agent."}]},
+		{"type":"message","role":"developer","content":[{"type":"input_text","text":"<skills_instructions>"},{"type":"input_text","text":"<collaboration_mode>"}]},
+		{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]}
+	]}`)
+	got := injectCodexRuntimeIdentity(payload)
+
+	if gjson.GetBytes(got, "instructions").Exists() {
+		t.Fatalf("instructions field was created: %s", got)
+	}
+	base := gjson.GetBytes(got, "input.1.content.0.text").String()
+	want := "You are a coding agent.\n\n# Runtime identity\n\nThis request was routed through the account pool for model `gpt-5.6-luna` at reasoning effort `low`. When asked what model you are, report exactly these values; the session log is the audit record."
+	if base != want {
+		t.Fatalf("base prompt = %q, want %q", base, want)
+	}
+	for _, path := range []string{"input.0", "input.2", "input.3"} {
+		if gjson.GetBytes(got, path).Raw != gjson.GetBytes(payload, path).Raw {
+			t.Fatalf("%s changed: %s", path, gjson.GetBytes(got, path).Raw)
+		}
+	}
+	if string(injectCodexRuntimeIdentity(got)) != string(got) {
+		t.Fatalf("second injection changed payload")
+	}
+}
+
+func TestInjectCodexRuntimeIdentityPrefersInstructionsOverDeveloperMessage(t *testing.T) {
+	t.Parallel()
+
+	payload := []byte(`{"model":"claude-sonnet-5","reasoning":{"effort":"medium"},"instructions":"Base prompt.","input":[
+		{"type":"message","role":"developer","content":[{"type":"input_text","text":"<skills_instructions>"}]},
+		{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]}
+	]}`)
+	got := injectCodexRuntimeIdentity(payload)
+	if !strings.Contains(gjson.GetBytes(got, "instructions").String(), codexRuntimeIdentityMarker) {
+		t.Fatalf("instructions not extended: %s", got)
