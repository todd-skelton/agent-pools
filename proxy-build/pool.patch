+func portableTestConfig(t *testing.T) *config.Config {
+	t.Helper()
+	file := filepath.Join(t.TempDir(), "keys.json")
+	b, _ := json.Marshal(helps.PortableKeyring{Active: "test", Keys: map[string]string{"test": base64.StdEncoding.EncodeToString([]byte(strings.Repeat("a", 32)))}})
+	if err := os.WriteFile(file, b, 0600); err != nil {
+		t.Fatal(err)
