--- /dev/null
+++ b/internal/runtime/executor/helps/claude_delegation_test.go
@@ -0,0 +1,72 @@
+package helps
+
+import (
+	"encoding/base64"
+	"fmt"
+	"strings"
+	"testing"
+
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+func TestClaudeDelegationContentBoundary(t *testing.T) {
+	token := base64.RawURLEncoding.EncodeToString(append([]byte{0x80}, make([]byte, 88)...))
+	cases := []struct {
+		name, content string
+		reject        bool
+	}{
+		{"opaque", fmt.Sprintf(`{"type":"encrypted_content","encrypted_content":%q}`, token), true},
+		{"opaque padded", fmt.Sprintf(`{"type":"encrypted_content","encrypted_content":%q}`, token+"="), true},
+		{"opaque whitespace", fmt.Sprintf(`{"type":"encrypted_content","encrypted_content":%q}`, " \n"+token+"\t"), true},
+		{"opaque text", fmt.Sprintf(`{"type":"input_text","text":%q}`, token), true},
+		{"truncated", `{"type":"encrypted_content","encrypted_content":"gAAAA-damaged"}`, true},
+		{"null", `{"type":"encrypted_content","encrypted_content":null}`, true},
+		{"missing", `{"type":"encrypted_content"}`, true},
+		{"empty", `{"type":"encrypted_content","encrypted_content":""}`, true},
+		{"plaintext wrapper", `{"type":"encrypted_content","encrypted_content":"Review the fixture"}`, false},
+		{"plaintext", `{"type":"input_text","text":"Review the fixture"}`, false},
+		{"short base64 plaintext", `{"type":"input_text","text":"gA"}`, false},
+		{"invalid base64 prose", `{"type":"input_text","text":"gA: fix this"}`, false},
+		{"short wrapper plaintext", `{"type":"encrypted_content","encrypted_content":"gA"}`, false},
+		{"null text", `{"type":"input_text","text":null}`, true},
+		{"missing text", `{"type":"input_text"}`, true},
+		{"unknown part", `{"type":"unknown","encrypted_content":"gAAAA-damaged"}`, true},
+		{"unknown plaintext part", `{"type":"unknown","text":"task"}`, true},
+		{"inconsistent text part", `{"type":"input_text","text":"header","encrypted_content":"gAAAA-damaged"}`, true},
+		{"prose reference", fmt.Sprintf(`{"type":"input_text","text":%q}`, "Discuss the token format, e.g. "+token), false},
+	}
+	for _, content := range []string{`"gAAAA-damaged"`, `null`, `[]`, `{}`, `[null]`, `[{"text":"no type"}]`} {
+		payload := []byte(`{"input":[{"type":"agent_message","content":` + content + `}]}`)
+		if err := ValidateClaudeDelegation(sdktranslator.FormatOpenAIResponse, payload); err == nil {
+			t.Fatalf("accepted malformed content: %s", content)
+		}
+	}
+	for _, content := range []string{`"Review the fixture"`, `"gA"`, `"gA: fix this"`} {
+		payload := []byte(`{"input":[{"type":"agent_message","content":` + content + `}]}`)
+		if err := ValidateClaudeDelegation(sdktranslator.FormatOpenAIResponse, payload); err != nil {
+			t.Fatalf("rejected plaintext content: %s", content)
+		}
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			payload := []byte(`{"input":[{"type":"agent_message","content":[{"type":"input_text","text":"header"},` + tc.content + `]}]}`)
+			err := ValidateClaudeDelegation(sdktranslator.FormatOpenAIResponse, payload)
+			if (err != nil) != tc.reject {
+				t.Fatalf("rejected=%t want %t", err != nil, tc.reject)
+			}
+			if err != nil && strings.Contains(err.Error(), token) {
+				t.Fatal("error leaks content")
+			}
+		})
+	}
+	// Do not inspect ciphertext belonging to reasoning, compaction, tools, or
+	// ordinary user messages, or alter native Claude requests.
+	payload := []byte(fmt.Sprintf(`{"input":[{"type":"reasoning","encrypted_content":%q},{"type":"compaction","encrypted_content":%q},{"type":"message","role":"user","content":[{"type":"input_text","text":%q}]},{"type":"function_call_output","output":%q}]}`, token, token, token, token))
+	if err := ValidateClaudeDelegation(sdktranslator.FormatOpenAIResponse, payload); err != nil {
+		t.Fatal(err)
+	}
+	native := []byte(fmt.Sprintf(`{"input":[{"type":"agent_message","content":[{"type":"encrypted_content","encrypted_content":%q}]}]}`, token))
+	if err := ValidateClaudeDelegation(sdktranslator.FormatClaude, native); err != nil {
+		t.Fatal(err)
+	}
+}
