+func TestOutageHoldBudgetExpiresThenSameTurnFailsFast(t *testing.T) {
+	executor := &outageExecutor{identifier: holdTestProvider, status: http.StatusServiceUnavailable, until: time.Now().Add(time.Hour)}
+	manager := setupOutagePool(t, 1, executor, OutageHoldConfig{Enabled: true, MaxWait: 1500 * time.Millisecond, ProbeInterval: 100 * time.Millisecond})
+	started := time.Now()
+	_, err := manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-2"))
+	elapsed := time.Since(started)
+	if err == nil {
+		t.Fatal("expected failure once the hold budget expired")
+	}
+	if statusOf(err) != http.StatusServiceUnavailable {
+		t.Fatalf("error = %v, want the upstream 503 to be returned after the budget", err)
+	}
+	// One 1s cooldown fits in the 1.5s budget; the next one does not, so the
+	// hold ends after the first failed probe instead of idling to the deadline.
+	if elapsed < 900*time.Millisecond || elapsed > 4*time.Second {
+		t.Fatalf("hold lasted %v, want one cooldown inside the 1.5s budget", elapsed)
+	}
+	// The client's own retry of the same turn must not start a fresh budget.
+	started = time.Now()
+	_, err = manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-2"))
+	if err == nil {
+		t.Fatal("expected fast failure for the spent turn")
+	}
+	if retryElapsed := time.Since(started); retryElapsed > 700*time.Millisecond {
+		t.Fatalf("retry of the spent turn took %v, want fail-fast inside the grace window", retryElapsed)
+	}
+	// A different turn still gets its own budget.
+	started = time.Now()
+	_, _ = manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-3"))
+	if otherElapsed := time.Since(started); otherElapsed < 900*time.Millisecond {
+		t.Fatalf("a new turn returned in %v, want its own hold budget", otherElapsed)
+	}
+}
