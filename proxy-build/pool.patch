@@ -0,0 +1,42 @@
+package openai
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+// codex exec drives the orchestrator lanes and is the same client as the TUI and Desktop, so it
+// must get the response.failed terminal event and the retryable error shaping (2026-10-19: lanes
+// received a bare "error" event and an unshaped 429 and failed their turns).
+func TestIsCodexResponsesClientRequestRecognizesOfficialClients(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name       string
+		userAgent  string
+		originator string
+		want       bool
+	}{
+		{name: "codex exec user agent", userAgent: "codex_exec/0.155.1 (Windows 10.0.26200; x86_64) unknown", want: true},
+		{name: "codex exec originator", userAgent: "reqwest", originator: "codex_exec", want: true},
+		{name: "codex cli", userAgent: "codex_cli_rs/0.155.1 (Windows 10.0.26200; x86_64) WindowsTerminal", want: true},
+		{name: "codex desktop originator", originator: "Codex Desktop", want: true},
+		{name: "lookalike prefix", userAgent: "codex_executor/1.0", want: false},
+		{name: "other client", userAgent: "claude-cli/2.1.0 (external, cli)", want: false},
+	} {
+		recorder := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(recorder)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		if tc.userAgent != "" {
+			c.Request.Header.Set("User-Agent", tc.userAgent)
+		}
+		if tc.originator != "" {
+			c.Request.Header.Set("Originator", tc.originator)
+		}
+		if got := isCodexResponsesClientRequest(c); got != tc.want {
+			t.Errorf("%s: official Codex client = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
