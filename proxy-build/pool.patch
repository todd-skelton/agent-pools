+func TestClaudeSearchProvenanceMemoExpiresAndEvicts(t *testing.T) {
+	now := time.Date(2026, 10, 18, 0, 0, 0, 0, time.UTC)
+	memo := &claudeSearchProvenanceMemo{now: func() time.Time { return now }}
+	memo.remember("a", "fp")
+	if !memo.rejected("a", "fp") || memo.rejected("b", "fp") || memo.rejected("a", "other") || memo.rejected("a", "") {
+		t.Fatal("memo must be keyed by account and fingerprint")
+	}
+	now = now.Add(claudeSearchProvenanceMemoTTL - time.Minute)
+	if !memo.rejected("a", "fp") {
+		t.Fatal("entry expired early")
+	}
+	// The lookup above refreshed it; one more TTL from there it is gone.
+	now = now.Add(claudeSearchProvenanceMemoTTL + time.Minute)
+	if memo.rejected("a", "fp") {
+		t.Fatal("entry outlived its TTL")
+	}
+	for i := 0; i < claudeSearchProvenanceMemoMaxEntries+10; i++ {
+		now = now.Add(time.Second)
+		memo.remember("a", strings.Repeat("x", i+1))
+	}
+	if got := len(memo.entries); got > claudeSearchProvenanceMemoMaxEntries {
+		t.Fatalf("memo grew to %d entries, cap %d", got, claudeSearchProvenanceMemoMaxEntries)
+	}
+	if memo.rejected("a", "x") {
+		t.Fatal("oldest entry was not evicted")
+	}
+	if !memo.rejected("a", strings.Repeat("x", claudeSearchProvenanceMemoMaxEntries+10)) {
+		t.Fatal("newest entry was evicted")
+	}
+}
