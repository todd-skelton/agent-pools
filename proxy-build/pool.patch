+// OutageHoldConfig configures the provider outage hold. When enabled, a request
+// whose credential retry rounds ended on a transient upstream failure
+// (408, 5xx, 529, connection failure, or no selectable credential because of
+// such a failure) keeps its client connection open and probes again once a
+// credential for its model recovers, bounded by a budget per client turn.
+// Quota rejections (429) and other 4xx errors still fail immediately.
+type OutageHoldConfig struct {
+	Enabled bool `yaml:"enabled" json:"enabled"`
+	// MaxWaitSeconds is the hold budget per client turn. Default 600.
+	MaxWaitSeconds int `yaml:"max-wait-seconds" json:"max-wait-seconds"`
+	// ProbeIntervalSeconds is the minimum spacing between upstream probes from
+	// one held request. Default 5.
+	ProbeIntervalSeconds int `yaml:"probe-interval-seconds" json:"probe-interval-seconds"`
+	// ClientMaxWaitSeconds overrides MaxWaitSeconds by lower-case User-Agent
+	// prefix, for clients whose own request timeout would fire first.
+	ClientMaxWaitSeconds map[string]int `yaml:"client-max-wait-seconds" json:"client-max-wait-seconds"`
+}
+
+// InstalledClientsConfig names the locally installed client applications the
+// proxy imitates. Each binary is run with --version (hidden, bounded, re-read
