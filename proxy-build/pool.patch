+	input, _ := json.Marshal(map[string]any{"input": []any{map[string]any{"type": "compaction", "encrypted_content": capsule}, map[string]any{"type": "message", "role": "user", "content": "latest"}}})
+	expanded, err := ExpandPortableCheckpoints(input, ring, "caller", false)
