index 0000000000000000000000000000000000000000..5ecde3ef188dda789f177eb07b431cfd613c42cc
--- /dev/null
+++ b/internal/registry/codex_client_models_live_test.go
@@ -0,0 +1,82 @@
+package registry
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func liveTemplateFromBase(t *testing.T, slug, fromSlug string, mutate func(map[string]any)) map[string]any {
+	t.Helper()
+	var payload codexClientModelsPayload
+	if err := json.Unmarshal(GetCodexClientModelsJSON(), &payload); err != nil {
+		t.Fatal(err)
+	}
+	for _, model := range payload.Models {
+		if model["slug"] == fromSlug {
+			model["slug"] = slug
+			if mutate != nil {
+				mutate(model)
+			}
+			return model
+		}
+	}
+	t.Fatalf("base catalog has no %s", fromSlug)
+	return nil
+}
+
+func servedTemplates(t *testing.T) map[string]map[string]any {
+	t.Helper()
+	var payload codexClientModelsPayload
+	if err := json.Unmarshal(GetCodexClientModelsJSON(), &payload); err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]map[string]any{}
+	for _, model := range payload.Models {
+		out[model["slug"].(string)] = model
+	}
+	return out
+}
+
+func TestCodexClientLiveTemplatesOverlayBaseCatalog(t *testing.T) {
+	t.Cleanup(func() { SetCodexClientLiveTemplates(nil) })
+	before := GetCodexClientModelsRevision()
+	baseCount := len(servedTemplates(t))
+
+	added := liveTemplateFromBase(t, "gpt-7-test", "gpt-5.5", nil)
+	replaced := liveTemplateFromBase(t, "gpt-5.5", "gpt-5.5", func(m map[string]any) { m["description"] = "live description" })
+	invalid := map[string]any{"slug": "broken"}
+	changed, rejected := SetCodexClientLiveTemplates([]map[string]any{added, replaced, invalid})
+	if !changed || len(rejected) != 1 {
+		t.Fatalf("changed=%v rejected=%v", changed, rejected)
+	}
+	if GetCodexClientModelsRevision() == before {
+		t.Fatal("revision did not change")
+	}
+	served := servedTemplates(t)
+	if len(served) != baseCount+1 || served["gpt-7-test"] == nil || served["broken"] != nil {
+		t.Fatalf("served slugs = %d", len(served))
+	}
+	if served["gpt-5.5"]["description"] != "live description" {
+		t.Fatal("live template did not replace the base entry")
+	}
+	if err := ValidateCodexClientModelsJSON(GetCodexClientModelsJSON()); err != nil {
+		t.Fatalf("served catalog invalid: %v", err)
+	}
+	if changed, _ = SetCodexClientLiveTemplates([]map[string]any{added, replaced}); changed {
+		t.Fatal("identical overlay reported a change")
+	}
+	SetCodexClientLiveTemplates(nil)
+	if served = servedTemplates(t); len(served) != baseCount || served["gpt-7-test"] != nil {
+		t.Fatal("clearing the overlay did not restore the base catalog")
+	}
+}
+
+func TestCodexClientLiveTemplatesWithoutDefaultKeepBaseDefault(t *testing.T) {
+	t.Cleanup(func() { SetCodexClientLiveTemplates(nil) })
+	// A live list that no longer offers gpt-5.5 must not remove the default
+	// template the catalog needs for non-Codex models.
+	SetCodexClientLiveTemplates([]map[string]any{liveTemplateFromBase(t, "gpt-7-test", "gpt-5.5", nil)})
+	if servedTemplates(t)["gpt-5.5"] == nil {
+		t.Fatal("default template lost")
+	}
+}
