index 0000000000000000000000000000000000000000..d42e9551d8c63d0ab2d5a32d4703a7d9e9cd5541
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_delegation.go
@@ -0,0 +1,30 @@
+package helps
+
+import (
+	"net/http"
+
+	multiagentv2 "github.com/router-for-me/CLIProxyAPI/v7/internal/client/codex/optimize-multi-agent-v2"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+type encryptedDelegationError struct{}
+
+func (encryptedDelegationError) Error() string {
+	return `{"error":{"type":"invalid_request_error","code":"unsupported_encrypted_delegation","message":"Claude cannot read this encrypted or malformed delegated task. Reissue a fresh plaintext brief through the compatible delegation adapter."}}`
+}
+func (encryptedDelegationError) StatusCode() int       { return http.StatusBadRequest }
+func (encryptedDelegationError) IsRequestScoped() bool { return true }
+
+// ValidateClaudeDelegation runs before compaction, translation, or provider IO.
+// It is independent of optimization flags and does not expose task contents.
+func ValidateClaudeDelegation(from sdktranslator.Format, payloads ...[]byte) error {
+	if from != sdktranslator.FormatOpenAIResponse && from != sdktranslator.FormatCodex {
+		return nil
+	}
+	for _, payload := range payloads {
+		if multiagentv2.HasUnreadableCodexDelegation(payload) {
+			return encryptedDelegationError{}
+		}
+	}
+	return nil
+}
