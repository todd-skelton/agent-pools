+package multiagentv2
+
+import (
+	"context"
+	"encoding/base64"
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/tidwall/gjson"
+)
+
+func TestDelegationTransportPreservesNativeOpaqueHistory(t *testing.T) {
+	token := base64.RawURLEncoding.EncodeToString(append([]byte{0x80}, make([]byte, 88)...))
+	payload := []byte(fmt.Sprintf(`{"input":[{"type":"agent_message","author":"/root","content":[{"type":"input_text","text":"header"},{"type":"encrypted_content","encrypted_content":%q}]},{"type":"reasoning","encrypted_content":"reasoning-token"},{"type":"compaction","encrypted_content":"pool-compact-v1:fixture"}]}`, token))
+	cfg := &config.Config{Codex: config.CodexConfig{OptimizeMultiAgentV2: true}}
+	got, _ := OptimizeCodexMultiAgentV2Request(context.Background(), http.Header{"User-Agent": {"Codex Desktop/0.158.0-alpha.2"}}, payload, cfg)
+	if string(got) != string(payload) {
+		t.Fatal("native encrypted history was changed")
+	}
+}
+
+func TestDelegationTransportFollowupOnlyNamespace(t *testing.T) {
+	cfg := &config.Config{Codex: config.CodexConfig{OptimizeMultiAgentV2: true}}
+	for _, name := range []string{"followup_task", "send_message"} {
+		t.Run(name, func(t *testing.T) {
+			payload := []byte(fmt.Sprintf(`{"tools":[{"type":"namespace","name":"collaboration","tools":[{"type":"function","name":%q,"parameters":{"properties":{"message":{"type":"string","encrypted":true}}}}]}]}`, name))
+			got, renamed := OptimizeCodexMultiAgentV2Request(context.Background(), http.Header{"User-Agent": {"codex_cli_rs/0.157.1"}}, payload, cfg)
+			if !renamed || gjson.GetBytes(got, "tools.0.name").String() != "collaboration-optimize" {
+				t.Fatal("reserved namespace not remapped without spawn_agent")
+			}
+			if gjson.GetBytes(got, "tools.0.tools.0.parameters.properties.message.encrypted").Exists() {
+				t.Fatal("message encryption remains enabled")
+			}
+		})
+	}
+}
+
+func TestDelegationTransportConflictPreservesEncryptedSchema(t *testing.T) {
+	payload := []byte(`{"tools":[{"type":"namespace","name":"collaboration","tools":[{"type":"function","name":"spawn_agent","parameters":{"properties":{"message":{"encrypted":true}}}}]},{"type":"namespace","name":"collaboration-optimize","tools":[]}]}`)
+	headers := http.Header{"User-Agent": {"codex_cli_rs/0.157.1"}}
+	prepared, _ := PrepareCodexMultiAgentV2Tools(context.Background(), headers, payload, true, false)
+	if string(prepared) != string(payload) {
+		t.Fatal("conflicting namespace partially rewrote reserved schema")
+	}
+	got, renamed := OptimizeCodexMultiAgentV2Request(context.Background(), headers, prepared, &config.Config{Codex: config.CodexConfig{OptimizeMultiAgentV2: true}})
+	if renamed || string(got) != string(payload) {
+		t.Fatal("conflicting namespace was modified")
+	}
+}
