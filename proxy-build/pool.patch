+// searchHistoryBody is a Claude request whose assistant turn searched the web
+// and cited the result, as the pool replays it from a Codex history.
+func searchHistoryBody(stream bool) []byte {
+	streamValue := "false"
+	if stream {
+		streamValue = "true"
+	}
+	return []byte(`{"model":"claude-opus-5","max_tokens":64,"stream":` + streamValue + `,"messages":[` +
+		`{"role":"user","content":[{"type":"text","text":"Which permission covers environment secrets?"}]},` +
+		`{"role":"assistant","content":[` +
+		`{"type":"server_tool_use","id":"srvtoolu_1","name":"web_search","input":{"query":"environment secrets permission"}},` +
+		`{"type":"web_search_tool_result","tool_use_id":"srvtoolu_1","content":[` +
+		`{"type":"web_search_result","url":"https://docs.github.com/a","title":"A","encrypted_content":"ENC_A","page_age":null},` +
+		`{"type":"web_search_result","url":"https://docs.github.com/b","title":"B","encrypted_content":"ENC_B"}]},` +
+		`{"type":"text","text":"The Environments permission.","citations":[` +
+		`{"type":"web_search_result_location","url":"https://docs.github.com/a","title":"A","cited_text":"Environments","encrypted_index":"IDX_A"},` +
+		`{"type":"char_location","document_index":0,"document_title":"notes","cited_text":"x","start_char_index":0,"end_char_index":1}]},` +
+		`{"type":"text","text":"Only that one.","citations":[` +
+		`{"type":"web_search_result_location","url":"https://docs.github.com/b","title":"B","cited_text":"only","encrypted_index":"IDX_B"}]}]},` +
+		`{"role":"user","content":[{"type":"text","text":"Thanks."}]}]}`)
