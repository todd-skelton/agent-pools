+)
+
+// Pool build: without a proxy, management API calls use the inference-plane
+// client (fingerprinted transports with bounded connection-setup retries for
+// protected hosts). With any proxy configured, the proxy-aware transport stays.
+
+func TestAPICallClientWithoutProxyUsesInferencePlaneClient(t *testing.T) {
+	t.Parallel()
+
+	for name, h := range map[string]*Handler{
+		"nil config":   {},
+		"empty config": {cfg: &config.Config{}},
+	} {
+		for _, auth := range []*coreauth.Auth{nil, {Provider: "codex"}, {Provider: "claude", ProxyURL: "  "}} {
+			client := h.apiCallClient(auth, "")
+			if client.Timeout != defaultAPICallTimeout {
+				t.Fatalf("%s: timeout = %v, want %v", name, client.Timeout, defaultAPICallTimeout)
+			}
+			if typeName := fmt.Sprintf("%T", client.Transport); !strings.Contains(typeName, "fallbackRoundTripper") {
+				t.Fatalf("%s: transport type = %s, want the helps fallbackRoundTripper", name, typeName)
+			}
+		}
+	}
+}
+
+func TestAPICallClientKeepsProxyAwareTransportWhenAnyProxyIsSet(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name     string
+		h        *Handler
+		auth     *coreauth.Auth
+		request  string
+		wantType string
+	}{
+		{"request proxy", &Handler{cfg: &config.Config{}}, nil, "http://request-proxy.example.com:8080", "*http.Transport"},
+		{"credential proxy", &Handler{cfg: &config.Config{}}, &coreauth.Auth{ProxyURL: "http://cred-proxy.example.com:8080"}, "", "*http.Transport"},
+		{"credential direct", &Handler{cfg: &config.Config{SDKConfig: sdkconfig.SDKConfig{ProxyURL: "http://global-proxy.example.com:8080"}}}, &coreauth.Auth{ProxyURL: "direct"}, "", "*http.Transport"},
+		{"global proxy", &Handler{cfg: &config.Config{SDKConfig: sdkconfig.SDKConfig{ProxyURL: "http://global-proxy.example.com:8080"}}}, &coreauth.Auth{Provider: "codex"}, "", "*http.Transport"},
+	}
+	for _, tc := range cases {
+		client := tc.h.apiCallClient(tc.auth, tc.request)
+		if client.Timeout != defaultAPICallTimeout {
+			t.Fatalf("%s: timeout = %v, want %v", tc.name, client.Timeout, defaultAPICallTimeout)
+		}
+		if typeName := fmt.Sprintf("%T", client.Transport); typeName != tc.wantType {
+			t.Fatalf("%s: transport type = %s, want %s", tc.name, typeName, tc.wantType)
+		}
+	}
+}
+
+func TestAPICallWithoutProxyReachesPlainHTTPUpstream(t *testing.T) {
+	t.Parallel()
+
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-Probe") != "1" {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		w.WriteHeader(http.StatusAccepted)
+		_, _ = w.Write([]byte("direct"))
+	}))
+	defer upstream.Close()
+
+	h := &Handler{cfg: &config.Config{}}
+	router := gin.New()
+	router.POST("/", h.APICall)
+
+	body := `{"method":"GET","url":"` + upstream.URL + `/usage","header":{"X-Probe":"1"}}`
+	recorder := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(recorder, req)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status code = %d, want %d; body = %s", recorder.Code, http.StatusOK, recorder.Body.String())
+	}
+	var response apiCallResponse
+	if errDecode := json.NewDecoder(recorder.Body).Decode(&response); errDecode != nil {
+		t.Fatalf("decode response: %v", errDecode)
+	}
+	if response.StatusCode != http.StatusAccepted || response.Body != "direct" {
+		t.Fatalf("upstream = %d %q, want %d %q", response.StatusCode, response.Body, http.StatusAccepted, "direct")
+	}
+}
+
+func TestAPICallWithoutProxyReportsBadGatewayOnConnectionFailure(t *testing.T) {
+	t.Parallel()
+
+	// A test-owned listener that accepts and immediately closes every
+	// connection: the fallback transport gets EOF before any response.
+	listener, errListen := net.Listen("tcp", "127.0.0.1:0")
+	if errListen != nil {
+		t.Fatalf("listen: %v", errListen)
+	}
+	defer listener.Close()
+	go func() {
+		for {
+			conn, errAccept := listener.Accept()
+			if errAccept != nil {
+				return
+			}
+			_ = conn.Close()
+		}
+	}()
+
+	h := &Handler{cfg: &config.Config{}}
+	router := gin.New()
+	router.POST("/", h.APICall)
+
+	body := `{"method":"GET","url":"http://` + listener.Addr().String() + `/usage"}`
+	recorder := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/", strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	router.ServeHTTP(recorder, req)
+
+	if recorder.Code != http.StatusBadGateway {
+		t.Fatalf("status code = %d, want %d; body = %s", recorder.Code, http.StatusBadGateway, recorder.Body.String())
+	}
+}
+
+func TestAPICallWithoutProxyKeepsDirectFallbackForUnprotectedHosts(t *testing.T) {
+	t.Parallel()
+
+	// Unprotected hosts must keep the Proxy=nil transport the old code used, so
+	// HTTP_PROXY / HTTPS_PROXY in the environment are still ignored.
+	h := &Handler{cfg: &config.Config{}}
+	client := h.apiCallClient(&coreauth.Auth{Provider: "codex"}, "")
+	withFallback, ok := client.Transport.(interface{ Fallback() http.RoundTripper })
+	if !ok {
+		t.Fatalf("transport type = %T, want one exposing Fallback()", client.Transport)
+	}
+	fallback, ok := withFallback.Fallback().(*http.Transport)
+	if !ok {
+		t.Fatalf("fallback type = %T, want *http.Transport", withFallback.Fallback())
+	}
+	if fallback.Proxy != nil {
+		t.Fatal("fallback transport must not consult environment proxies")
+	}
+	if fallback == http.DefaultTransport {
+		t.Fatal("fallback must be a private clone, not the shared default transport")
+	}
+}
