+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+)
+
+// imageToolExecutor stands in for the Codex executor and records what the
+// images endpoint was asked to run.
+type imageToolExecutor struct {
+	mu     sync.Mutex
+	models []string
+	auths  []string
+}
+
+func (e *imageToolExecutor) Identifier() string { return "codex" }
+
+func (e *imageToolExecutor) Execute(_ context.Context, auth *coreauth.Auth, req coreexecutor.Request, _ coreexecutor.Options) (coreexecutor.Response, error) {
+	e.mu.Lock()
+	e.models = append(e.models, req.Model)
+	e.auths = append(e.auths, auth.ID)
+	e.mu.Unlock()
+	return coreexecutor.Response{Payload: []byte(`{"created":1,"data":[{"b64_json":"AA=="}]}`)}, nil
+}
+
+func (e *imageToolExecutor) ExecuteStream(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	return nil, errors.New("not implemented")
+}
+
+func (e *imageToolExecutor) Refresh(_ context.Context, auth *coreauth.Auth) (*coreauth.Auth, error) {
+	return auth, nil
+}
+
+func (e *imageToolExecutor) CountTokens(context.Context, *coreauth.Auth, coreexecutor.Request, coreexecutor.Options) (coreexecutor.Response, error) {
+	return coreexecutor.Response{}, errors.New("not implemented")
+}
+
+func (e *imageToolExecutor) HttpRequest(context.Context, *coreauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, errors.New("not implemented")
+}
+
+// Image models are not on any Codex credential's model list (the lists are
+// the accounts' live chat models), so the images endpoint must route them to
+// the provider's account credentials and pass the name through instead of
+// rejecting it.
+func TestImagesToolRouteRunsUnlistedModelOnAccountCredentials(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	executor := &imageToolExecutor{}
+	manager := coreauth.NewManager(nil, nil, nil)
+	manager.RegisterExecutor(executor)
+
+	account := &coreauth.Auth{ID: "images-tool-account", Provider: "codex", Status: coreauth.StatusActive,
+		Metadata: map[string]any{"access_token": "token", "refresh_token": "refresh", "type": "codex"}}
+	apiKey := &coreauth.Auth{ID: "images-tool-apikey", Provider: "codex", Status: coreauth.StatusActive,
+		Attributes: map[string]string{"api_key": "sk-test"}}
+	for _, auth := range []*coreauth.Auth{account, apiKey} {
+		if _, err := manager.Register(context.Background(), auth); err != nil {
+			t.Fatalf("Register %s: %v", auth.ID, err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: "gpt-5.5"}})
+	}
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient(account.ID)
+		registry.GetGlobalRegistry().UnregisterClient(apiKey.ID)
+	})
+
+	h := NewOpenAIAPIHandler(handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager))
+	requests := []struct {
+		path, body, model string
+		handler           gin.HandlerFunc
+	}{
+		{imagesGenerationsPath, `{"model":"gpt-image-3","prompt":"a red dot"}`, "gpt-image-3", h.ImagesGenerations},
+		{imagesGenerationsPath, `{"prompt":"a red dot"}`, defaultImagesToolModel, h.ImagesGenerations},
+		{imagesEditsPath, `{"model":"gpt-image-2","prompt":"make it blue","images":[{"image_url":"data:image/png;base64,AA=="}]}`, "gpt-image-2", h.ImagesEdits},
+	}
+	for _, request := range requests {
+		for i := 0; i < 3; i++ {
+			resp := performImagesEndpointRequest(t, request.path, "application/json", strings.NewReader(request.body), request.handler)
+			if resp.Code != http.StatusOK {
+				t.Fatalf("%s %s: status = %d, want 200: %s", request.path, request.body, resp.Code, resp.Body.String())
+			}
+		}
+	}
+
+	executor.mu.Lock()
+	defer executor.mu.Unlock()
+	if len(executor.models) != 9 {
+		t.Fatalf("executor calls = %d, want 9", len(executor.models))
+	}
+	for i, model := range executor.models {
+		if want := requests[i/3].model; model != want {
+			t.Fatalf("call %d model = %q, want %q", i, model, want)
+		}
+		if executor.auths[i] != account.ID {
+			t.Fatalf("call %d ran on %s, want the account credential %s", i, executor.auths[i], account.ID)
+		}
+	}
+}
