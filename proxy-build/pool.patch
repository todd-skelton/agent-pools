+func TestOutageHoldEndsWhenPoolIsHealthyForOthers(t *testing.T) {
+	executor := &outageExecutor{identifier: holdTestProvider, status: http.StatusInternalServerError}
+	executor.failIf = func(req cliproxyexecutor.Request) bool { return string(req.Payload) == "poison" }
+	manager := setupOutagePool(t, 1, executor, OutageHoldConfig{Enabled: true, MaxWait: 30 * time.Second, ProbeInterval: 100 * time.Millisecond})
+	// Healthy traffic from another client while the poison request is held.
+	stop := make(chan struct{})
+	defer close(stop)
+	go func() {
+		ticker := time.NewTicker(150 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-stop:
+				return
+			case <-ticker.C:
+				_, _ = manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel, Payload: []byte("fine")}, holdOptions("other"))
+			}
+		}
+	}()
+	started := time.Now()
+	_, err := manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel, Payload: []byte("poison")}, holdOptions("turn-p"))
+	elapsed := time.Since(started)
+	if err == nil {
+		t.Fatal("poison request must fail")
+	}
+	if statusOf(err) != http.StatusInternalServerError {
+		t.Fatalf("error = %v, want the request's own 500", err)
+	}
+	if elapsed > 5*time.Second {
+		t.Fatalf("poison request held for %v while the pool served others; want it released after one probe", elapsed)
+	}
+}
