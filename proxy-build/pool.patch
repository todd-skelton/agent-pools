index 0000000000000000000000000000000000000000..c86f014340b81b7145741404119a5adca819d224
--- /dev/null
+++ b/internal/runtime/executor/claude_delegation_transport_test.go
@@ -0,0 +1,64 @@
+package executor
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+func TestClaudeDelegationTransportRejectsOpaqueBeforeIO(t *testing.T) {
+	token := base64.RawURLEncoding.EncodeToString(append([]byte{0x80}, make([]byte, 88)...))
+	opaque := []byte(fmt.Sprintf(`{"model":"claude-opus-5-5","input":[{"type":"agent_message","content":[{"type":"input_text","text":"readable header"},{"type":"encrypted_content","encrypted_content":%q}]}]}`, token))
+	plain := []byte(`{"model":"claude-opus-5-5","input":[{"type":"message","role":"user","content":"hello"}]}`)
+	for _, enabled := range []bool{false, true} {
+		for _, mode := range []string{"execute", "stream", "count"} {
+			for _, originalOnly := range []bool{false, true} {
+				t.Run(fmt.Sprintf("enabled=%t/%s/original=%t", enabled, mode, originalOnly), func(t *testing.T) {
+					called := false
+					transport := roundTripperFunc(func(*http.Request) (*http.Response, error) {
+						called = true
+						return nil, errors.New("unexpected upstream request")
+					})
+					ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(transport))
+					auth := &cliproxyauth.Auth{Provider: "claude", Attributes: map[string]string{"api_key": "fixture"}}
+					req := cliproxyexecutor.Request{Model: "claude-opus-5-5", Payload: opaque}
+					opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse}
+					if originalOnly {
+						req.Payload = plain
+						opts.OriginalRequest = opaque
+					}
+					e := NewClaudeExecutor(&config.Config{Codex: config.CodexConfig{OptimizeMultiAgentV2: enabled}})
+					var err error
+					switch mode {
+					case "execute":
+						_, err = e.Execute(ctx, auth, req, opts)
+					case "stream":
+						_, err = e.ExecuteStream(ctx, auth, req, opts)
+					case "count":
+						_, err = e.CountTokens(ctx, auth, req, opts)
+					}
+					if called {
+						t.Fatal("opaque delegation reached upstream")
+					}
+					var status interface{ StatusCode() int }
+					var scoped cliproxyexecutor.RequestScopedError
+					if err == nil || !errors.As(err, &status) || status.StatusCode() != 400 || !errors.As(err, &scoped) || !scoped.IsRequestScoped() {
+						t.Fatalf("want request-scoped HTTP 400, got %T %v", err, err)
+					}
+					if !strings.Contains(err.Error(), "unsupported_encrypted_delegation") || strings.Contains(err.Error(), token) {
+						t.Fatal("missing safe machine-readable error")
+					}
+				})
+			}
+		}
+	}
+}
