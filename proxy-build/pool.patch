diff --git a/internal/livemodels/livemodels.go b/internal/livemodels/livemodels.go
new file mode 100644
index 0000000000000000000000000000000000000000..d788e3b807acbdc6e73df85e17d9b125fb195fef
--- /dev/null
+++ b/internal/livemodels/livemodels.go
@@ -0,0 +1,82 @@
+// Package livemodels publishes the state of the per-credential live model
+// lists (see sdk/cliproxy live_models.go) to the management API: which
+// credentials route on a live list, when it was read, and why the last read
+// failed. The lists themselves stay with the service that registers them.
+package livemodels
+
+import (
+	"sync"
+	"time"
+)
+
+const (
+	// SourceLive means the credential's models come from its own live list.
+	SourceLive = "live"
+	// SourcePending means no live list has been read yet; the credential
+	// serves no models until one is.
+	SourcePending = "pending"
+)
+
+// Status describes one credential's model list.
+type Status struct {
+	Source string `json:"source"`
+	// FetchedAt is when the registered live list was read.
+	FetchedAt time.Time `json:"fetched_at,omitempty"`
+	// CheckedAt is the last read attempt.
+	CheckedAt time.Time `json:"checked_at,omitempty"`
+	Models    int       `json:"models"`
+	// Error is the last attempt's failure; a previous live list stays registered.
+	Error string `json:"error,omitempty"`
+}
+
+var (
+	mu       sync.RWMutex
+	statuses = map[string]Status{}
+	refresh  func() bool
+)
+
+// Publish records the status of a credential.
+func Publish(authID string, status Status) {
+	mu.Lock()
+	statuses[authID] = status
+	mu.Unlock()
+}
+
+// Forget drops a credential's status.
+func Forget(authID string) {
+	mu.Lock()
+	delete(statuses, authID)
+	mu.Unlock()
+}
+
+// Clear drops every status (live models disabled).
+func Clear() {
+	mu.Lock()
+	statuses = map[string]Status{}
+	mu.Unlock()
+}
+
+// Lookup returns a credential's status.
+func Lookup(authID string) (Status, bool) {
+	mu.RLock()
+	defer mu.RUnlock()
+	status, ok := statuses[authID]
+	return status, ok
+}
+
+// SetRefreshHandler installs the function that starts an immediate read of
+// every credential's list; nil removes it.
+func SetRefreshHandler(fn func() bool) {
+	mu.Lock()
+	refresh = fn
+	mu.Unlock()
+}
+
+// Refresh asks for an immediate read of every list. It reports false when live
+// model lists are not running.
+func Refresh() bool {
+	mu.RLock()
+	fn := refresh
+	mu.RUnlock()
+	return fn != nil && fn()
+}
