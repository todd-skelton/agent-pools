+func TestPortableNativeWebsocketPreservesPendingToolResult(t *testing.T) {
+	cfg := portableTestConfig(t)
+	upgrader := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		_, body, err := conn.ReadMessage()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		valid := gjson.GetBytes(body, "previous_response_id").String() == "resp-pending" && gjson.GetBytes(body, "input.0.type").String() == "function_call_output" && gjson.GetBytes(body, "input.0.call_id").String() == "call-pending" && gjson.GetBytes(body, "input.0.output").String() == "ALPHA"
+		if !valid {
+			t.Errorf("pending tool continuation invalid: %s", body)
+			_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"error","status":400,"error":{"message":"missing typed tool output"}}`))
+			return
+		}
+		if gjson.GetBytes(body, "max_output_tokens").Exists() || gjson.GetBytes(body, "tools.#").Int() != 0 {
+			t.Error("unsupported fields or enabled tools")
+		}
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.completed","response":{"id":"resp-upstream","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ALPHA pending test preserved"}]}]}}`))
+	}))
+	defer server.Close()
+	auth := &coreauth.Auth{ID: "fixture", Provider: "codex", Attributes: map[string]string{"api_key": "test", "base_url": server.URL, "websockets": "true"}}
+	req := coreexecutor.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","previous_response_id":"resp-pending","input":[{"type":"function_call_output","call_id":"call-pending","output":"ALPHA"},{"type":"compaction_trigger"}]}`)}
+	ctx, cancel := context.WithTimeout(coreexecutor.WithDownstreamWebsocket(context.Background()), 10*time.Second)
+	defer cancel()
+	response, err := NewCodexAutoExecutor(cfg).Execute(ctx, auth, req, portableTestOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(gjson.GetBytes(response.Payload, "output.0.encrypted_content").String(), helps.PortableCompactionPrefix) {
+		t.Fatal("missing checkpoint")
+	}
