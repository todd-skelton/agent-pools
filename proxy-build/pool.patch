diff --git a/sdk/api/handlers/openai/openai_responses_runtime_identity.go b/sdk/api/handlers/openai/openai_responses_runtime_identity.go
new file mode 100644
index 0000000000000000000000000000000000000000..7cf65fb852e4a40682588d9459d99a694d3f1f01
--- /dev/null
+++ b/sdk/api/handlers/openai/openai_responses_runtime_identity.go
@@ -0,0 +1,148 @@
+package openai
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// codexRuntimeIdentityHeading opens the section appended to the caller's
+// instructions.
+const codexRuntimeIdentityHeading = "# Runtime identity"
+
+// codexRuntimeIdentityLead follows the heading. Together they form the
+// idempotency marker; a bare mention of the heading inside a base prompt
+// (the pool's own instructions file refers to it) must not suppress injection.
+const codexRuntimeIdentityLead = "This request was routed through the account pool for model `"
+
+const codexRuntimeIdentityMarker = codexRuntimeIdentityHeading + "\n\n" + codexRuntimeIdentityLead
+
+// codexRuntimeIdentityMaxLen bounds the model and effort strings copied into
+// the prompt; both are client supplied.
+const codexRuntimeIdentityMaxLen = 64
+
+// prepareCodexRuntimeIdentity appends the requested model and reasoning effort
+// to the base prompt of a /v1/responses request when the pool config enables
+// it. The values are what the client asked the pool for, not an attestation of
+// what the upstream served; the session log stays the audit record.
+func (h *OpenAIResponsesAPIHandler) prepareCodexRuntimeIdentity(payload []byte) []byte {
+	if h == nil || h.Cfg == nil || !h.Cfg.CodexInjectRuntimeIdentity {
+		return payload
+	}
+	return injectCodexRuntimeIdentity(payload)
+}
+
+// injectCodexRuntimeIdentity returns payload with a runtime identity section
+// appended to the base prompt. Codex carries that prompt in `instructions` for
+// some models and as the first developer message of `input` for others, so the
+// non-empty `instructions` string wins and the first developer or system
+// message with text content is the fallback. Requests with neither (compaction,
+// bare API callers), requests whose target already carries the section, and
+// requests whose model fails the character allowlist are returned unchanged.
+func injectCodexRuntimeIdentity(payload []byte) []byte {
+	model, ok := codexRuntimeIdentityValue(gjson.GetBytes(payload, "model").String())
+	if !ok {
+		return payload
+	}
+	section := codexRuntimeIdentitySection(model, gjson.GetBytes(payload, "reasoning.effort").String())
+
+	if instructions := gjson.GetBytes(payload, "instructions"); instructions.Type == gjson.String && strings.TrimSpace(instructions.String()) != "" {
+		return appendCodexRuntimeIdentityText(payload, "instructions", instructions.String(), section)
+	}
+
+	input := gjson.GetBytes(payload, "input")
+	if !input.IsArray() {
+		return payload
+	}
+	items := input.Array()
+	for index, item := range items {
+		if item.Get("type").String() != "message" || !isResponsesDeveloperRole(item.Get("role").String()) {
+			continue
+		}
+		content := item.Get("content")
+		if content.Type == gjson.String {
+			if strings.TrimSpace(content.String()) == "" {
+				continue
+			}
+			return appendCodexRuntimeIdentityText(payload, "input."+itoa(index)+".content", content.String(), section)
+		}
+		if !content.IsArray() {
+			continue
+		}
+		parts := content.Array()
+		for partIndex := len(parts) - 1; partIndex >= 0; partIndex-- {
+			part := parts[partIndex]
+			if part.Get("type").String() != "input_text" {
+				continue
+			}
+			text := part.Get("text").String()
+			if strings.TrimSpace(text) == "" {
+				continue
+			}
+			return appendCodexRuntimeIdentityText(payload, "input."+itoa(index)+".content."+itoa(partIndex)+".text", text, section)
+		}
+	}
+	return payload
+}
+
+func isResponsesDeveloperRole(role string) bool {
+	switch strings.ToLower(strings.TrimSpace(role)) {
+	case "developer", "system":
+		return true
+	}
+	return false
+}
+
+func itoa(value int) string {
+	return strconv.Itoa(value)
+}
+
+// appendCodexRuntimeIdentityText appends section to the text at path unless
+// that text already carries the marker.
+func appendCodexRuntimeIdentityText(payload []byte, path, existing, section string) []byte {
+	if strings.Contains(existing, codexRuntimeIdentityMarker) {
+		return payload
+	}
+	updated, err := sjson.SetBytes(payload, path, existing+"\n\n"+section)
+	if err != nil {
+		return payload
+	}
+	return updated
+}
+
+// codexRuntimeIdentitySection renders the appended text. effort is omitted
+// when the request carries none or the value fails the allowlist.
+func codexRuntimeIdentitySection(model, rawEffort string) string {
+	var b strings.Builder
+	b.WriteString(codexRuntimeIdentityMarker)
+	b.WriteString(model)
+	b.WriteString("`")
+	if effort, ok := codexRuntimeIdentityValue(rawEffort); ok {
+		b.WriteString(" at reasoning effort `")
+		b.WriteString(effort)
+		b.WriteString("`")
+	}
+	b.WriteString(". When asked what model you are, report exactly these values; the session log is the audit record.")
+	return b.String()
+}
+
+// codexRuntimeIdentityValue trims a client-supplied identifier and accepts it
+// only when it is short and made of identifier characters, so nothing else
+// from the request body can reach the prompt through this path.
+func codexRuntimeIdentityValue(raw string) (string, bool) {
+	value := strings.TrimSpace(raw)
+	if value == "" || len(value) > codexRuntimeIdentityMaxLen {
+		return "", false
+	}
+	for _, r := range value {
+		switch {
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9':
+		case r == '-', r == '_', r == '.', r == '/', r == ':', r == '(', r == ')', r == '+':
+		default:
+			return "", false
+		}
+	}
+	return value, true
+}
\ No newline at end of file
