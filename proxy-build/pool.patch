+package helps
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+)
+
+type recordingRoundTripper struct{ hosts []string }
+
+func (r *recordingRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	r.hosts = append(r.hosts, req.URL.Host)
+	return &http.Response{StatusCode: http.StatusNoContent, Body: http.NoBody, Request: req}, nil
+}
+
+func TestNewProtectedHostRoundTripperRoutesOnlyUnprotectedHostsToFallback(t *testing.T) {
+	t.Parallel()
+	fallback := &recordingRoundTripper{}
+	rt := NewProtectedHostRoundTripper("", fallback)
+	if got := rt.(interface{ Fallback() http.RoundTripper }).Fallback(); got != fallback {
+		t.Fatalf("Fallback() = %T, want the supplied transport", got)
+	}
+	req, _ := http.NewRequest(http.MethodGet, "http://plain.example.test/usage", nil)
+	if _, err := rt.RoundTrip(req); err != nil {
+		t.Fatalf("unprotected host: %v", err)
+	}
+	if len(fallback.hosts) != 1 || fallback.hosts[0] != "plain.example.test" {
+		t.Fatalf("fallback hosts = %v, want [plain.example.test]", fallback.hosts)
+	}
+	// Protected hosts never reach the fallback (the dial below fails fast on a
+	// cancelled context; only the routing decision is under test).
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	for _, target := range []string{"https://chatgpt.com/backend-api/wham/usage", "https://api.anthropic.com/api/oauth/usage"} {
+		u, _ := url.Parse(target)
+		req := (&http.Request{Method: http.MethodGet, URL: u, Header: http.Header{}, Host: u.Host}).WithContext(ctx)
+		_, _ = rt.RoundTrip(req)
+	}
+	if len(fallback.hosts) != 1 {
+		t.Fatalf("protected hosts reached the fallback: %v", fallback.hosts)
+	}
+	if NewProtectedHostRoundTripper("", nil).(interface{ Fallback() http.RoundTripper }).Fallback() != http.DefaultTransport {
+		t.Fatal("nil fallback should default to http.DefaultTransport")
+	}
+}
+
+// A peer that accepts TCP and never answers the ClientHello must not hold the
+// Anthropic dial open indefinitely once the caller has given up.
+func TestClaudeCodeTLSSetupIsBounded(t *testing.T) {
+	t.Parallel()
+	listener, errListen := net.Listen("tcp", "127.0.0.1:0")
+	if errListen != nil {
+		t.Fatalf("listen: %v", errListen)
+	}
+	defer listener.Close()
+	go func() {
+		for {
+			conn, errAccept := listener.Accept()
+			if errAccept != nil {
+				return
+			}
+			defer conn.Close() // hold the socket open, never write
+		}
+	}()
+	transport := newClaudeCodeRoundTripper("").(*http.Transport)
+	// Detached context, as http.Transport hands the dial: only the in-callback
+	// bound can end this.
+	started := time.Now()
+	done := make(chan error, 1)
+	go func() {
+		_, err := transport.DialTLSContext(context.Background(), "tcp", listener.Addr().String())
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("expected the handshake to fail")
+		}
+		if elapsed := time.Since(started); elapsed > claudeCodeTLSSetupTimeout+5*time.Second {
+			t.Fatalf("setup took %v, want about %v", elapsed, claudeCodeTLSSetupTimeout)
+		}
+		if !strings.Contains(err.Error(), "handshake") && !strings.Contains(err.Error(), "deadline") {
+			t.Fatalf("unexpected error: %v", err)
+		}
+	case <-time.After(claudeCodeTLSSetupTimeout + 10*time.Second):
+		t.Fatal("dial+handshake did not end after the setup bound")
+	}
+}
