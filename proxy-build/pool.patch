--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_overloaded_status_test.go
@@ -0,0 +1,55 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+// Anthropic reports an overloaded model as HTTP 529. It must enter the same
+// transient cooldown and credential retry round as a 503 so a pick failure
+// during that cooldown waits for the credential instead of failing fast.
+func TestAnthropicOverloadedStatusIsTransient(t *testing.T) {
+	if !isCredentialRetryRoundStatus(anthropicOverloadedStatus) {
+		t.Fatal("529 must be a credential retry-round status")
+	}
+	if !credentialRetryRoundStateEligible(&Error{HTTPStatus: anthropicOverloadedStatus}, false) {
+		t.Fatal("a credential whose last error is 529 must be eligible for the retry round")
+	}
+	const provider = "overloaded-status-test"
+	const model = "overloaded-status-model"
+	prevTransient := transientErrorCooldownSeconds.Load()
+	transientErrorCooldownSeconds.Store(10)
+	t.Cleanup(func() { transientErrorCooldownSeconds.Store(prevTransient) })
+	manager := NewManager(nil, nil, nil)
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient("overloaded-auth", provider, []*registry.ModelInfo{{ID: model}})
+	t.Cleanup(func() { reg.UnregisterClient("overloaded-auth") })
+	if _, err := manager.Register(context.Background(), &Auth{ID: "overloaded-auth", Provider: provider, Status: StatusActive}); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+	manager.MarkResult(context.Background(), Result{AuthID: "overloaded-auth", Provider: provider, Model: model, Success: false, Error: &Error{HTTPStatus: anthropicOverloadedStatus, Message: `{"type":"error","error":{"type":"overloaded_error","message":"Overloaded"}}`}})
+	updated, ok := manager.GetByID("overloaded-auth")
+	if !ok {
+		t.Fatal("auth missing")
+	}
+	blocked, _, next := isAuthBlockedForModel(updated, model, time.Now())
+	if !blocked || next.IsZero() {
+		t.Fatalf("529 should place the model in a timed transient block, blocked=%v next=%v", blocked, next)
+	}
+	if until := time.Until(next); until > 11*time.Second || until < 5*time.Second {
+		t.Fatalf("transient block of %v, want about the 10s transient cooldown", until)
+	}
+	if updated.Quota.Exceeded {
+		t.Fatal("529 must not be recorded as a quota rejection")
+	}
+	if status := statusCodeFromResult(updated.LastError); status != anthropicOverloadedStatus {
+		t.Fatalf("last error status = %d", status)
+	}
+	if http.StatusText(anthropicOverloadedStatus) != "" {
+		t.Logf("note: Go maps 529 to %q", http.StatusText(anthropicOverloadedStatus))
+	}
+}
diff --git a/sdk/cliproxy/auth/conductor_pick_failure_retry_round_test.go b/sdk/cliproxy/auth/conductor_pick_failure_retry_round_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..59d72fbb439ab6c529cb8b8490fdaef56110107a
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_pick_failure_retry_round_test.go
@@ -0,0 +1,200 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+// pickFailureExecutor succeeds on every call and records which credential was used.
+type pickFailureExecutor struct {
+	identifier string
+	mu         sync.Mutex
+	executeIDs []string
+	streamIDs  []string
+}
+
+func (e *pickFailureExecutor) Identifier() string { return e.identifier }
+
+func (e *pickFailureExecutor) Execute(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.mu.Lock()
+	e.executeIDs = append(e.executeIDs, auth.ID)
+	e.mu.Unlock()
+	return cliproxyexecutor.Response{Payload: []byte("ok")}, nil
+}
+
+func (e *pickFailureExecutor) ExecuteStream(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	e.mu.Lock()
+	e.streamIDs = append(e.streamIDs, auth.ID)
+	e.mu.Unlock()
+	chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("ok")}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func (*pickFailureExecutor) Refresh(_ context.Context, auth *Auth) (*Auth, error) { return auth, nil }
+
+func (e *pickFailureExecutor) CountTokens(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	return e.Execute(context.Background(), auth, cliproxyexecutor.Request{}, cliproxyexecutor.Options{})
+}
+
+func (*pickFailureExecutor) HttpRequest(context.Context, *Auth, *http.Request) (*http.Response, error) {
+	return nil, nil
+}
+
+func (e *pickFailureExecutor) calls(kind string) []string {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if kind == "stream" {
+		return append([]string(nil), e.streamIDs...)
+	}
+	return append([]string(nil), e.executeIDs...)
+}
+
+// setupPickFailurePool reproduces the 2026-09-16 pool incident: one credential
+// is at its weekly quota and the only other credential has just returned an
+// upstream 503, which places it in the short transient cooldown. A request that
+// arrives during that cooldown finds no selectable credential.
+func setupPickFailurePool(t *testing.T, cooldownSeconds int64, maxWait time.Duration) (*Manager, *pickFailureExecutor) {
+	t.Helper()
+	const provider = "pick-failure-test"
+	const model = "pick-failure-model"
+
+	prevTransient := transientErrorCooldownSeconds.Load()
+	transientErrorCooldownSeconds.Store(cooldownSeconds)
+	t.Cleanup(func() { transientErrorCooldownSeconds.Store(prevTransient) })
+
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(1, maxWait, 3)
+	executor := &pickFailureExecutor{identifier: provider}
+	manager.RegisterExecutor(executor)
+
+	reg := registry.GetGlobalRegistry()
+	now := time.Now()
+	quotaAuth := &Auth{ID: "pick-failure-quota", Provider: provider, Status: StatusActive}
+	quotaAuth.Quota.Exceeded = true
+	quotaAuth.Quota.Reason = "quota"
+	quotaAuth.Quota.NextRecoverAt = now.Add(64 * time.Hour)
+	quotaAuth.NextRetryAfter = quotaAuth.Quota.NextRecoverAt
+	recoveringAuth := &Auth{ID: "pick-failure-recovering", Provider: provider, Status: StatusActive}
+	for _, auth := range []*Auth{quotaAuth, recoveringAuth} {
+		reg.RegisterClient(auth.ID, provider, []*registry.ModelInfo{{ID: model}})
+		id := auth.ID
+		t.Cleanup(func() { reg.UnregisterClient(id) })
+		if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+			t.Fatalf("register %s: %v", auth.ID, errRegister)
+		}
+	}
+
+	manager.MarkResult(context.Background(), Result{
+		AuthID:   recoveringAuth.ID,
+		Provider: provider,
+		Model:    model,
+		Success:  false,
+		Error: &Error{
+			HTTPStatus: http.StatusServiceUnavailable,
+			Message:    "upstream connect error or disconnect/reset before headers. retried and the latest reset reason: connection timeout",
+		},
+	})
+	updated, ok := manager.GetByID(recoveringAuth.ID)
+	if !ok || updated == nil {
+		t.Fatal("recovering auth missing after MarkResult")
+	}
+	if blocked, _, next := isAuthBlockedForModel(updated, model, time.Now()); !blocked || next.IsZero() {
+		t.Fatalf("recovering auth should be in a timed transient block, blocked=%v next=%v", blocked, next)
+	}
+	return manager, executor
+}
+
+func TestPickFailureDuringTransientCooldownWaitsForRecovery(t *testing.T) {
+	const provider = "pick-failure-test"
+	const model = "pick-failure-model"
+	for _, test := range []struct {
+		name   string
+		kind   string
+		invoke func(*Manager) error
+	}{
+		{name: "stream", kind: "stream", invoke: func(m *Manager) error {
+			_, err := m.ExecuteStream(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{Stream: true})
+			return err
+		}},
+		{name: "non-stream", kind: "execute", invoke: func(m *Manager) error {
+			_, err := m.Execute(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{})
+			return err
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			manager, executor := setupPickFailurePool(t, 1, 15*time.Second)
+			started := time.Now()
+			if err := test.invoke(manager); err != nil {
+				t.Fatalf("request during transient cooldown failed: %v", err)
+			}
+			elapsed := time.Since(started)
+			if elapsed < 500*time.Millisecond {
+				t.Fatalf("request returned in %v, expected it to wait for the ~1s transient cooldown", elapsed)
+			}
+			calls := executor.calls(test.kind)
+			if len(calls) != 1 || calls[0] != "pick-failure-recovering" {
+				t.Fatalf("executor calls = %v, want exactly one call on the recovering credential", calls)
+			}
+		})
+	}
+}
+
+func TestPickFailureDuringTransientCooldownFailsFastBeyondMaxRetryInterval(t *testing.T) {
+	manager, executor := setupPickFailurePool(t, 30, 2*time.Second)
+	started := time.Now()
+	_, err := manager.ExecuteStream(context.Background(), []string{"pick-failure-test"}, cliproxyexecutor.Request{Model: "pick-failure-model"}, cliproxyexecutor.Options{Stream: true})
+	if err == nil {
+		t.Fatal("expected auth_unavailable when the only recovering credential is out of reach")
+	}
+	if !isAuthUnavailableError(err) {
+		t.Fatalf("error = %v, want auth_unavailable", err)
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("request took %v, expected an immediate failure when the cooldown exceeds max-retry-interval", elapsed)
+	}
+	if calls := executor.calls("stream"); len(calls) != 0 {
+		t.Fatalf("executor calls = %v, want none", calls)
+	}
+}
+
+func TestPickFailureWithOnlyUnauthorizedCredentialsDoesNotWait(t *testing.T) {
+	const provider = "pick-failure-test"
+	const model = "pick-failure-model"
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(1, 15*time.Second, 3)
+	executor := &pickFailureExecutor{identifier: provider}
+	manager.RegisterExecutor(executor)
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient("pick-failure-unauthorized", provider, []*registry.ModelInfo{{ID: model}})
+	t.Cleanup(func() { reg.UnregisterClient("pick-failure-unauthorized") })
+	if _, err := manager.Register(context.Background(), &Auth{ID: "pick-failure-unauthorized", Provider: provider, Status: StatusActive}); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+	manager.MarkResult(context.Background(), Result{
+		AuthID:   "pick-failure-unauthorized",
+		Provider: provider,
+		Model:    model,
+		Success:  false,
+		Error:    &Error{HTTPStatus: http.StatusUnauthorized, Message: "token revoked"},
+	})
+
+	started := time.Now()
+	_, err := manager.ExecuteStream(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: model}, cliproxyexecutor.Options{Stream: true})
+	if err == nil {
+		t.Fatal("expected failure when the only credential is unauthorized")
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("request took %v; a 401 block is not a retry-round condition and must not wait", elapsed)
+	}
+	if calls := executor.calls("stream"); len(calls) != 0 {
+		t.Fatalf("executor calls = %v, want none", calls)
+	}
+}
