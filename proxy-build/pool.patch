diff --git a/sdk/cliproxy/auth/quota_recovery.go b/sdk/cliproxy/auth/quota_recovery.go
new file mode 100644
index 0000000000000000000000000000000000000000..04b13be92e8076e1786854addac99a07886e2c02
--- /dev/null
+++ b/sdk/cliproxy/auth/quota_recovery.go
@@ -0,0 +1,158 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+var ErrQuotaRecoveryConflict = errors.New("routing changed; obtain a fresh status pull")
+
+type RoutingEligibility struct {
+	Status         string    `json:"status"`
+	NextRetryAfter time.Time `json:"next_retry_after,omitempty"`
+}
+
+type RoutingObservation struct {
+	Generation string                        `json:"generation"`
+	CheckedAt  time.Time                     `json:"checked_at"`
+	Status     string                        `json:"status"`
+	Models     map[string]RoutingEligibility `json:"models"`
+	// Unlisted holds blocked per-model states for names the credential does
+	// not route (tool routes such as images, or models that left its live
+	// list), so quota recovery still sees them without presenting them as
+	// available models.
+	Unlisted     map[string]RoutingEligibility `json:"unlisted,omitempty"`
+	QuotaBlocked bool                          `json:"quota_blocked"`
+}
+
+// RoutingObservationForAuth reads a cloned auth snapshot. It uses the same
+// eligibility predicate as selection and does not infer blocks from disk files.
+func RoutingObservationForAuth(auth *Auth, now time.Time) RoutingObservation {
+	out := RoutingObservation{CheckedAt: now, Status: "unknown", Models: map[string]RoutingEligibility{}}
+	if auth == nil {
+		return out
+	}
+	out.Generation = strconv.FormatUint(auth.Generation, 10)
+	blocked, _, _ := isAuthBlockedForModel(auth, "", now)
+	out.Status = "ready"
+	if blocked {
+		out.Status = "blocked"
+	}
+	if auth.Disabled || auth.Status == StatusDisabled {
+		out.Status = "disabled"
+	}
+	out.QuotaBlocked = auth.Quota.Exceeded && (auth.Quota.Reason == "quota" || auth.Quota.Reason == "credential_quota")
+	eligibility := func(model string) RoutingEligibility {
+		blocked, _, next := isAuthBlockedForModel(auth, model, now)
+		status := "ready"
+		if blocked {
+			status = "blocked"
+		}
+		if out.Status == "disabled" {
+			status = "disabled"
+		}
+		return RoutingEligibility{Status: status, NextRetryAfter: next}
+	}
+	registered := map[string]bool{}
+	for _, model := range dedupeStrings(modelsForRegisteredAuth(auth.ID)) {
+		registered[model] = true
+		out.Models[model] = eligibility(model)
+	}
+	for model := range auth.ModelStates {
+		if registered[canonicalModelKey(model)] {
+			continue
+		}
+		if e := eligibility(model); e.Status == "blocked" {
+			if out.Unlisted == nil {
+				out.Unlisted = map[string]RoutingEligibility{}
+			}
+			out.Unlisted[model] = e
+		}
+	}
+	for _, state := range auth.ModelStates {
+		if state != nil && state.Quota.Exceeded && (state.Quota.Reason == "quota" || state.Quota.Reason == "credential_quota") {
+			out.QuotaBlocked = true
+		}
+	}
+	return out
+}
+
+func oldQuotaFailure(quota QuotaState, lastError *Error, updated, cutoff time.Time) bool {
+	return quota.Exceeded && (quota.Reason == "quota" || quota.Reason == "credential_quota") &&
+		!updated.IsZero() && !updated.After(cutoff) && (lastError == nil || lastError.HTTPStatus == 429)
+}
+
+// RecoverQuota clears quota-derived failures only. Generation checking and
+// mutation share the manager lock, so concurrent results cannot be erased.
+func (m *Manager) RecoverQuota(ctx context.Context, authID string, generation uint64, cutoff time.Time) (*Auth, bool, error) {
+	now := time.Now()
+	if cutoff.IsZero() || cutoff.After(now) || now.Sub(cutoff) > time.Minute {
+		return nil, false, ErrQuotaRecoveryConflict
+	}
+	m.mu.Lock()
+	auth := m.auths[authID]
+	if auth == nil {
+		m.mu.Unlock()
+		return nil, false, nil
+	}
+	if auth.Generation != generation || auth.Disabled || auth.Status == StatusDisabled {
+		m.mu.Unlock()
+		return nil, false, ErrQuotaRecoveryConflict
+	}
+	changed := false
+	// Credential-level non-quota failures must survive aggregation even when an
+	// unrelated old model quota is cleared.
+	preserveFailure := auth.LastError != nil && auth.LastError.HTTPStatus != 429
+	previousUnavailable, previousRetry, previousStatus := auth.Unavailable, auth.NextRetryAfter, auth.Status
+	for _, state := range auth.ModelStates {
+		if state != nil && state.Status != StatusDisabled && oldQuotaFailure(state.Quota, state.LastError, state.UpdatedAt, cutoff) {
+			resetModelState(state, now)
+			changed = true
+		}
+	}
+	if oldQuotaFailure(auth.Quota, auth.LastError, auth.UpdatedAt, cutoff) {
+		applyCooldownFields(&auth.Quota, QuotaState{})
+		auth.NextRetryAfter = time.Time{}
+		auth.Unavailable = false
+		auth.LastError = nil
+		auth.StatusMessage = ""
+		changed = true
+	}
+	if changed {
+		updateAggregatedAvailability(auth, now)
+		if preserveFailure {
+			auth.Unavailable, auth.NextRetryAfter, auth.Status = previousUnavailable, previousRetry, previousStatus
+		}
+		// Preserve credential authentication/transport errors and model errors.
+		if !auth.Unavailable && auth.LastError == nil && !hasModelError(auth, now) {
+			auth.Status = StatusActive
+		}
+		auth.Generation++
+		auth.UpdatedAt = now
+	}
+	snapshot := auth.Clone()
+	var errPersist error
+	if changed {
+		errPersist = m.persist(ctx, auth)
+	}
+	m.mu.Unlock()
+	if changed {
+		supported, epoch := registry.GetGlobalRegistry().GetModelsAndEpochForClient(authID)
+		projections := make([]registry.ClientModelProjection, 0, len(supported))
+		for _, model := range supported {
+			if model != nil && model.ID != "" {
+				projections = append(projections, m.clientModelProjectionForAuth(snapshot, model.ID, now))
+			}
+		}
+		registry.GetGlobalRegistry().ApplyClientModelProjections(authID, epoch, snapshot.Generation, projections)
+		if m.scheduler != nil {
+			m.scheduler.upsertAuth(snapshot)
+		}
+		m.persistCooldownStates(context.Background())
+	}
+	return snapshot, changed, errPersist
+}
