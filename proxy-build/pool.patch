+package api
+
+import (
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// outageHoldConfigFromConfig maps the YAML outage-hold block onto the auth
+// manager's hold configuration.
+func outageHoldConfigFromConfig(cfg *config.Config) coreauth.OutageHoldConfig {
+	if cfg == nil {
+		return coreauth.OutageHoldConfig{}
+	}
+	out := coreauth.OutageHoldConfig{
+		Enabled:       cfg.OutageHold.Enabled,
+		MaxWait:       time.Duration(cfg.OutageHold.MaxWaitSeconds) * time.Second,
+		ProbeInterval: time.Duration(cfg.OutageHold.ProbeIntervalSeconds) * time.Second,
+	}
+	if len(cfg.OutageHold.ClientMaxWaitSeconds) > 0 {
+		out.ClientMaxWait = make(map[string]time.Duration, len(cfg.OutageHold.ClientMaxWaitSeconds))
+		for prefix, seconds := range cfg.OutageHold.ClientMaxWaitSeconds {
+			out.ClientMaxWait[prefix] = time.Duration(seconds) * time.Second
+		}
+	}
+	return out
+}
