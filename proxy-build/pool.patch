+func TestGetClientVersionsReportsDetectedAndEffective(t *testing.T) {
+	restore := clientversion.SetForTesting(clientversion.ClaudeCode, "2.1.284")
+	defer restore()
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: t.TempDir()}, coreauth.NewManager(nil, nil, nil))
+	rec := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(rec)
+	ctx.Request = httptest.NewRequest(http.MethodGet, "/v0/management/client-versions", nil)
+	h.GetClientVersions(ctx)
+	var payload struct {
+		Clients map[string]clientVersionReport `json:"clients"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &payload); err != nil {
+		t.Fatal(err)
+	}
+	claude := payload.Clients["claude-code"]
+	if claude.Version != "2.1.284" || claude.Effective != "2.1.284" {
+		t.Fatalf("claude = %+v", claude)
+	}
+	if codex := payload.Clients["codex"]; codex.Version != "" || codex.Effective == "" {
+		t.Fatalf("codex = %+v, want compiled effective version and no detection", codex)
+	}
+}
