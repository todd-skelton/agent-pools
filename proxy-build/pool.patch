+
+// TestGetRequestDetails_UnknownModelIs503UntilRoutingReady pins the startup
+// window: a credential's models register after the server is listening, and a
+// 400 in that window ends a Codex turn, while a 503 is retried.
+func TestGetRequestDetails_UnknownModelIs503UntilRoutingReady(t *testing.T) {
+	handler := NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, coreauth.NewManager(nil, nil, nil))
+
+	if !ModelRoutingReady() {
+		t.Fatal("default readiness must be true so embedders keep the historical 400")
+	}
+
+	SetModelRoutingReady(false)
+	t.Cleanup(func() { SetModelRoutingReady(true) })
+
+	_, _, errMsg := handler.getRequestDetails(`claude-fable-5-1"}}`)
+	if errMsg == nil || errMsg.Error == nil {
+		t.Fatal("expected an error for an unroutable model")
+	}
+	if errMsg.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("status = %d, want %d", errMsg.StatusCode, http.StatusServiceUnavailable)
+	}
+	body := errMsg.Error.Error()
+	if !json.Valid([]byte(body)) {
+		t.Fatalf("error body is not valid JSON: %s", body)
+	}
+	if got := gjson.Get(body, "error.code").String(); got != "server_not_ready" {
+		t.Fatalf("error code = %q, want server_not_ready: %s", got, body)
+	}
+	if got := gjson.Get(body, "error.message").String(); got != `model routing is still loading, retry shortly: claude-fable-5-1"}}` {
+		t.Fatalf("error message = %q", got)
+	}
+
+	SetModelRoutingReady(true)
+	_, _, errMsg = handler.getRequestDetails("claude-fable-5-1")
+	if errMsg == nil || errMsg.StatusCode != http.StatusBadRequest {
+		t.Fatalf("after ready: %+v, want 400", errMsg)
+	}
+	if got := gjson.Get(errMsg.Error.Error(), "error.code").String(); got != "model_not_found" {
+		t.Fatalf("after ready code = %q, want model_not_found", got)
+	}
+}
