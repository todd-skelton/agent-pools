+		t.Fatalf("citations = %s, want only the document citation", assistant.Get("2.citations").Raw)
+	}
+	if assistant.Get("3.citations").Exists() {
+		t.Fatalf("an emptied citations list must be removed: %s", assistant.Get("3").Raw)
+	}
+	if gjson.GetBytes(out, "messages.0").Raw != gjson.GetBytes(body, "messages.0").Raw || gjson.GetBytes(out, "messages.2").Raw != gjson.GetBytes(body, "messages.2").Raw {
