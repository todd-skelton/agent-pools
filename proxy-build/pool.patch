+)
+
+// Finding 1: Claude must never silently drop a native checkpoint, even with no keyring configured.
+func TestClaudeRejectsNativeCheckpointWithoutKeyringConfig(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls++; portableClaudeSSE(w, "end_turn") }))
+	defer server.Close()
+	auth := &coreauth.Auth{ID: "fixture", Provider: "claude", Attributes: map[string]string{"api_key": "k", "base_url": server.URL}}
+	payload := []byte(fmt.Sprintf(`{"model":"claude-opus-5-5","input":[{"type":"compaction","encrypted_content":%q},{"type":"message","role":"user","content":"continue"}]}`, nativeTestBlob))
+	for _, cfg := range []*config.Config{{}, {PortableCompactionKeyFile: filepath.Join(t.TempDir(), "missing.json")}} {
+		exec := NewClaudeExecutor(cfg)
+		req := coreexecutor.Request{Model: "claude-opus-5-5", Payload: payload}
+		opts := portableTestOptions()
+		opts.OriginalRequest = payload
+		if _, err := exec.Execute(context.Background(), auth, req, opts); err == nil {
+			t.Fatalf("execute accepted native checkpoint with keyring %q", cfg.PortableCompactionKeyFile)
+		}
+		opts.Stream = true
+		if _, err := exec.ExecuteStream(context.Background(), auth, req, opts); err == nil {
+			t.Fatalf("stream accepted native checkpoint with keyring %q", cfg.PortableCompactionKeyFile)
+		}
+	}
+	if calls != 0 {
+		t.Fatalf("claude upstream called %d times", calls)
+	}
+}
+
+// Finding 2: admission never blocks the GPT response; a full queue drops the handoff.
+func TestNativeHandoffAdmissionIsBoundedAndNonBlocking(t *testing.T) {
+	release := make(chan struct{})
+	var served atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		served.Add(1)
+		<-release
+		w.WriteHeader(http.StatusInternalServerError)
+	}))
+	defer server.Close()
+	defer close(release)
+	cfg := portableTestConfig(t)
+	cfg.PortableCompactionNativeGPT = true
+	auth := &coreauth.Auth{ID: "fixture", Provider: "codex", Attributes: map[string]string{"api_key": "k", "base_url": server.URL}}
+	exec := NewCodexAutoExecutor(cfg).httpExec
+	start := time.Now()
+	total := nativeHandoffWorkers + nativeHandoffQueueCap + 20
+	for i := 0; i < total; i++ {
+		scheduleNativeHandoff(nativeHandoffRequest{cfg: cfg, exec: exec, auth: auth, model: "gpt-6-sol", scope: "caller", native: fmt.Sprintf("blob-%d", i)})
+	}
+	if elapsed := time.Since(start); elapsed > time.Second {
+		t.Fatalf("scheduling blocked for %v", elapsed)
+	}
+	nativeHandoffs.mu.Lock()
+	admitted := len(nativeHandoffs.inflight)
+	nativeHandoffs.mu.Unlock()
+	if admitted > nativeHandoffWorkers+nativeHandoffQueueCap || admitted >= total {
+		t.Fatalf("admitted %d of %d jobs, bound is %d", admitted, total, nativeHandoffWorkers+nativeHandoffQueueCap)
+	}
+}
+
+// Finding 3: the job is reserved before the client sees the terminal event and
+// survives the client disconnecting right after it.
+func TestNativeHandoffReservedBeforeTerminalAndSurvivesDisconnect(t *testing.T) {
+	cfg := portableTestConfig(t)
+	cfg.PortableCompactionNativeGPT = true
+	upstream := &nativeFakeUpstream{summary: "DISCONNECT HANDOFF", handoffDelay: 200 * time.Millisecond}
+	cfg2, auth, _ := nativeTestSetup(t, upstream)
+	cfg = cfg2
+	ctx, cancel := context.WithCancel(context.Background())
+	opts := portableTestOptions()
+	opts.Stream = true
+	result, err := NewCodexAutoExecutor(cfg).ExecuteStream(ctx, auth, coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(nativeCompactRequest)}, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for chunk := range result.Chunks {
+		if strings.Contains(string(chunk.Payload), "response.completed") {
+			nativeHandoffs.mu.Lock()
+			_, reserved := nativeHandoffs.inflight[nativeHandoffJobKey(cfg.PortableCompactionKeyFile, "caller", nativeTestBlob)]
+			nativeHandoffs.mu.Unlock()
+			if !reserved {
+				t.Fatal("terminal event delivered before the handoff was reserved")
+			}
+			cancel()
+			break
+		}
+	}
+	cancel()
+	if summary, ok := waitNativeHandoffStored(t, cfg, "caller", nativeTestBlob); !ok || summary != "DISCONNECT HANDOFF" {
+		t.Fatalf("handoff lost after disconnect: %q %v", summary, ok)
+	}
+}
+
+// Finding 4: the observer ends on cancellation even if the producer stays silent.
+func TestNativeObserverStopsOnCancelWithSilentProducer(t *testing.T) {
+	source := make(chan coreexecutor.StreamChunk)
+	ctx, cancel := context.WithCancel(context.Background())
+	result := observeNativeCompactionStream(ctx, &coreexecutor.StreamResult{Chunks: source}, func(string) { t.Error("unexpected checkpoint") })
+	cancel()
+	select {
+	case _, open := <-result.Chunks:
+		if open {
+			t.Fatal("unexpected chunk")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("observer did not stop after cancellation")
+	}
+	if observeNativeCompactionStream(nil, &coreexecutor.StreamResult{Chunks: make(chan coreexecutor.StreamChunk)}, func(string) {}) == nil { //nolint:staticcheck
+		t.Fatal("nil context")
+	}
+}
+
+// Finding 5: the handoff uses the resolved execution model, not the client alias.
+func TestNativeHandoffUsesResolvedExecutionModel(t *testing.T) {
+	upstream := &nativeFakeUpstream{summary: "MODEL HANDOFF"}
+	cfg, auth, _ := nativeTestSetup(t, upstream)
+	payload := strings.Replace(nativeCompactRequest, `"model":"gpt-6-sol"`, `"model":"my-gpt-alias"`, 1)
+	if _, err := NewCodexAutoExecutor(cfg).Execute(context.Background(), auth, coreexecutor.Request{Model: "gpt-6-sol(high)", Payload: []byte(payload)}, portableTestOptions()); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := waitNativeHandoffStored(t, cfg, "caller", nativeTestBlob); !ok {
+		t.Fatal("no handoff")
+	}
+	upstream.mu.Lock()
+	defer upstream.mu.Unlock()
+	if got := gjson.GetBytes(upstream.handoffs[0], "model").String(); got != "gpt-6-sol" {
+		t.Fatalf("handoff model = %q, want resolved gpt-6-sol", got)
+	}
+}
+
+// Finding 6: stored summaries are read without waiting; a still-running job yields a retryable pending error.
+func TestNativeHandoffResolverPendingAndStoreFirst(t *testing.T) {
+	cfg := portableTestConfig(t)
+	ring, _ := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	key := nativeHandoffJobKey(cfg.PortableCompactionKeyFile, "caller", "pending-blob")
+	done := make(chan struct{})
+	nativeHandoffs.mu.Lock()
+	nativeHandoffs.inflight[key] = done
+	nativeHandoffs.mu.Unlock()
+	defer func() {
+		nativeHandoffs.mu.Lock()
+		delete(nativeHandoffs.inflight, key)
+		nativeHandoffs.mu.Unlock()
+		close(done)
+	}()
+	old := nativeHandoffWaitTimeout
+	nativeHandoffWaitTimeout = 50 * time.Millisecond
+	defer func() { nativeHandoffWaitTimeout = old }()
+	resolve := nativeHandoffResolver(context.Background(), cfg, ring, "caller")
+	if _, _, err := resolve("pending-blob"); err != helps.ErrNativeHandoffPending {
+		t.Fatalf("pending job err = %v", err)
+	}
+	store, _ := helps.NewNativeHandoffStore(helps.NativeHandoffDir(cfg.PortableCompactionKeyFile), ring)
+	if err := store.Put("caller", "pending-blob", "READY", "gpt-6-sol"); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	summary, ok, err := nativeHandoffResolver(context.Background(), cfg, ring, "caller")("pending-blob")
+	if err != nil || !ok || summary != "READY" || time.Since(start) > 40*time.Millisecond {
+		t.Fatalf("store-first lookup: %q %v %v after %v", summary, ok, err, time.Since(start))
+	}
+}
+
+// Security: a stored record is caller-bound, tamper-evident, survives key rotation and concurrent writes.
+func TestNativeHandoffStoreIsolationTamperRotationConcurrency(t *testing.T) {
+	cfg := portableTestConfig(t)
+	ring, _ := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	dir := helps.NativeHandoffDir(cfg.PortableCompactionKeyFile)
+	store, _ := helps.NewNativeHandoffStore(dir, ring)
+	if err := store.Put("alice", "blob", "ALICE SUMMARY", "gpt-6-sol"); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok, err := store.Get("bob", "blob"); ok || err != nil {
+		t.Fatalf("other caller read alice's record: ok=%v err=%v", ok, err)
+	}
+	// Swapping alice's file into bob's slot must fail authentication, not decrypt.
+	aliceFile := filepath.Join(dir, helps.NativeHandoffKey("alice", "blob")+".json")
+	bobFile := filepath.Join(dir, helps.NativeHandoffKey("bob", "blob")+".json")
+	raw, _ := os.ReadFile(aliceFile)
+	_ = os.WriteFile(bobFile, raw, 0o600)
+	if _, ok, err := store.Get("bob", "blob"); ok || err == nil {
+		t.Fatal("swapped record was accepted")
+	}
+	tampered := []byte(string(raw[:len(raw)-3]) + "AAA")
+	_ = os.WriteFile(aliceFile, tampered, 0o600)
+	if _, ok, err := store.Get("alice", "blob"); ok || err == nil {
+		t.Fatal("tampered record was accepted")
+	}
+	_ = os.WriteFile(aliceFile, raw, 0o600)
+	// Rotate: new active key, old key retained.
+	rotated := &helps.PortableKeyring{Active: "next", Keys: map[string]string{"test": ring.Keys["test"], "next": "YmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmI="}}
+	rotatedStore, _ := helps.NewNativeHandoffStore(dir, rotated)
+	if summary, ok, err := rotatedStore.Get("alice", "blob"); err != nil || !ok || summary != "ALICE SUMMARY" {
+		t.Fatalf("retained key lookup failed: %q %v %v", summary, ok, err)
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if err := rotatedStore.Put("carol", "blob", fmt.Sprintf("CAROL %d", i), "gpt-6-sol"); err != nil {
+				t.Error(err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	if summary, ok, err := rotatedStore.Get("carol", "blob"); err != nil || !ok || !strings.HasPrefix(summary, "CAROL ") {
+		t.Fatalf("concurrent publish left an unreadable record: %q %v %v", summary, ok, err)
+	}
+	leftovers, _ := filepath.Glob(filepath.Join(dir, "*.tmp"))
+	if len(leftovers) != 0 {
+		t.Fatalf("temporary files left behind: %v", leftovers)
+	}
+}
