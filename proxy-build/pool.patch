+				t.Fatalf("resend still carries search data: %s", sent[1])
+			}
+			if !bytes.Contains(sent[1], []byte("The Environments permission.")) || !bytes.Contains(sent[1], []byte("char_location")) {
+				t.Fatalf("resend lost text or unrelated citations: %s", sent[1])
+			}
+
+			// The next request of the same conversation to the same account is
+			// stripped before sending: no second rejection.
+			if _, err = runClaudeStream(t, executor, auth, searchHistoryBody(true)); err != nil {
+				t.Fatalf("second stream failed: %v", err)
+			}
+			sent = upstream.requests()
+			if len(sent) != 3 {
+				t.Fatalf("upstream requests after second turn = %d, want 3 (no repeated rejection)", len(sent))
+			}
+			if bytes.Contains(sent[2], []byte("IDX_")) {
+				t.Fatal("remembered conversation was sent with search data")
+			}
+
+			// Another account has not refused it, so it first gets the history intact.
+			other := &cliproxyauth.Auth{ID: "stream-other-" + name, Attributes: auth.Attributes}
+			if _, err = runClaudeStream(t, executor, other, searchHistoryBody(true)); err != nil {
+				t.Fatalf("other account stream failed: %v", err)
+			}
+			if sent = upstream.requests(); len(sent) != 5 || !bytes.Contains(sent[3], []byte("IDX_A")) {
+				t.Fatalf("another account must first see the history intact (requests=%d)", len(sent))
+			}
+		})
+	}
