+func TestLiveModelsSchedule(t *testing.T) {
+	a, b := oauthAuth("live-claude-due", "claude"), oauthAuth("live-claude-new", "claude")
+	h := newLiveModelsHarness(t, "", a, b)
+	clock := time.Date(2026, 9, 28, 12, 0, 0, 0, time.UTC)
+	h.manager.now = func() time.Time { return clock }
+	h.lists[a.ID] = modelList("claude", "claude-sonnet-5-5")
+	h.errs[b.ID] = errors.New("offline")
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != 2 {
+		t.Fatalf("first pass calls = %d", h.calls.Load())
+	}
+	clock = clock.Add(2 * time.Minute)
+	h.manager.pass(context.Background(), false)
+	// b has no list yet and retries each minute; a waits for its interval.
+	if h.calls.Load() != 3 {
+		t.Fatalf("second pass calls = %d, want only the credential without a list", h.calls.Load())
+	}
+	clock = clock.Add(liveModelsDefaultInterval)
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != 5 {
+		t.Fatalf("third pass calls = %d", h.calls.Load())
+	}
+}
