+		t.Fatalf("retired key replay: %v %v", got, err)
+	}
+	for _, tc := range []struct{ value, scope string }{{capsule, "other"}, {capsule, ""}, {strings.Replace(capsule, ":a:", ":b:", 1), "caller"}, {capsule[:len(capsule)-8] + "abcdefgh", "caller"}, {PortableCompactionPrefix + strings.Repeat("x", 200000), "caller"}} {
+		if _, err := ring.Open(tc.value, tc.scope); err == nil {
