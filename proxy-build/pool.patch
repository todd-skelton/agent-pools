+// isCodexBootstrapHoldableEvent reports whether an event may be held back while probing for an
+// in-stream rejection: the handshake metadata frames plus the empty structural events that open an
+// output item before any content is generated. Reasoning models open an empty reasoning item right
+// after response.in_progress and then think for seconds before the first delta; the upstream
+// delivers server_is_overloaded in that gap (sequence_number 3, or 4 after an empty summary part),
+// so releasing the stream at the empty item committed the downstream headers and turned a
+// transparent failover into a failed turn (2026-10-19 20:48-22:30 CDT, 18 codex_exec turns).
+//
+// encrypted_content does not make a reasoning item non-empty. Codex clients request
+// reasoning.encrypted_content, and the upstream attaches an opaque state blob to the item when it
+// opens (before any reasoning is shown; output_item.done carries a different blob), so pool.27,
+// which released on a non-empty blob, never held a real reasoning item: every overload after its
+// deploy arrived in-stream and 13 codex_exec lanes died after 6/6 reconnects (2026-10-21
+// 06:12-09:14Z). Nothing held here reaches the client before the first generated event, and a
+// failover discards it with the rest of the attempt.
+func isCodexBootstrapHoldableEvent(eventType string, data []byte) bool {
+	if isCodexHandshakeMetadataEvent(eventType) {
+		return true
+	}
+	switch eventType {
+	case "response.output_item.added":
+		item := gjson.GetBytes(data, "item")
+		switch item.Get("type").String() {
+		case "reasoning":
+			return codexEmptyJSONList(item.Get("summary")) && codexEmptyJSONList(item.Get("content"))
+		case "message":
+			return codexEmptyJSONList(item.Get("content"))
+		}
+		return false
+	case "response.reasoning_summary_part.added", "response.content_part.added":
+		return strings.TrimSpace(gjson.GetBytes(data, "part.text").String()) == ""
+	default:
+		return false
+	}
+}
+
+// codexEmptyJSONList reports whether a field is absent, null or an empty array.
+func codexEmptyJSONList(value gjson.Result) bool {
+	if !value.Exists() || value.Type == gjson.Null {
+		return true
+	}
+	return value.IsArray() && len(value.Array()) == 0
+}
