+type liveModelsHarness struct {
+	service *Service
+	manager *liveModelManager
+	lists   map[string]*liveModelList
+	errs    map[string]error
+	calls   atomic.Int32
+}
+
+func newLiveModelsHarness(t *testing.T, cacheFile string, auths ...*coreauth.Auth) *liveModelsHarness {
+	t.Helper()
+	h := &liveModelsHarness{lists: map[string]*liveModelList{}, errs: map[string]error{}}
+	manager := coreauth.NewManager(nil, nil, nil)
+	for _, auth := range auths {
+		if _, err := manager.Register(context.Background(), auth); err != nil {
+			t.Fatal(err)
+		}
+	}
+	h.service = &Service{
+		cfg:         &config.Config{LiveModels: internalconfig.LiveModelsConfig{Enabled: true, CacheFile: cacheFile}},
+		coreManager: manager,
+	}
+	h.manager = newLiveModelManager(h.service)
+	fetch := func(_ context.Context, _ *config.Config, auth *coreauth.Auth) (*liveModelList, error) {
+		h.calls.Add(1)
+		if err := h.errs[auth.ID]; err != nil {
+			return nil, err
+		}
+		list := h.lists[auth.ID]
+		if list == nil {
+			return nil, errors.New("no fixture")
+		}
+		clone := *list
+		clone.Models = cloneLiveModels(list.Models)
+		return &clone, nil
+	}
+	h.manager.fetch = map[string]liveModelFetcher{"claude": fetch, "codex": fetch}
+	h.service.liveModels = h.manager
+	reg := internalregistry.GetGlobalRegistry()
+	t.Cleanup(func() {
+		for _, auth := range auths {
+			reg.UnregisterClient(auth.ID)
+			livemodels.Forget(auth.ID)
+		}
+		internalregistry.SetCodexClientLiveTemplates(nil)
+	})
+	return h
+}
+
+func oauthAuth(id, provider string) *coreauth.Auth {
+	return &coreauth.Auth{
+		ID:       id,
+		Provider: provider,
+		Status:   coreauth.StatusActive,
+		Metadata: map[string]any{"type": provider, "access_token": "token-" + id, "refresh_token": "refresh-" + id, "email": id + "@example.com"},
+	}
+}
+
+func modelList(provider string, ids ...string) *liveModelList {
+	list := &liveModelList{Provider: provider}
+	for _, id := range ids {
+		list.Models = append(list.Models, &ModelInfo{ID: id, Object: "model", OwnedBy: provider, Type: provider})
+	}
+	return list
+}
+
+func registeredIDs(authID string) []string {
+	ids := liveModelIDs(internalregistry.GetGlobalRegistry().GetModelsForClient(authID))
+	sort.Strings(ids)
+	return ids
+}
