index 0000000000000000000000000000000000000000..9faa08ac9e40bbceadc9e743f5fa9aa54b060660
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_outage_hold.go
@@ -0,0 +1,563 @@
+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+// OutageHoldConfig controls how long a request may be held open while every
+// credential for its model is unavailable because of a transient provider
+// failure. The hold runs after the ordinary credential retry rounds have been
+// exhausted and keeps the client connection open instead of returning the
+// upstream error, so a client whose own retry budget is short (Codex, Claude
+// Code) does not lose its turn during a provider outage.
+type OutageHoldConfig struct {
+	// Enabled turns the hold on. The zero value keeps the legacy fail-fast behavior.
+	Enabled bool
+	// MaxWait is the hold budget for one client turn. Zero selects the default.
+	MaxWait time.Duration
+	// ProbeInterval is the minimum spacing between upstream probes from one held
+	// request and the polling interval while the probe token is held by another
+	// request. Zero selects the default.
+	ProbeInterval time.Duration
+	// ClientMaxWait overrides MaxWait by lower-case User-Agent prefix, so clients
+	// with a pre-header request timeout (Claude Code API_TIMEOUT_MS) receive a
+	// budget that ends before their own timeout fires.
+	ClientMaxWait map[string]time.Duration
+}
+
+const (
+	// anthropicOverloadedStatus is Anthropic's HTTP status for an overloaded model.
+	anthropicOverloadedStatus = 529
+
+	defaultOutageHoldMaxWait       = 10 * time.Minute
+	defaultOutageHoldProbeInterval = 5 * time.Second
+	// outageHoldRecheckInterval bounds a single sleep so a manual credential
+	// recovery or a config change is noticed without waiting for the full cooldown.
+	outageHoldRecheckInterval = 30 * time.Second
+	// outageHoldExpiredGrace keeps a turn in fail-fast mode after its budget
+	// expires so the client's own HTTP and stream retries for the same turn do
+	// not each start a fresh hold.
+	outageHoldExpiredGrace = 90 * time.Second
+	// outageHoldHealthyWindow is how recently another request must have started
+	// successfully on the model for the pool to count as healthy: a held request
+	// then probes without the token, and a failure right after such a success
+	// marks the request itself as the problem instead of the provider.
+	outageHoldHealthyWindow = 30 * time.Second
+)
+
+// OutageHoldStatus is the management snapshot of the hold engine.
+type OutageHoldStatus struct {
+	Enabled bool `json:"enabled"`
+	// Active counts requests currently waiting in a hold.
+	Active int `json:"active"`
+	// Turns counts client turns with a live or recently expired hold budget.
+	Turns int `json:"turns"`
+}
+
+type outageHoldTurn struct {
+	start        time.Time
+	deadline     time.Time
+	expiredUntil time.Time
+}
+
+type outageHoldState struct {
+	config      atomic.Pointer[OutageHoldConfig]
+	mu          sync.Mutex
+	turns       map[string]*outageHoldTurn
+	probes      map[string]struct{}
+	lastSuccess map[string]time.Time
+	active      int
+	// now and sleep are replaceable in tests.
+	now   func() time.Time
+	sleep func(ctx context.Context, d time.Duration) error
+}
+
+func (s *outageHoldState) clock() time.Time {
+	if s.now != nil {
+		return s.now()
+	}
+	return time.Now()
+}
+
+func (s *outageHoldState) pause(ctx context.Context, d time.Duration) error {
+	if s.sleep != nil {
+		return s.sleep(ctx, d)
+	}
+	if d <= 0 {
+		return ctx.Err()
+	}
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+func (s *outageHoldState) ensureLocked() {
+	if s.turns == nil {
+		s.turns = make(map[string]*outageHoldTurn)
+	}
+	if s.probes == nil {
+		s.probes = make(map[string]struct{})
+	}
+	if s.lastSuccess == nil {
+		s.lastSuccess = make(map[string]time.Time)
+	}
+}
+
+func (s *outageHoldState) sweepLocked(now time.Time) {
+	for key, turn := range s.turns {
+		if turn == nil {
+			delete(s.turns, key)
+			continue
+		}
+		if !turn.expiredUntil.IsZero() {
+			if now.After(turn.expiredUntil) {
+				delete(s.turns, key)
+			}
+			continue
+		}
+		if now.After(turn.deadline.Add(outageHoldExpiredGrace)) {
+			delete(s.turns, key)
+		}
+	}
+}
+
+// SetOutageHoldConfig installs the hold configuration. Passing a disabled
+// config restores fail-fast behavior for requests that start afterwards.
+func (m *Manager) SetOutageHoldConfig(cfg OutageHoldConfig) {
+	if m == nil {
+		return
+	}
+	if cfg.MaxWait <= 0 {
+		cfg.MaxWait = defaultOutageHoldMaxWait
+	}
+	if cfg.ProbeInterval <= 0 {
+		cfg.ProbeInterval = defaultOutageHoldProbeInterval
+	}
+	normalized := make(map[string]time.Duration, len(cfg.ClientMaxWait))
+	for prefix, budget := range cfg.ClientMaxWait {
+		prefix = strings.ToLower(strings.TrimSpace(prefix))
+		if prefix == "" || budget <= 0 {
+			continue
+		}
+		normalized[prefix] = budget
+	}
+	cfg.ClientMaxWait = normalized
+	m.outageHold.config.Store(&cfg)
+}
+
+// OutageHoldStatus reports the current hold engine counters.
+func (m *Manager) OutageHoldStatus() OutageHoldStatus {
+	if m == nil {
+		return OutageHoldStatus{}
+	}
+	cfg := m.outageHold.config.Load()
+	s := &m.outageHold
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ensureLocked()
+	s.sweepLocked(s.clock())
+	return OutageHoldStatus{Enabled: cfg != nil && cfg.Enabled, Active: s.active, Turns: len(s.turns)}
+}
+
+func (c *OutageHoldConfig) budgetFor(userAgent string) time.Duration {
+	if c == nil {
+		return 0
+	}
+	ua := strings.ToLower(strings.TrimSpace(userAgent))
+	if ua != "" {
+		best := ""
+		budget := time.Duration(0)
+		for prefix, d := range c.ClientMaxWait {
+			if strings.HasPrefix(ua, prefix) && len(prefix) > len(best) {
+				best = prefix
+				budget = d
+			}
+		}
+		if best != "" {
+			return budget
+		}
+	}
+	return c.MaxWait
+}
+
+// outageHoldEligibleError reports whether an error describes a transient
+// provider failure that a hold may wait out. A 429 is eligible: it cools only
+// the credential that returned it (a bare rate limit backs off from 1 s, a
+// usage limit until its reset), and the hold waits for the soonest credential
+// that can recover inside the budget. When every credential is at a long quota
+// reset nothing qualifies and the hold ends at once (outcome no-recovery), so a
+// real quota exhaustion still fails fast. Before 2026-10-20 a 429 was never
+// held: with the other accounts in a 10 s overload cooldown, one account's bare
+// "Rate limit exceeded" ended codex_exec turns (2026-10-19 20:17 and 22:23 CDT).
+// Every other 4xx is the request's or the credential's problem and fails as before.
+func outageHoldEligibleError(err error) bool {
+	if err == nil || isRequestInvalidError(err) || isRequestStopError(err) || isRequestTerminatedError(err) {
+		return false
+	}
+	status := statusCodeFromError(err)
+	if status == 0 {
+		return isAuthUnavailableError(err) || hasUpstreamExecutionAttempt(err)
+	}
+	return status == http.StatusTooManyRequests || isOutageHoldStatus(status)
+}
+
+func isOutageHoldStatus(status int) bool {
+	switch status {
+	case http.StatusRequestTimeout,
+		http.StatusInternalServerError,
+		http.StatusBadGateway,
+		http.StatusServiceUnavailable,
+		http.StatusGatewayTimeout,
+		anthropicOverloadedStatus:
+		return true
+	default:
+		return status >= 520 && status <= 526
+	}
+}
+
+// outageHoldTurnKey identifies the client turn a hold budget belongs to, so the
+// budget spans the client's own HTTP and stream retries of the same turn. Codex
+// sends its turn id in X-Codex-Turn-Metadata; other clients fall back to the
+// canonical session identity derived by cliproxysession.Enrich.
+func outageHoldTurnKey(opts cliproxyexecutor.Options) string {
+	if opts.Headers != nil {
+		if meta := strings.TrimSpace(opts.Headers.Get("X-Codex-Turn-Metadata")); meta != "" {
+			if turnID := strings.TrimSpace(gjson.Get(meta, "turn_id").String()); turnID != "" {
+				return "turn:" + turnID
+			}
+		}
+	}
+	if opts.Metadata != nil {
+		if session, ok := opts.Metadata[cliproxyexecutor.CanonicalSessionIDMetadataKey].(string); ok {
+			if session = strings.TrimSpace(session); session != "" {
+				return "session:" + session
+			}
+		}
+	}
+	return ""
+}
+
+func outageHoldModelKey(model string) string {
+	key := canonicalModelKey(model)
+	if key == "" {
+		return "*"
+	}
+	return key
+}
+
+// outageHoldSession is the per-request hold. It is created when the ordinary
+// retry rounds give up on an eligible error and lives until the request ends.
+type outageHoldSession struct {
+	m                   *Manager
+	entry               *log.Entry
+	key                 string
+	client              string
+	model               string
+	modelKey            string
+	providers           []string
+	eligibility         authSelectionEligibility
+	pinnedAuthID        string
+	defaultRequestRetry int
+	probeInterval       time.Duration
+	start               time.Time
+	deadline            time.Time
+	lastFailure         time.Time
+	probeStart          time.Time
+	probes              int
+	probing             bool
+	outcome             string
+	finished            bool
+}
+
+// beginOutageHold starts a hold for the request when the hold is enabled, the
+// error is eligible and the client turn still has budget. It returns nil when
+// the request must fail as before.
+func (m *Manager) beginOutageHold(ctx context.Context, opts cliproxyexecutor.Options, providers []string, model string, defaultRequestRetry int, err error) *outageHoldSession {
+	if m == nil || ctx == nil || ctx.Err() != nil || m.HomeEnabled() {
+		return nil
+	}
+	cfg := m.outageHold.config.Load()
+	if cfg == nil || !cfg.Enabled {
+		return nil
+	}
+	if !outageHoldEligibleError(err) {
+		return nil
+	}
+	userAgent := ""
+	if opts.Headers != nil {
+		userAgent = opts.Headers.Get("User-Agent")
+	}
+	budget := cfg.budgetFor(userAgent)
+	if budget <= 0 {
+		return nil
+	}
+	if defaultRequestRetry < 1 {
+		defaultRequestRetry = 1
+	}
+	key := outageHoldTurnKey(opts)
+	entry := logEntryWithRequestID(ctx).WithFields(log.Fields{
+		"hold_turn":   key,
+		"hold_client": strings.TrimSpace(userAgent),
+		"hold_model":  model,
+	})
+	s := &m.outageHold
+	s.mu.Lock()
+	s.ensureLocked()
+	now := s.clock()
+	s.sweepLocked(now)
+	var turn *outageHoldTurn
+	if key != "" {
+		turn = s.turns[key]
+	}
+	if turn != nil && !turn.expiredUntil.IsZero() {
+		s.mu.Unlock()
+		entry.WithField("hold_expired_until", turn.expiredUntil.Format(time.RFC3339)).Warn("outage hold skipped: turn budget already spent, failing fast")
+		return nil
+	}
+	if turn == nil {
+		turn = &outageHoldTurn{start: now, deadline: now.Add(budget)}
+		if key != "" {
+			s.turns[key] = turn
+		}
+	}
+	if !now.Before(turn.deadline) {
+		turn.expiredUntil = now.Add(outageHoldExpiredGrace)
+		s.mu.Unlock()
+		entry.Warn("outage hold skipped: turn budget exhausted, failing fast")
+		return nil
+	}
+	s.active++
+	active := s.active
+	s.mu.Unlock()
+	session := &outageHoldSession{
+		m:                   m,
+		entry:               entry,
+		key:                 key,
+		client:              strings.TrimSpace(userAgent),
+		model:               model,
+		modelKey:            outageHoldModelKey(model),
+		providers:           providers,
+		eligibility:         authSelectionEligibilityForRequest(ctx, opts),
+		pinnedAuthID:        pinnedAuthIDFromMetadata(opts.Metadata),
+		defaultRequestRetry: defaultRequestRetry,
+		probeInterval:       cfg.ProbeInterval,
+		start:               now,
+		deadline:            turn.deadline,
+		lastFailure:         now,
+	}
+	entry.WithFields(log.Fields{
+		"hold_status":   statusCodeFromError(err),
+		"hold_budget":   turn.deadline.Sub(now).Round(time.Second).String(),
+		"hold_active":   active,
+		"hold_deadline": turn.deadline.Format(time.RFC3339),
+	}).Warnf("outage hold started: no credential for %s can serve the request; holding the client connection: %v", model, err)
+	return session
+}
+
+// await blocks until a credential for the model is worth probing again and
+// reports true when the caller should run another retry round. It reports false
+// when the hold ends without recovery: budget exhausted, no credential can
+// recover inside the budget, the request itself looks like the failure, or the
+// client went away.
+func (s *outageHoldSession) await(ctx context.Context, err error) bool {
+	if s == nil {
+		return false
+	}
+	st := &s.m.outageHold
+	s.releaseProbe()
+	now := st.clock()
+	s.lastFailure = now
+	if !outageHoldEligibleError(err) {
+		s.outcome = "ineligible:" + errorCodeForLog(err)
+		return false
+	}
+	status := statusCodeFromError(err)
+	// A rate limit is per credential, never evidence that the request itself is
+	// bad, so a 429 probe does not count toward the poison check.
+	if s.probes > 0 && status != http.StatusTooManyRequests && st.healthySince(s.modelKey, s.probeStart.Add(-outageHoldHealthyWindow), s.probeStart) {
+		// Another request started successfully on this model right before our
+		// probe and our probe still failed: the provider is up and this request
+		// is the problem.
+		s.outcome = "poison"
+		return false
+	}
+	for {
+		now = st.clock()
+		if !now.Before(s.deadline) {
+			s.outcome = "expired"
+			st.markExpired(s.key, now)
+			return false
+		}
+		remaining := s.deadline.Sub(now)
+		wait, found := s.m.closestCooldownWaitWithAttempted(s.providers, s.model, 0, s.eligibility, s.pinnedAuthID, s.defaultRequestRetry, status, nil)
+		if !found || wait > remaining {
+			// Nothing can recover inside the remaining budget: end the turn now
+			// rather than at the deadline, and keep its retries fail-fast.
+			s.outcome = "no-recovery"
+			st.markExpired(s.key, now)
+			return false
+		}
+		if floor := s.probeInterval - now.Sub(s.lastFailure); wait < floor {
+			wait = floor
+		}
+		if wait <= 0 {
+			// A model that served another request in the last window is proven
+			// healthy and needs no probe token; otherwise one held request at a
+			// time probes so a recovering credential is not stampeded.
+			healthy := st.healthySince(s.modelKey, now.Add(-outageHoldHealthyWindow), now)
+			if healthy || st.acquireProbe(s.modelKey) {
+				s.probing = !healthy
+				s.probes++
+				s.probeStart = now
+				s.entry.WithFields(log.Fields{"hold_probe": s.probes, "hold_elapsed": now.Sub(s.start).Round(time.Second).String()}).Info("outage hold probing upstream")
+				return true
+			}
+			wait = s.probeInterval
+		}
+		if wait > outageHoldRecheckInterval {
+			wait = outageHoldRecheckInterval
+		}
+		if errSleep := st.pause(ctx, wait); errSleep != nil {
+			s.outcome = "aborted"
+			return false
+		}
+	}
+}
+
+func (s *outageHoldSession) releaseProbe() {
+	if s == nil || !s.probing {
+		return
+	}
+	s.probing = false
+	s.m.outageHold.releaseProbe(s.modelKey)
+}
+
+// finish ends the hold bookkeeping. recovered reports that the request went on
+// to start successfully.
+func (s *outageHoldSession) finish(recovered bool) {
+	if s == nil || s.finished {
+		return
+	}
+	s.finished = true
+	s.releaseProbe()
+	st := &s.m.outageHold
+	st.mu.Lock()
+	st.ensureLocked()
+	if st.active > 0 {
+		st.active--
+	}
+	if recovered && s.key != "" {
+		delete(st.turns, s.key)
+	}
+	now := st.clock()
+	st.mu.Unlock()
+	outcome := s.outcome
+	if recovered {
+		outcome = "recovered"
+	} else if outcome == "" {
+		outcome = "failed"
+	}
+	fields := log.Fields{
+		"hold_outcome":  outcome,
+		"hold_probes":   s.probes,
+		"hold_duration": now.Sub(s.start).Round(time.Second).String(),
+	}
+	if recovered {
+		s.entry.WithFields(fields).Warn("outage hold ended: upstream recovered")
+		return
+	}
+	s.entry.WithFields(fields).Warn("outage hold ended without recovery; returning the upstream error")
+}
+
+func (s *outageHoldState) markExpired(key string, now time.Time) {
+	if key == "" {
+		return
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ensureLocked()
+	turn := s.turns[key]
+	if turn == nil {
+		turn = &outageHoldTurn{start: now, deadline: now}
+		s.turns[key] = turn
+	}
+	turn.expiredUntil = now.Add(outageHoldExpiredGrace)
+}
+
+func (s *outageHoldState) acquireProbe(modelKey string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ensureLocked()
+	if _, busy := s.probes[modelKey]; busy {
+		return false
+	}
+	s.probes[modelKey] = struct{}{}
+	return true
+}
+
+func (s *outageHoldState) releaseProbe(modelKey string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ensureLocked()
+	delete(s.probes, modelKey)
+}
+
+// healthySince reports whether a request started successfully on the model
+// inside the (after, before] window.
+func (s *outageHoldState) healthySince(modelKey string, after, before time.Time) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ensureLocked()
+	last, ok := s.lastSuccess[modelKey]
+	if !ok {
+		return false
+	}
+	return last.After(after) && !last.After(before)
+}
+
+// noteOutageHoldSuccess records that a request started successfully on the
+// model. Held requests use it to tell a recovered provider from a request that
+// fails on its own.
+func (m *Manager) noteOutageHoldSuccess(model string) {
+	if m == nil {
+		return
+	}
+	cfg := m.outageHold.config.Load()
+	if cfg == nil || !cfg.Enabled {
+		return
+	}
+	s := &m.outageHold
+	s.mu.Lock()
+	s.ensureLocked()
+	s.lastSuccess[outageHoldModelKey(model)] = s.clock()
+	s.mu.Unlock()
+}
+
+func errorCodeForLog(err error) string {
+	if err == nil {
+		return ""
+	}
+	var authErr *Error
+	if errors.As(err, &authErr) && authErr != nil && authErr.Code != "" {
+		return authErr.Code
+	}
+	if status := statusCodeFromError(err); status != 0 {
+		return http.StatusText(status)
+	}
+	return "error"
+}
