index 0000000000000000000000000000000000000000..dea80e032a7ac74abe8464cb256f09539f3236e6
--- /dev/null
+++ b/internal/runtime/executor/claude_executor_stream_error_test.go
@@ -0,0 +1,156 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+const claudeStreamMessageStart = "event: message_start\n" +
+	`data: {"type":"message_start","message":{"id":"msg_1","type":"message","role":"assistant","content":[],"model":"claude-opus-5","stop_reason":null,"usage":{"input_tokens":10,"output_tokens":1}}}` + "\n\n" +
+	"event: ping\n" +
+	`data: {"type":"ping"}` + "\n\n"
+
+const claudeStreamOverloaded = "event: error\n" +
+	`data: {"type":"error","error":{"type":"overloaded_error","message":"Overloaded"}}` + "\n\n"
+
+const claudeStreamContent = "event: content_block_start\n" +
+	`data: {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}` + "\n\n" +
+	"event: content_block_delta\n" +
+	`data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"hello"}}` + "\n\n"
+
+func runClaudeStreamErrorCase(t *testing.T, upstream string, opts cliproxyexecutor.Options) ([]string, error) {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = w.Write([]byte(upstream))
+	}))
+	defer server.Close()
+
+	executor := NewClaudeExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"api_key":  "key-123",
+		"base_url": server.URL,
+	}}
+	payload := []byte(`{"model":"claude-opus-5","messages":[{"role":"user","content":"hello"}],"stream":true}`)
+	result, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{Model: "claude-opus-5", Payload: payload}, opts)
+	if err != nil {
+		t.Fatalf("ExecuteStream() error = %v", err)
+	}
+	var payloads []string
+	var streamErr error
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			streamErr = chunk.Err
+			continue
+		}
+		if len(chunk.Payload) > 0 {
+			payloads = append(payloads, string(chunk.Payload))
+		}
+	}
+	return payloads, streamErr
+}
+
+// An overloaded_error delivered inside an HTTP 200 stream before any content
+// must fail the attempt before a payload reaches the conductor, with the status
+// Anthropic uses for the same rejection at the HTTP level, so the credential is
+// cooled and the request fails over exactly like an HTTP 529.
+func TestClaudeExecutor_InStreamOverloadBeforeContentFailsBootstrap(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		opts cliproxyexecutor.Options
+	}{
+		{name: "passthrough", opts: cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("claude"), ResponseFormat: sdktranslator.FromString("claude")}},
+		{name: "translated", opts: cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, ResponseFormat: sdktranslator.FormatOpenAIResponse}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			payloads, streamErr := runClaudeStreamErrorCase(t, claudeStreamMessageStart+claudeStreamOverloaded, tc.opts)
+			if len(payloads) != 0 {
+				t.Fatalf("expected no payload before the in-stream error, got %#v", payloads)
+			}
+			if streamErr == nil {
+				t.Fatal("expected a stream error for the in-stream overloaded_error")
+			}
+			var sc interface{ StatusCode() int }
+			if !errors.As(streamErr, &sc) || sc.StatusCode() != 529 {
+				t.Fatalf("stream error = %v, want status 529", streamErr)
+			}
+			if !strings.Contains(streamErr.Error(), "overloaded_error") {
+				t.Fatalf("stream error should carry the upstream body, got %q", streamErr.Error())
+			}
+		})
+	}
+}
+
+// After content has been delivered the error can no longer be retried
+// transparently, but it must still surface as a stream error so the failure
+// is recorded against the credential and the client gets a terminal error
+// event instead of a silent close.
+func TestClaudeExecutor_InStreamOverloadAfterContentSurfacesError(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		opts cliproxyexecutor.Options
+	}{
+		{name: "passthrough", opts: cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("claude"), ResponseFormat: sdktranslator.FromString("claude")}},
+		{name: "translated", opts: cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, ResponseFormat: sdktranslator.FormatOpenAIResponse}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			payloads, streamErr := runClaudeStreamErrorCase(t, claudeStreamMessageStart+claudeStreamContent+claudeStreamOverloaded, tc.opts)
+			if len(payloads) == 0 {
+				t.Fatal("expected content payloads before the in-stream error")
+			}
+			for _, p := range payloads {
+				if strings.Contains(p, `"type":"error"`) {
+					t.Fatalf("error event must not be forwarded as a payload: %q", p)
+				}
+			}
+			if streamErr == nil {
+				t.Fatal("expected a stream error after content")
+			}
+			var sc interface{ StatusCode() int }
+			if !errors.As(streamErr, &sc) || sc.StatusCode() != 529 {
+				t.Fatalf("stream error = %v, want status 529", streamErr)
+			}
+		})
+	}
+}
+
+// Handshake events are released unchanged, in order, once content arrives; a
+// healthy stream is byte-for-byte what it was before buffering.
+func TestClaudeExecutor_HandshakeBufferReleasesOnContent(t *testing.T) {
+	payloads, streamErr := runClaudeStreamErrorCase(t, claudeStreamMessageStart+claudeStreamContent+"event: message_stop\n"+`data: {"type":"message_stop"}`+"\n\n", cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("claude"), ResponseFormat: sdktranslator.FromString("claude")})
+	if streamErr != nil {
+		t.Fatalf("unexpected stream error: %v", streamErr)
+	}
+	joined := strings.Join(payloads, "")
+	want := claudeStreamMessageStart + claudeStreamContent + "event: message_stop\n" + `data: {"type":"message_stop"}` + "\n\n"
+	if joined != want {
+		t.Fatalf("passthrough output changed:\n got: %q\nwant: %q", joined, want)
+	}
+	if !strings.HasPrefix(payloads[0], "event: message_start") {
+		t.Fatalf("first payload = %q, want message_start", payloads[0])
+	}
+}
+
+func TestClaudeStreamErrorStatusMapping(t *testing.T) {
+	for errType, want := range map[string]int{
+		"overloaded_error":      529,
+		"rate_limit_error":      http.StatusTooManyRequests,
+		"api_error":             http.StatusInternalServerError,
+		"authentication_error":  http.StatusUnauthorized,
+		"invalid_request_error": http.StatusBadRequest,
+		"":                      http.StatusInternalServerError,
+	} {
+		if got := claudeStreamErrorStatus(errType); got != want {
+			t.Errorf("claudeStreamErrorStatus(%q) = %d, want %d", errType, got, want)
+		}
+	}
+}
