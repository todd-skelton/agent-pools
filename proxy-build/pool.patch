+		"thinking 400":     {http.StatusBadRequest, `{"type":"error","error":{"type":"invalid_request_error","message":"messages.1.content.0: Invalid ` + "`signature`" + ` in ` + "`thinking`" + ` block"}}`, false},
+		"same text, 429":   {http.StatusTooManyRequests, claudeCitationRejection, false},
+		"wrong error type": {http.StatusBadRequest, `{"type":"error","error":{"type":"api_error","message":"Invalid ` + "`encrypted_index`" + ` in ` + "`text`" + ` block"}}`, false},
+		"not json":         {http.StatusBadRequest, "Invalid `encrypted_index` in `text` block", false},
+	} {
