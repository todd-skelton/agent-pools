+func TestExecutionMetadataAppliesCallerScopeAlias(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	newCtx := func(key string) context.Context {
+		ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+		ginCtx.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		ginCtx.Set("userApiKey", key)
+		return context.WithValue(context.Background(), "gin", ginCtx)
+	}
+	oldScope := coresession.CallerScope("retired-key")
+	handler := &BaseAPIHandler{Cfg: &config.SDKConfig{CallerScopeAliases: map[string]string{
+		coresession.CallerScope("replacement-key"): strings.ToUpper(oldScope),
+		coresession.CallerScope("malformed-alias"): "not-a-scope",
+	}}}
+	scopeOf := func(meta map[string]any) string { s, _ := meta[coreexecutor.CallerScopeMetadataKey].(string); return s }
+
+	if got := scopeOf(handler.executionMetadata(newCtx("replacement-key"))); got != oldScope {
+		t.Fatalf("aliased key scope = %q, want the retired key's scope %q", got, oldScope)
+	}
+	if got := scopeOf(handler.executionMetadata(newCtx("retired-key"))); got != oldScope {
+		t.Fatalf("retired key scope = %q, want unchanged %q", got, oldScope)
+	}
+	if got, want := scopeOf(handler.executionMetadata(newCtx("other-key"))), coresession.CallerScope("other-key"); got != want {
+		t.Fatalf("unaliased key scope = %q, want its own %q", got, want)
+	}
+	if got, want := scopeOf(handler.executionMetadata(newCtx("malformed-alias"))), coresession.CallerScope("malformed-alias"); got != want {
+		t.Fatalf("malformed alias must be ignored: scope = %q, want %q", got, want)
+	}
+	if got, want := scopeOf((&BaseAPIHandler{}).executionMetadata(newCtx("replacement-key"))), coresession.CallerScope("replacement-key"); got != want {
+		t.Fatalf("nil config scope = %q, want %q", got, want)
+	}
