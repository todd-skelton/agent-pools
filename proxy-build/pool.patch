+
+	userOnly := []byte(`{"model":"gpt-6-astra","input":[{"type":"message","role":"user","content":[{"type":"input_text","text":"What are you?"}]}]}`)
+	if got := string(injectCodexRuntimeIdentity(userOnly)); got != string(userOnly) {
+		t.Fatalf("user-only input changed: %s", got)
