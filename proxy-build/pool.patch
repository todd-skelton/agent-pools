diff --git a/internal/runtime/executor/claude_executor_stream_error.go b/internal/runtime/executor/claude_executor_stream_error.go
new file mode 100644
index 0000000000000000000000000000000000000000..ac6e74d0a75be0d5b0efb20a6b6d5c60fd2f0d80
--- /dev/null
+++ b/internal/runtime/executor/claude_executor_stream_error.go
@@ -0,0 +1,133 @@
+package executor
+
+import (
+	"bytes"
+	"net/http"
+
+	"github.com/tidwall/gjson"
+)
+
+// claudeHandshakeMaxBufferedEvents bounds how many handshake events (message_start,
+// ping) are held back while waiting for the first content event or an in-stream
+// error. Anthropic sends one message_start and an occasional ping before the
+// first content block; once the bound is reached the stream is released and the
+// previous unbuffered semantics apply.
+const claudeHandshakeMaxBufferedEvents = 8
+
+// claudeHandshakeBuffer holds the handshake events of a Claude stream until the
+// first event that carries output.
+type claudeHandshakeBuffer struct {
+	chunks [][]byte
+	open   bool
+}
+
+func newClaudeHandshakeBuffer() *claudeHandshakeBuffer {
+	return &claudeHandshakeBuffer{open: true}
+}
+
+func isClaudeHandshakeEvent(eventType string) bool {
+	switch eventType {
+	case "message_start", "ping", "":
+		return true
+	default:
+		return false
+	}
+}
+
+// observe records one passthrough event. It returns held=true when the event was
+// buffered, otherwise the buffered events that must be sent before it.
+func (b *claudeHandshakeBuffer) observe(eventType string, event []byte) (release [][]byte, held bool) {
+	return b.observeChunks(eventType, [][]byte{event})
+}
+
+// observeChunks records the translated chunks of one event; see observe.
+func (b *claudeHandshakeBuffer) observeChunks(eventType string, chunks [][]byte) (release [][]byte, held bool) {
+	if b == nil || !b.open {
+		return nil, false
+	}
+	if isClaudeHandshakeEvent(eventType) && len(b.chunks) < claudeHandshakeMaxBufferedEvents {
+		b.chunks = append(b.chunks, chunks...)
+		return nil, true
+	}
+	b.open = false
+	release = b.chunks
+	b.chunks = nil
+	return release, false
+}
+
+// drain releases whatever is still buffered when the stream ends.
+func (b *claudeHandshakeBuffer) drain() [][]byte {
+	if b == nil {
+		return nil
+	}
+	b.open = false
+	release := b.chunks
+	b.chunks = nil
+	return release
+}
+
+func (b *claudeHandshakeBuffer) buffered() int {
+	if b == nil {
+		return 0
+	}
+	return len(b.chunks)
+}
+
+// claudeSSEEventPayload returns the event type and JSON payload of the first
+// data line in a complete SSE event block.
+func claudeSSEEventPayload(event []byte) (string, []byte) {
+	for _, line := range bytes.Split(event, []byte("\n")) {
+		if eventType, data := claudeSSELinePayload(line); data != nil {
+			return eventType, data
+		}
+	}
+	return "", nil
+}
+
+// claudeSSELinePayload returns the event type and JSON payload of one SSE data
+// line, or ("", nil) for any other line.
+func claudeSSELinePayload(line []byte) (string, []byte) {
+	line = bytes.TrimSpace(line)
+	if !bytes.HasPrefix(line, []byte("data:")) {
+		return "", nil
+	}
+	data := bytes.TrimSpace(line[len("data:"):])
+	if !gjson.ValidBytes(data) {
+		return "", nil
+	}
+	return gjson.GetBytes(data, "type").String(), data
+}
+
+// claudeStreamErrorStatus maps an in-stream Anthropic error type onto the HTTP
+// status Anthropic uses for the same error at the HTTP level.
+func claudeStreamErrorStatus(errorType string) int {
+	switch errorType {
+	case "overloaded_error":
+		return 529
+	case "rate_limit_error":
+		return http.StatusTooManyRequests
+	case "invalid_request_error":
+		return http.StatusBadRequest
+	case "authentication_error":
+		return http.StatusUnauthorized
+	case "billing_error":
+		return http.StatusPaymentRequired
+	case "permission_error":
+		return http.StatusForbidden
+	case "not_found_error":
+		return http.StatusNotFound
+	case "request_too_large":
+		return http.StatusRequestEntityTooLarge
+	default:
+		return http.StatusInternalServerError
+	}
+}
+
+// claudeStreamErrorFromEvent turns an in-stream `error` event into the same
+// classified error an HTTP-level rejection with that status would produce, so
+// cooldown, retry-round and hold decisions do not depend on where Anthropic put
+// the rejection.
+func claudeStreamErrorFromEvent(data []byte, headers http.Header) error {
+	status := claudeStreamErrorStatus(gjson.GetBytes(data, "error.type").String())
+	return classifyClaudeUpstreamError(status, headers, bytes.Clone(data))
+}
