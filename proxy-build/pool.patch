+func TestConvertOpenAIResponsesRequestToClaude_StandaloneToolOutputBecomesUserText(t *testing.T) {
+	// Codex create_thread seeds a new thread with a function_call_output that
+	// has an id but no call_id and no preceding function_call. Claude rejects
+	// tool_result blocks without a matching tool_use, so it must degrade to text.
+	raw := []byte(`{
+		"model":"claude-test",
+		"input":[
+			{
+				"type":"function_call_output",
+				"id":"fco_seed_1",
+				"name":"create_thread",
+				"namespace":"codex_app",
+				"output":"<codex_delegation>Launched from another task.</codex_delegation>"
+			},
+			{
+				"type":"message",
+				"role":"user",
+				"content":[{"type":"input_text","text":"Reply with PROBE_OK."}]
+			}
+		]
+	}`)
+
+	out := ConvertOpenAIResponsesRequestToClaude("claude-test", raw, false)
+	root := gjson.ParseBytes(out)
+
+	if got := root.Get("messages.#").Int(); got != 1 {
+		t.Fatalf("message count = %d, want 1. Output: %s", got, string(out))
+	}
+	if got := root.Get("messages.0.role").String(); got != "user" {
+		t.Fatalf("message role = %q, want user. Output: %s", got, string(out))
+	}
+	root.Get("messages.0.content").ForEach(func(_, block gjson.Result) bool {
+		if block.Get("type").String() == "tool_result" {
+			t.Fatalf("unexpected tool_result for standalone output. Output: %s", string(out))
+		}
+		return true
+	})
+	if got := root.Get("messages.0.content.0.type").String(); got != "text" {
+		t.Fatalf("first block type = %q, want text. Output: %s", got, string(out))
+	}
+	if got := root.Get("messages.0.content.0.text").String(); got != "<codex_delegation>Launched from another task.</codex_delegation>" {
+		t.Fatalf("first block text = %q. Output: %s", got, string(out))
+	}
+	if got := root.Get("messages.0.content.1.text").String(); got != "Reply with PROBE_OK." {
+		t.Fatalf("second block text = %q. Output: %s", got, string(out))
+	}
+}
