+package management
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+)
+
+// GetOutageHolds reports the provider outage hold counters: how many requests
+// are currently held open waiting for a credential to recover and how many
+// client turns carry a live or recently spent hold budget. The supervisor shows
+// the count and the deploy script refuses to restart the proxy while it is
+// non-zero, because a restart fails every held request.
+func (h *Handler) GetOutageHolds(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "core auth manager unavailable"})
+		return
+	}
+	c.JSON(http.StatusOK, h.authManager.OutageHoldStatus())
+}
