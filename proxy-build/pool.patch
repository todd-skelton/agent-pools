+// A failed re-read (DNS not up yet after waking from sleep, 2026-10-03 21:28)
+// is retried on the short interval, not after the full refresh interval, so
+// the error clears within about a minute of the network returning.
+func TestLiveModelsFailedReReadRetriesSoon(t *testing.T) {
+	a := oauthAuth("live-codex-retry", "codex")
+	h := newLiveModelsHarness(t, "", a)
+	clock := time.Date(2026, 10, 3, 21, 13, 0, 0, time.UTC)
+	h.manager.now = func() time.Time { return clock }
+	h.lists[a.ID] = modelList("codex", "gpt-6-astra")
+	h.manager.pass(context.Background(), false)
+	clock = clock.Add(liveModelsDefaultInterval)
+	h.errs[a.ID] = errors.New("lookup chatgpt.com: i/o timeout")
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != 2 {
+		t.Fatalf("calls after failed re-read = %d", h.calls.Load())
+	}
+	delete(h.errs, a.ID)
+	clock = clock.Add(liveModelsRetryInterval / 2)
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != 2 {
+		t.Fatalf("retried before the retry interval: calls = %d", h.calls.Load())
+	}
+	clock = clock.Add(liveModelsRetryInterval / 2)
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != 3 {
+		t.Fatalf("failed re-read not retried after %s: calls = %d", liveModelsRetryInterval, h.calls.Load())
+	}
+	status, _ := livemodels.Lookup(a.ID)
+	if status.Source != livemodels.SourceLive || status.Error != "" {
+		t.Fatalf("status after recovery = %+v", status)
+	}
+	// Recovered: back on the normal interval.
+	clock = clock.Add(2 * liveModelsRetryInterval)
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != 3 {
+		t.Fatalf("recovered credential re-read early: calls = %d", h.calls.Load())
+	}
+}
