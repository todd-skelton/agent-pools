+func portableClaudeSSE(w http.ResponseWriter, stop string) {
+	w.Header().Set("Content-Type", "text/event-stream")
+	for _, event := range []string{
+		`{"type":"message_start","message":{"id":"msg_test","type":"message","role":"assistant","model":"claude-opus-5-5","content":[],"usage":{"input_tokens":100,"output_tokens":0}}}`,
+		`{"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}`,
+		`{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Checkpoint ALPHA. Pending action: verify tests."}}`,
+		`{"type":"content_block_stop","index":0}`,
+		fmt.Sprintf(`{"type":"message_delta","delta":{"stop_reason":%q},"usage":{"output_tokens":12}}`, stop),
+		`{"type":"message_stop"}`,
+	} {
+		fmt.Fprintf(w, "data: %s\n\n", event)
+	}
+}
