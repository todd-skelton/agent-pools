diff --git a/internal/clientversion/clientversion.go b/internal/clientversion/clientversion.go
new file mode 100644
index 0000000000000000000000000000000000000000..bd67cdfb30bdfcc6e162397b2ff2996dce025497
--- /dev/null
+++ b/internal/clientversion/clientversion.go
@@ -0,0 +1,226 @@
+// Package clientversion reports the versions of the locally installed client
+// applications the proxy identifies as (Claude Code, Codex). Each configured
+// binary is run with --version in the background; callers read the cached
+// result and never wait on a process, except Await, which the live model
+// fetch uses once at startup so its first request already carries the
+// installed version. A failed re-read keeps the last detected version.
+package clientversion
+
+import (
+	"context"
+	"fmt"
+	"os/exec"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Client identifies an imitated client application.
+type Client string
+
+const (
+	// ClaudeCode is Anthropic's Claude Code CLI.
+	ClaudeCode Client = "claude-code"
+	// Codex is OpenAI's Codex CLI (also bundled with the Codex desktop app).
+	Codex Client = "codex"
+)
+
+// Clients lists every supported client in a stable order.
+var Clients = []Client{ClaudeCode, Codex}
+
+const (
+	// refreshInterval re-reads each binary so auto-updates are followed.
+	refreshInterval = 6 * time.Hour
+	// retryInterval re-reads a binary whose last read failed, so one failed
+	// --version (a client mid-update, a busy machine) does not pin the compiled
+	// default for a whole refreshInterval.
+	retryInterval = time.Minute
+	// runTimeout bounds one --version run.
+	runTimeout = 15 * time.Second
+)
+
+// Status is the management view of one client.
+type Status struct {
+	Binary    string    `json:"binary,omitempty"`
+	Version   string    `json:"version,omitempty"`
+	CheckedAt time.Time `json:"checked_at,omitempty"`
+	Error     string    `json:"error,omitempty"`
+}
+
+type entry struct {
+	binary    string
+	version   string
+	checkedAt time.Time
+	err       string
+	running   bool
+	// done is closed when the first detection for binary finishes.
+	done chan struct{}
+}
+
+var (
+	mu      sync.Mutex
+	entries = map[Client]*entry{}
+
+	// Test seams.
+	runVersion = runBinaryVersion
+	now        = time.Now
+)
+
+// versionPattern takes the first dotted triple, so "2.1.284 (Claude Code)"
+// and "codex-cli 0.158.0" both yield their version; pre-release or build
+// suffixes are dropped.
+var versionPattern = regexp.MustCompile(`(?:^|[\s/v])(\d{1,4})\.(\d{1,4})\.(\d{1,6})(?:[-+][0-9A-Za-z.-]*)?(?:\s|$|\))`)
+
+// ParseVersion extracts major.minor.patch from --version output.
+func ParseVersion(output string) (string, bool) {
+	for _, line := range strings.Split(output, "\n") {
+		if m := versionPattern.FindStringSubmatch(strings.TrimSpace(line) + " "); m != nil {
+			return m[1] + "." + m[2] + "." + m[3], true
+		}
+	}
+	return "", false
+}
+
+// Configure sets the binary for each client. A changed or removed binary
+// forgets the previous version; a new binary is detected in the background.
+func Configure(binaries map[Client]string) {
+	mu.Lock()
+	defer mu.Unlock()
+	for _, client := range Clients {
+		binary := strings.TrimSpace(binaries[client])
+		current := entries[client]
+		if current != nil && current.binary == binary {
+			continue
+		}
+		if binary == "" {
+			delete(entries, client)
+			continue
+		}
+		e := &entry{binary: binary, done: make(chan struct{})}
+		entries[client] = e
+		startLocked(client, e)
+	}
+}
+
+// Version returns the detected version of client, or "" when no binary is
+// configured or none was ever detected. A stale value triggers a background
+// re-read and is returned meanwhile.
+func Version(client Client) string {
+	mu.Lock()
+	defer mu.Unlock()
+	e := entries[client]
+	if e == nil {
+		return ""
+	}
+	due := refreshInterval
+	if e.err != "" {
+		due = retryInterval
+	}
+	if !e.running && now().Sub(e.checkedAt) >= due {
+		startLocked(client, e)
+	}
+	return e.version
+}
+
+// Configured reports whether a binary is configured for client.
+func Configured(client Client) bool {
+	mu.Lock()
+	defer mu.Unlock()
+	return entries[client] != nil
+}
+
+// Await waits until the first detection for client has finished (or ctx
+// ends) and returns Version(client).
+func Await(ctx context.Context, client Client) string {
+	mu.Lock()
+	e := entries[client]
+	mu.Unlock()
+	if e == nil {
+		return ""
+	}
+	select {
+	case <-e.done:
+	case <-ctx.Done():
+	}
+	return Version(client)
+}
+
+// SetForTesting pins client to version (as if detected) and returns a
+// function restoring the previous state. Tests only.
+func SetForTesting(client Client, version string) func() {
+	mu.Lock()
+	previous, had := entries[client]
+	done := make(chan struct{})
+	close(done)
+	entries[client] = &entry{binary: "test", version: version, checkedAt: now().Add(refreshInterval), done: done}
+	mu.Unlock()
+	return func() {
+		mu.Lock()
+		defer mu.Unlock()
+		if had {
+			entries[client] = previous
+		} else {
+			delete(entries, client)
+		}
+	}
+}
+
+// Snapshot reports every configured client.
+func Snapshot() map[string]Status {
+	mu.Lock()
+	defer mu.Unlock()
+	out := make(map[string]Status, len(entries))
+	for client, e := range entries {
+		out[string(client)] = Status{Binary: e.binary, Version: e.version, CheckedAt: e.checkedAt, Error: e.err}
+	}
+	return out
+}
+
+// startLocked runs one detection for e; mu must be held.
+func startLocked(client Client, e *entry) {
+	e.running = true
+	binary, run := e.binary, runVersion
+	go func() {
+		version, err := detect(run, binary)
+		mu.Lock()
+		defer mu.Unlock()
+		e.running = false
+		e.checkedAt = now()
+		if err != nil {
+			e.err = err.Error()
+		} else {
+			e.err = ""
+			e.version = version
+		}
+		select {
+		case <-e.done:
+		default:
+			close(e.done)
+		}
+	}()
+}
+
+func detect(run func(context.Context, string) (string, error), binary string) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), runTimeout)
+	defer cancel()
+	output, err := run(ctx, binary)
+	if err != nil {
+		return "", fmt.Errorf("%s --version: %w", binary, err)
+	}
+	version, ok := ParseVersion(output)
+	if !ok {
+		return "", fmt.Errorf("%s --version printed no version", binary)
+	}
+	return version, nil
+}
+
+func runBinaryVersion(ctx context.Context, binary string) (string, error) {
+	cmd := exec.CommandContext(ctx, binary, "--version")
+	hideWindow(cmd)
+	output, err := cmd.Output()
+	if err != nil {
+		return "", err
+	}
+	return string(output), nil
+}
diff --git a/internal/clientversion/clientversion_test.go b/internal/clientversion/clientversion_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..27942d06790e9b4a14d921ad242cc7c5d37e14d8
--- /dev/null
+++ b/internal/clientversion/clientversion_test.go
@@ -0,0 +1,187 @@
+package clientversion
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func resetForTest(t *testing.T, run func(context.Context, string) (string, error)) {
+	t.Helper()
+	mu.Lock()
+	entries = map[Client]*entry{}
+	previousRun, previousNow := runVersion, now
+	runVersion = run
+	mu.Unlock()
+	t.Cleanup(func() {
+		// Let detections started by the test finish before the seams change.
+		for {
+			mu.Lock()
+			busy := false
+			for _, e := range entries {
+				busy = busy || e.running
+			}
+			if !busy {
+				entries = map[Client]*entry{}
+				runVersion, now = previousRun, previousNow
+				mu.Unlock()
+				return
+			}
+			mu.Unlock()
+			time.Sleep(time.Millisecond)
+		}
+	})
+}
+
+func TestParseVersion(t *testing.T) {
+	cases := map[string]string{
+		"2.1.284 (Claude Code)\n":   "2.1.284",
+		"codex-cli 0.158.0\n":       "0.158.0",
+		"codex-cli 0.159.0-alpha.2": "0.159.0",
+		"v26.3.0":                   "26.3.0",
+		"warning: update\n1.2.3":    "1.2.3",
+	}
+	for input, want := range cases {
+		if got, ok := ParseVersion(input); !ok || got != want {
+			t.Errorf("ParseVersion(%q) = %q, %v; want %q", input, got, ok, want)
+		}
+	}
+	for _, input := range []string{"", "Claude Code", "1.2", "build 20260928", "1.2.3.4"} {
+		if got, ok := ParseVersion(input); ok {
+			t.Errorf("ParseVersion(%q) = %q; want no version", input, got)
+		}
+	}
+}
+
+func TestConfigureDetectsAndAwaitReturnsVersion(t *testing.T) {
+	resetForTest(t, func(_ context.Context, binary string) (string, error) {
+		if binary == "claude.exe" {
+			return "2.1.284 (Claude Code)\n", nil
+		}
+		return "codex-cli 0.158.0\n", nil
+	})
+	Configure(map[Client]string{ClaudeCode: "claude.exe", Codex: "codex.exe"})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if got := Await(ctx, ClaudeCode); got != "2.1.284" {
+		t.Fatalf("claude = %q", got)
+	}
+	if got := Await(ctx, Codex); got != "0.158.0" {
+		t.Fatalf("codex = %q", got)
+	}
+	snapshot := Snapshot()
+	if snapshot["claude-code"].Binary != "claude.exe" || snapshot["codex"].Version != "0.158.0" {
+		t.Fatalf("snapshot = %+v", snapshot)
+	}
+}
+
+func TestUnconfiguredClientHasNoVersion(t *testing.T) {
+	resetForTest(t, func(context.Context, string) (string, error) { return "9.9.9", nil })
+	Configure(map[Client]string{ClaudeCode: "claude.exe"})
+	if got := Await(context.Background(), Codex); got != "" {
+		t.Fatalf("codex = %q, want empty", got)
+	}
+	Configure(nil)
+	if got := Version(ClaudeCode); got != "" {
+		t.Fatalf("removed binary still reports %q", got)
+	}
+}
+
+func TestFailedRereadKeepsLastVersionAndStaleValueTriggersReread(t *testing.T) {
+	var calls atomic.Int32
+	fail := atomic.Bool{}
+	resetForTest(t, func(context.Context, string) (string, error) {
+		calls.Add(1)
+		if fail.Load() {
+			return "", errors.New("boom")
+		}
+		return "2.1.284 (Claude Code)", nil
+	})
+	var clock atomic.Int64
+	clock.Store(time.Date(2026, 9, 28, 12, 0, 0, 0, time.UTC).UnixNano())
+	mu.Lock()
+	now = func() time.Time { return time.Unix(0, clock.Load()) }
+	mu.Unlock()
+	Configure(map[Client]string{ClaudeCode: "claude.exe"})
+	if got := Await(context.Background(), ClaudeCode); got != "2.1.284" {
+		t.Fatalf("first read = %q", got)
+	}
+	fail.Store(true)
+	clock.Add(int64(refreshInterval + time.Minute))
+	if got := Version(ClaudeCode); got != "2.1.284" {
+		t.Fatalf("stale read returned %q, want last version while re-reading", got)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		status := Snapshot()["claude-code"]
+		if status.Error != "" {
+			if status.Version != "2.1.284" {
+				t.Fatalf("failed re-read lost version: %+v", status)
+			}
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("re-read never ran")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if calls.Load() != 2 {
+		t.Fatalf("calls = %d, want 2", calls.Load())
+	}
+}
+
+// A failed first read (2026-11-03: codex.exe --version exited 1 once at proxy
+// start) is retried after retryInterval, not refreshInterval, so the installed
+// version replaces the compiled default within minutes.
+func TestFailedFirstReadIsRetriedSoon(t *testing.T) {
+	var calls atomic.Int32
+	resetForTest(t, func(context.Context, string) (string, error) {
+		if calls.Add(1) == 1 {
+			return "", errors.New("exit status 1")
+		}
+		return "codex-cli 0.166.0", nil
+	})
+	var clock atomic.Int64
+	clock.Store(time.Date(2026, 11, 3, 20, 23, 0, 0, time.UTC).UnixNano())
+	mu.Lock()
+	now = func() time.Time { return time.Unix(0, clock.Load()) }
+	mu.Unlock()
+	Configure(map[Client]string{Codex: "codex.exe"})
+	if got := Await(context.Background(), Codex); got != "" {
+		t.Fatalf("failed read = %q, want none", got)
+	}
+	clock.Add(int64(retryInterval - time.Second))
+	if got := Version(Codex); got != "" || calls.Load() != 1 {
+		t.Fatalf("retried early: version %q after %d calls", got, calls.Load())
+	}
+	clock.Add(int64(2 * time.Second))
+	deadline := time.Now().Add(5 * time.Second)
+	for Version(Codex) != "0.166.0" {
+		if time.Now().After(deadline) {
+			t.Fatalf("not re-read after retryInterval: %+v (calls %d)", Snapshot()["codex"], calls.Load())
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if status := Snapshot()["codex"]; status.Error != "" {
+		t.Fatalf("error kept after a good read: %+v", status)
+	}
+}
+
+func TestChangedBinaryForgetsPreviousVersion(t *testing.T) {
+	resetForTest(t, func(_ context.Context, binary string) (string, error) {
+		if binary == "old.exe" {
+			return "2.1.280", nil
+		}
+		return "", errors.New("missing")
+	})
+	Configure(map[Client]string{ClaudeCode: "old.exe"})
+	if got := Await(context.Background(), ClaudeCode); got != "2.1.280" {
+		t.Fatalf("old = %q", got)
+	}
+	Configure(map[Client]string{ClaudeCode: "new.exe"})
+	if got := Await(context.Background(), ClaudeCode); got != "" {
+		t.Fatalf("new binary inherited %q", got)
+	}
+}
