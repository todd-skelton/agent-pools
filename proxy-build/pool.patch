+package management
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/clientversion"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/livemodels"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+)
+
+// clientVersionReport is one client's detected and presented identity.
+type clientVersionReport struct {
+	clientversion.Status
+	// Effective is the version the proxy presents upstream: the detected
+	// version, a configured override, or the compiled default.
+	Effective string `json:"effective"`
+}
+
+// GetClientVersions reports the installed client versions the proxy
+// identifies with (installed-clients) and the versions it presents, so the
+// supervisor can identify its own provider reads the same way.
+func (h *Handler) GetClientVersions(c *gin.Context) {
+	detected := clientversion.Snapshot()
+	_, _, codexVersion := executor.CodexClientIdentity()
+	c.JSON(http.StatusOK, gin.H{"clients": gin.H{
+		string(clientversion.ClaudeCode): clientVersionReport{Status: detected[string(clientversion.ClaudeCode)], Effective: helps.DefaultClaudeVersion(h.cfg)},
+		string(clientversion.Codex):      clientVersionReport{Status: detected[string(clientversion.Codex)], Effective: codexVersion},
+	}})
+}
+
+// RefreshLiveModels starts an immediate read of every credential's live
+// model list. The reads finish in the background; auth-files reports each
+// credential's live_models status.
+func (h *Handler) RefreshLiveModels(c *gin.Context) {
+	if !livemodels.Refresh() {
+		c.JSON(http.StatusConflict, gin.H{"error": "live model lists are not running"})
+		return
+	}
+	c.JSON(http.StatusAccepted, gin.H{"started": true})
+}
