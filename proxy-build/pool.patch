 }
+
+// codexFatalOverloadCodes are the error codes the Codex client treats as a
+// non-retryable ServerOverloaded failure. The client gives the turn up on the
+// first occurrence, so a pooled proxy that has already tried every credential
+// must not forward them: the same condition expressed as a generic 5xx is
+// retried by the client's request_max_retries and stream_max_retries.
+var codexFatalOverloadCodes = map[string]struct{}{
+	"server_is_overloaded": {},
+	"slow_down":            {},
+}
+
+// codexUsageLimitTypes are the 429 shapes Codex understands and reports to the
+// user with a reset time. Every other 429 makes the client fail the turn without
+// a retry, so those are presented as a retryable 5xx instead.
+var codexUsageLimitTypes = map[string]struct{}{
+	"usage_limit_reached": {},
+	"usage_not_included":  {},
+}
+
+func codexErrorDetailString(detail map[string]any, key string) string {
+	if detail == nil {
+		return ""
+	}
+	if v, ok := detail[key].(string); ok {
+		return strings.ToLower(strings.TrimSpace(v))
+	}
+	return ""
+}
+
+// ShapeCodexErrorDetail rewrites an error detail so an official Codex client
+// retries instead of failing the turn. Overload codes become a generic server
+// error and a 429 that is not a usage-limit shape becomes a 503. The message is
+// kept. The returned status is the one to put on the wire.
+func ShapeCodexErrorDetail(status int, detail map[string]any) (int, map[string]any) {
+	if detail == nil {
+		return status, detail
+	}
+	code := codexErrorDetailString(detail, "code")
+	errType := codexErrorDetailString(detail, "type")
+	if _, fatal := codexFatalOverloadCodes[code]; fatal {
+		shaped := cloneErrorDetail(detail)
+		shaped["code"] = "internal_server_error"
+		shaped["type"] = "server_error"
+		if status < http.StatusInternalServerError {
+			status = http.StatusServiceUnavailable
+		}
+		return status, shaped
+	}
+	if status == http.StatusTooManyRequests || code == "rate_limit_exceeded" || errType == "rate_limit_error" {
+		if _, usage := codexUsageLimitTypes[errType]; usage {
+			return status, detail
+		}
+		if _, usage := codexUsageLimitTypes[code]; usage {
+			return status, detail
+		}
+		shaped := cloneErrorDetail(detail)
+		shaped["code"] = "internal_server_error"
+		shaped["type"] = "server_error"
+		if message, ok := shaped["message"].(string); ok && !strings.HasPrefix(message, "upstream rate limited") {
+			shaped["message"] = "upstream rate limited, retry later: " + message
+		}
+		return http.StatusServiceUnavailable, shaped
+	}
+	return status, detail
+}
+
+func cloneErrorDetail(detail map[string]any) map[string]any {
+	cloned := make(map[string]any, len(detail)+1)
+	for k, v := range detail {
+		cloned[k] = v
+	}
+	return cloned
+}
+
+// ShapeCodexErrorMessage applies ShapeCodexErrorDetail to an error that is about
+// to be written as a JSON body before any stream frame was sent.
+func ShapeCodexErrorMessage(errMsg *interfaces.ErrorMessage) *interfaces.ErrorMessage {
+	if errMsg == nil || errMsg.DirectResponse {
+		return errMsg
+	}
+	status := errMsg.StatusCode
+	if status <= 0 {
+		status = http.StatusInternalServerError
+	}
+	text := ""
+	if errMsg.Error != nil {
+		text = strings.TrimSpace(errMsg.Error.Error())
+	}
+	var detail map[string]any
+	if text != "" && json.Valid([]byte(text)) {
+		var payload map[string]any
+		if errUnmarshal := unmarshalJSONWithNumber([]byte(text), &payload); errUnmarshal == nil {
+			detail, _ = payload["error"].(map[string]any)
+		}
+	}
+	if detail == nil {
+		code := openAIResponsesStreamErrorCode(status)
+		message := text
+		if message == "" {
+			message = http.StatusText(status)
+		}
+		detail = openAIResponsesStreamErrorDetail(status, text, code, message)
+	}
+	shapedStatus, shaped := ShapeCodexErrorDetail(status, detail)
+	if shapedStatus == status && sameErrorDetail(shaped, detail) {
+		return errMsg
+	}
+	body, errMarshal := json.Marshal(map[string]any{"error": shaped})
+	if errMarshal != nil {
+		return errMsg
+	}
+	out := *errMsg
+	out.StatusCode = shapedStatus
+	out.Error = &codexShapedError{message: string(body), cause: errMsg.Error}
+	return &out
+}
+
+func sameErrorDetail(a, b map[string]any) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if fmt.Sprint(b[k]) != fmt.Sprint(v) {
+			return false
+		}
+	}
+	return true
+}
+
+type codexShapedError struct {
+	message string
+	cause   error
+}
+
+func (e *codexShapedError) Error() string { return e.message }
+func (e *codexShapedError) Unwrap() error { return e.cause }
