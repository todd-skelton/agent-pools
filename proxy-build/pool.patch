+// Signed requests are re-signed after stripping, so the resend carries a CCH
+// computed over its own bytes and gets a fresh client request id.
+func TestSearchProvenanceResendIsResigned(t *testing.T) {
+	var bodies [][]byte
+	var ids []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		bodies = append(bodies, body)
+		ids = append(ids, r.Header.Get("x-client-request-id"))
+		if len(bodies) == 1 {
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(claudeCitationRejection))
+			return
+		}
+		_, _ = w.Write([]byte(`{}`))
+	}))
+	defer server.Close()
+
+	unsigned := []byte(strings.Replace(string(searchHistoryBody(false)), `"messages":[`, `"system":[{"type":"text","text":"x-anthropic-billing-header: cc_version=2.1.220.test; cc_entrypoint=sdk-cli; cch=00000;"}],"messages":[`, 1))
+	signed, err := signAnthropicMessagesBody(unsigned)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req, _ := http.NewRequest(http.MethodPost, server.URL, bytes.NewReader(signed))
+	req.Header.Set("x-client-request-id", "first-id")
+	resp, err := doClaudeUpstreamRequestWithSearchProvenanceRecovery(context.Background(), &config.Config{}, server.Client(), req, &cliproxyauth.Auth{ID: "resign"}, signed, true, helps.UpstreamRequestLog{})
+	if err != nil || resp.StatusCode != http.StatusOK {
+		t.Fatalf("resend failed: %v", err)
+	}
+	_ = resp.Body.Close()
+	if len(bodies) != 2 {
+		t.Fatalf("requests = %d", len(bodies))
+	}
+	// Built from the unsigned original: the resend must equal signing the
+	// stripped history from scratch, whatever CCH the first attempt carried.
+	stripped, _ := stripClaudeSearchProvenance(unsigned)
+	want, _ := signAnthropicMessagesBody(stripped)
+	if !bytes.Equal(bodies[1], want) {
+		t.Fatalf("resend body is not the stripped body signed afresh:\n got: %s\nwant: %s", bodies[1], want)
+	}
+	if gjson.GetBytes(bodies[1], "system.0.text").String() == gjson.GetBytes(signed, "system.0.text").String() {
+		t.Fatal("resend kept the original CCH")
+	}
+	if ids[0] != "first-id" || ids[1] == "" || ids[1] == "first-id" {
+		t.Fatalf("client request ids = %q, want a fresh id on the resend", ids)
+	}
+}
