+// setupOutagePool builds a pool of `credentials` healthy credentials whose
+// transient cooldown is 1 s and whose ordinary retry round is too short
+// (max-retry-interval 300 ms) to cover that cooldown, so the ordinary rounds
+// give up and the hold engine takes over.
+func setupOutagePool(t *testing.T, credentials int, executor *outageExecutor, hold OutageHoldConfig) *Manager {
+	t.Helper()
+	prevTransient := transientErrorCooldownSeconds.Load()
+	transientErrorCooldownSeconds.Store(1)
+	t.Cleanup(func() { transientErrorCooldownSeconds.Store(prevTransient) })
+
+	manager := NewManager(nil, nil, nil)
+	manager.SetRetryConfig(1, 300*time.Millisecond, 3)
+	manager.SetOutageHoldConfig(hold)
+	manager.RegisterExecutor(executor)
+	reg := registry.GetGlobalRegistry()
+	for i := 0; i < credentials; i++ {
+		auth := &Auth{ID: holdTestProvider + "-" + string(rune('a'+i)), Provider: holdTestProvider, Status: StatusActive}
+		reg.RegisterClient(auth.ID, holdTestProvider, []*registry.ModelInfo{{ID: holdTestModel}})
+		id := auth.ID
+		t.Cleanup(func() { reg.UnregisterClient(id) })
+		if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+			t.Fatalf("register %s: %v", auth.ID, errRegister)
+		}
+	}
+	return manager
+}
+
+func holdOptions(turnID string) cliproxyexecutor.Options {
+	headers := http.Header{}
+	headers.Set("User-Agent", "codex_cli_rs/0.154.0 (Windows 11; x86_64) WindowsTerminal")
+	if turnID != "" {
+		headers.Set("X-Codex-Turn-Metadata", `{"turn_id":"`+turnID+`","prompt_cache_key":"k"}`)
+	}
+	return cliproxyexecutor.Options{Stream: true, Headers: headers}
+}
