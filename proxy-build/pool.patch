+// repairClaudeToolPairing enforces the Anthropic invariant that every
+// assistant tool_use is answered by a tool_result at the start of the very
+// next user message. Two histories break it in practice: a session that died
+// while a tool was running (tool_use with no output at all) and standalone
+// context injected ahead of a real tool output (text before tool_result).
+// Missing results are synthesized as errors so the model can carry on.
+func repairClaudeToolPairing(messages [][]byte) [][]byte {
+	if len(messages) == 0 {
+		return messages
+	}
+	out := make([][]byte, 0, len(messages)+1)
+	for i := 0; i < len(messages); i++ {
+		msg := messages[i]
+		out = append(out, msg)
+		if gjson.GetBytes(msg, "role").String() != "assistant" {
+			continue
+		}
+		var toolUseIDs []string
+		gjson.GetBytes(msg, "content").ForEach(func(_, block gjson.Result) bool {
+			if block.Get("type").String() == "tool_use" {
+				if id := block.Get("id").String(); id != "" {
+					toolUseIDs = append(toolUseIDs, id)
+				}
+			}
+			return true
+		})
+		if len(toolUseIDs) == 0 {
+			continue
+		}
+
+		hasNextUser := i+1 < len(messages) && gjson.GetBytes(messages[i+1], "role").String() == "user"
+		answered := map[string]struct{}{}
+		var resultParts, otherParts [][]byte
+		needsReorder := false
+		if hasNextUser {
+			content := gjson.GetBytes(messages[i+1], "content")
+			if content.IsArray() {
+				seenOther := false
+				content.ForEach(func(_, block gjson.Result) bool {
+					raw := []byte(block.Raw)
+					if block.Get("type").String() == "tool_result" {
+						answered[block.Get("tool_use_id").String()] = struct{}{}
+						resultParts = append(resultParts, raw)
+						if seenOther {
+							needsReorder = true
+						}
+					} else {
+						seenOther = true
+						otherParts = append(otherParts, raw)
+					}
+					return true
+				})
+			} else if content.Type == gjson.String {
+				textPart := []byte(`{"type":"text","text":""}`)
+				textPart, _ = sjson.SetBytes(textPart, "text", content.String())
+				otherParts = append(otherParts, textPart)
+			}
+		}
+
+		var synthesized [][]byte
+		for _, id := range toolUseIDs {
+			if _, ok := answered[id]; ok {
+				continue
+			}
+			part := []byte(`{"type":"tool_result","tool_use_id":"","is_error":true,"content":"Tool call was interrupted before any output was recorded."}`)
+			part, _ = sjson.SetBytes(part, "tool_use_id", id)
+			synthesized = append(synthesized, part)
+		}
+		if len(synthesized) == 0 && !needsReorder {
+			continue
+		}
+
+		parts := make([][]byte, 0, len(synthesized)+len(resultParts)+len(otherParts))
+		parts = append(parts, synthesized...)
+		parts = append(parts, resultParts...)
+		parts = append(parts, otherParts...)
+		userMsg := []byte(`{"role":"user","content":[]}`)
+		userMsg, _ = sjson.SetRawBytes(userMsg, "content", common.JoinRawArray(parts))
+		if hasNextUser {
+			messages[i+1] = userMsg
+		} else {
+			out = append(out, userMsg)
+		}
+	}
+	return out
+}
