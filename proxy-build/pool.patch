@@ -0,0 +1,53 @@
+package auth
+
+import (
+	"context"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+// A tool route (an image model behind the Codex images endpoint) is on no
+// credential's model list. It must still reach an account credential when a
+// plugin scheduler delegates to the model-sharded built-in scheduler, and it
+// must never reach an API key.
+func TestToolRouteSelectsAccountCredentialThroughPluginDelegation(t *testing.T) {
+	reg := registry.GetGlobalRegistry()
+	for _, id := range []string{"tool-route-account", "tool-route-apikey"} {
+		reg.RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt-5.5"}})
+		authID := id
+		t.Cleanup(func() { reg.UnregisterClient(authID) })
+	}
+	for _, withPlugin := range []bool{false, true} {
+		manager := NewManager(nil, &FillFirstSelector{}, nil)
+		manager.executors["codex"] = schedulerTestExecutor{}
+		if _, err := manager.Register(context.Background(), &Auth{ID: "tool-route-apikey", Provider: "codex", Attributes: map[string]string{AttributeAPIKey: "sk-test"}}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := manager.Register(context.Background(), &Auth{ID: "tool-route-account", Provider: "codex", Metadata: map[string]any{"access_token": "t", "refresh_token": "r"}}); err != nil {
+			t.Fatal(err)
+		}
+		if withPlugin {
+			manager.SetPluginScheduler(&fakePluginScheduler{
+				resp:    pluginapi.SchedulerPickResponse{Handled: true, DelegateBuiltin: pluginapi.SchedulerBuiltinRoundRobin},
+				handled: true,
+			})
+		}
+		opts := cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.ToolRouteMetadataKey: true}}
+		for i := 0; i < 3; i++ {
+			got, _, err := manager.pickNext(context.Background(), "codex", "gpt-image-2", opts, nil)
+			if err != nil {
+				t.Fatalf("plugin=%v: pickNext error = %v", withPlugin, err)
+			}
+			if got == nil || got.ID != "tool-route-account" {
+				t.Fatalf("plugin=%v: picked %v, want the account credential", withPlugin, got)
+			}
+		}
+		// Without the tool route the unlisted model is not routable.
+		if got, _, err := manager.pickNext(context.Background(), "codex", "gpt-image-2", cliproxyexecutor.Options{}, nil); err == nil {
+			t.Fatalf("plugin=%v: non-tool request for an unlisted model picked %v", withPlugin, got)
+		}
+	}
+}
