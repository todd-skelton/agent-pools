+// foreignAccountUpstream behaves like a Claude account that did not create the
+// search history: it refuses any request still carrying encrypted search data.
+type foreignAccountUpstream struct {
+	mu     sync.Mutex
+	bodies [][]byte
+	reject string
+	gzip   bool
+}
+
+func (u *foreignAccountUpstream) handler() http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		u.mu.Lock()
+		u.bodies = append(u.bodies, body)
+		u.mu.Unlock()
+		if bytes.Contains(body, []byte("encrypted_content")) || bytes.Contains(body, []byte("encrypted_index")) {
+			w.Header().Set("Content-Type", "application/json")
+			payload := []byte(u.reject)
+			if u.gzip {
+				var buf bytes.Buffer
+				zw := gzip.NewWriter(&buf)
+				_, _ = zw.Write(payload)
+				_ = zw.Close()
+				payload = buf.Bytes()
+				w.Header().Set("Content-Encoding", "gzip")
+			}
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write(payload)
+			return
+		}
+		if gjson.GetBytes(body, "stream").Bool() {
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = w.Write([]byte(claudeStreamMessageStart + claudeStreamContent + "event: message_stop\n" + `data: {"type":"message_stop"}` + "\n\n"))
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"id":"msg_1","type":"message","role":"assistant","model":"claude-opus-5","content":[{"type":"text","text":"OK"}],"stop_reason":"end_turn","usage":{"input_tokens":3,"output_tokens":1}}`))
+	}
+}
+
+func (u *foreignAccountUpstream) requests() [][]byte {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return append([][]byte(nil), u.bodies...)
+}
+
+func claudePassthroughOptions(stream bool) cliproxyexecutor.Options {
+	return cliproxyexecutor.Options{Stream: stream, SourceFormat: sdktranslator.FromString("claude"), ResponseFormat: sdktranslator.FromString("claude")}
+}
+
+func runClaudeStream(t *testing.T, executor *ClaudeExecutor, auth *cliproxyauth.Auth, payload []byte) (string, error) {
+	t.Helper()
+	result, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{Model: "claude-opus-5", Payload: payload}, claudePassthroughOptions(true))
+	if err != nil {
+		return "", err
+	}
+	var out strings.Builder
+	var streamErr error
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			streamErr = chunk.Err
+			continue
+		}
+		out.Write(chunk.Payload)
+	}
+	return out.String(), streamErr
+}
