+func TestOutageHoldWaitsThroughOutageAndRecovers(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		stream bool
+	}{
+		{name: "stream 503", status: http.StatusServiceUnavailable, stream: true},
+		{name: "stream 529", status: anthropicOverloadedStatus, stream: true},
+		{name: "non-stream 502", status: http.StatusBadGateway, stream: false},
+		// A bare rate limit cools only the credential that returned it (quota
+		// backoff from 1 s), so the turn is held until a credential recovers.
+		{name: "stream 429 rate limit", status: http.StatusTooManyRequests, stream: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			executor := &outageExecutor{identifier: holdTestProvider, status: tc.status, until: time.Now().Add(1500 * time.Millisecond)}
+			manager := setupOutagePool(t, 2, executor, OutageHoldConfig{Enabled: true, MaxWait: 20 * time.Second, ProbeInterval: 100 * time.Millisecond})
+			started := time.Now()
+			var err error
+			if tc.stream {
+				_, err = manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-1"))
+			} else {
+				_, err = manager.Execute(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-1"))
+			}
+			elapsed := time.Since(started)
+			if err != nil {
+				t.Fatalf("request during outage failed after %v: %v", elapsed, err)
+			}
+			if elapsed < 1400*time.Millisecond {
+				t.Fatalf("request returned in %v; it should have been held until the outage ended (~1.5s)", elapsed)
+			}
+			if elapsed > 6*time.Second {
+				t.Fatalf("request took %v; recovery should be noticed within a couple of cooldowns", elapsed)
+			}
+			if calls := executor.callCount(); calls < 3 {
+				t.Fatalf("executor calls = %d, want the initial round plus at least one probe", calls)
+			}
+			status := manager.OutageHoldStatus()
+			if status.Active != 0 || status.Turns != 0 {
+				t.Fatalf("hold bookkeeping not cleared after recovery: %+v", status)
+			}
+		})
+	}
+}
