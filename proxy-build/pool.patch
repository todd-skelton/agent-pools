+package openai
+
+import (
+	"github.com/tidwall/gjson"
+	"strings"
+	"testing"
+)
+
+func TestPortableCompactionReplayReplacesUnsupportedBackendHistory(t *testing.T) {
+	previous := []byte(`{"model":"claude-opus-5-5","instructions":"base","input":[{"type":"message","role":"user","content":"STALE"},{"type":"compaction_trigger"}]}`)
+	output := []byte(`[{"type":"compaction","encrypted_content":"pool-compact-v1:test:opaque"}]`)
+	replay := []byte(`{"type":"response.create","model":"claude-opus-5-5","input":[{"type":"message","role":"user","content":"retained"},{"type":"compaction","encrypted_content":"pool-compact-v1:test:opaque"},{"type":"message","role":"user","content":"LATEST"}]}`)
+	got, _, err := normalizeResponsesWebsocketRequestWithMode(replay, previous, output, false, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(got), "STALE") || strings.Contains(string(got), "compaction_trigger") || gjson.GetBytes(got, "input.#").Int() != 3 {
+		t.Fatalf("stale transcript merged: %s", got)
+	}
+	if gjson.GetBytes(got, "instructions").String() != "base" {
+		t.Fatal("lost base instructions")
+	}
+}
