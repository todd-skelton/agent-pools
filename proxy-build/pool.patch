+package auth
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+)
+
+func quotaRecoveryFixture(t *testing.T) (*Manager, *Auth, time.Time) {
+	t.Helper()
+	now := time.Now()
+	cutoff := now.Add(-time.Second)
+	old := now.Add(-time.Minute)
+	next := now.Add(time.Hour)
+	quota := QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: next}
+	a := &Auth{ID: "recovery", Provider: "codex", Generation: 10, Status: StatusError, Unavailable: true,
+		UpdatedAt: old, NextRetryAfter: next, Quota: quota, LastError: &Error{HTTPStatus: 429},
+		ModelStates: map[string]*ModelState{
+			"old-quota":  {Status: StatusError, Unavailable: true, UpdatedAt: old, NextRetryAfter: next, Quota: quota, LastError: &Error{HTTPStatus: 429}},
+			"transport":  {Status: StatusError, Unavailable: true, UpdatedAt: old, NextRetryAfter: next, LastError: &Error{HTTPStatus: 502}},
+			"auth-error": {Status: StatusError, Unavailable: true, UpdatedAt: old, NextRetryAfter: next, LastError: &Error{HTTPStatus: 401}},
+			"new-quota":  {Status: StatusError, Unavailable: true, UpdatedAt: now, NextRetryAfter: next, Quota: quota, LastError: &Error{HTTPStatus: 429}},
+		},
+	}
+	m := NewManager(nil, nil, nil)
+	m.auths[a.ID] = a
+	return m, a, cutoff
+}
+
+func TestRecoverQuotaPreservesNonQuotaAndNewerFailures(t *testing.T) {
+	m, a, cutoff := quotaRecoveryFixture(t)
+	updated, changed, errRecover := m.RecoverQuota(t.Context(), a.ID, a.Generation, cutoff)
+	if errRecover != nil || !changed {
+		t.Fatalf("changed=%v error=%v", changed, errRecover)
+	}
+	if updated.Quota.Reason == "credential_quota" {
+		t.Fatal("old credential quota was not cleared")
+	}
+	if updated.ModelStates["old-quota"].Unavailable {
+		t.Fatal("old model quota was not cleared")
+	}
+	for _, model := range []string{"transport", "auth-error", "new-quota"} {
+		if !updated.ModelStates[model].Unavailable || updated.ModelStates[model].LastError == nil {
+			t.Fatalf("erased %s failure", model)
+		}
+	}
+	if updated.Generation != 11 {
+		t.Fatalf("generation=%d", updated.Generation)
+	}
+}
+
+func TestRecoverQuotaConflictIsAtomic(t *testing.T) {
+	m, a, cutoff := quotaRecoveryFixture(t)
+	expected := a.Generation
+	m.mu.Lock()
+	a.Generation++
+	m.mu.Unlock()
+	_, changed, errRecover := m.RecoverQuota(t.Context(), a.ID, expected, cutoff)
+	if !errors.Is(errRecover, ErrQuotaRecoveryConflict) || changed {
+		t.Fatalf("changed=%v error=%v", changed, errRecover)
+	}
+	if !a.ModelStates["old-quota"].Unavailable {
+		t.Fatal("conflict mutated state")
+	}
+}
+
+func TestRecoverQuotaPreservesCredentialTransportFailure(t *testing.T) {
+	m, a, cutoff := quotaRecoveryFixture(t)
+	a.LastError = &Error{HTTPStatus: 502}
+	a.Quota = QuotaState{}
+	next := a.NextRetryAfter
+	updated, _, errRecover := m.RecoverQuota(t.Context(), a.ID, a.Generation, cutoff)
+	if errRecover != nil {
+		t.Fatal(errRecover)
+	}
+	if updated.LastError == nil || updated.LastError.HTTPStatus != 502 || !updated.Unavailable || !updated.NextRetryAfter.Equal(next) {
+		t.Fatal("credential transport failure changed")
+	}
+}
+
+func TestRoutingObservationIgnoresExpiredModelBlocks(t *testing.T) {
+	now := time.Now()
+	a := &Auth{ID: "expired", Status: StatusActive, ModelStates: map[string]*ModelState{
+		"expired-model": {Unavailable: true, NextRetryAfter: now.Add(-time.Second), Quota: QuotaState{Exceeded: true, NextRecoverAt: now.Add(-time.Second)}},
+		"blocked-model": {Unavailable: true, NextRetryAfter: now.Add(time.Hour)},
+	}}
+	registry.GetGlobalRegistry().RegisterClient(a.ID, "codex", []*registry.ModelInfo{{ID: "expired-model"}, {ID: "blocked-model"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(a.ID) })
+	observed := RoutingObservationForAuth(a, now)
+	if observed.Status != "ready" || observed.Models["expired-model"].Status != "ready" || observed.Models["blocked-model"].Status != "blocked" {
+		t.Fatalf("observation=%+v", observed)
+	}
+}
+
+// The observation lists what the credential routes. A per-model state for a
+// name it does not route (an image tool call, a model that left its live list)
+// is not an available model; a blocked one is reported as unlisted.
+func TestRoutingObservationListsOnlyRegisteredModels(t *testing.T) {
+	now := time.Now()
+	a := &Auth{ID: "observed-registered", Provider: "codex", Status: StatusActive, ModelStates: map[string]*ModelState{
+		"gpt-image-2":   {Status: StatusActive},
+		"retired-model": {Unavailable: true, NextRetryAfter: now.Add(time.Hour), Quota: QuotaState{Exceeded: true, Reason: "quota", NextRecoverAt: now.Add(time.Hour)}},
+		"live-model":    {Unavailable: true, NextRetryAfter: now.Add(time.Hour)},
+	}}
+	registry.GetGlobalRegistry().RegisterClient(a.ID, "codex", []*registry.ModelInfo{{ID: "live-model"}, {ID: "other-live"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(a.ID) })
+	observed := RoutingObservationForAuth(a, now)
+	if len(observed.Models) != 2 || observed.Models["live-model"].Status != "blocked" || observed.Models["other-live"].Status != "ready" {
+		t.Fatalf("models=%+v", observed.Models)
+	}
+	if len(observed.Unlisted) != 1 || observed.Unlisted["retired-model"].Status != "blocked" {
+		t.Fatalf("unlisted=%+v", observed.Unlisted)
+	}
+	if !observed.QuotaBlocked {
+		t.Fatal("quota block on an unlisted state must still be reported")
+	}
+}
+
+func TestRecoverQuotaRejectsDisabledAndStaleObservations(t *testing.T) {
+	for _, disabled := range []bool{true, false} {
+		m, a, cutoff := quotaRecoveryFixture(t)
+		a.Disabled = disabled
+		if !disabled {
+			cutoff = time.Now().Add(-2 * time.Minute)
+		}
+		_, changed, errRecover := m.RecoverQuota(t.Context(), a.ID, a.Generation, cutoff)
+		if !errors.Is(errRecover, ErrQuotaRecoveryConflict) || changed {
+			t.Fatalf("changed=%v error=%v", changed, errRecover)
+		}
+	}
+}
