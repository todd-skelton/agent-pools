diff --git a/sdk/api/handlers/openai_responses_compaction_error.go b/sdk/api/handlers/openai_responses_compaction_error.go
new file mode 100644
index 0000000000000000000000000000000000000000..fbc82e2d9171704b059ccf3bc662c84b49434bc3
--- /dev/null
+++ b/sdk/api/handlers/openai_responses_compaction_error.go
@@ -0,0 +1,95 @@
+package handlers
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/interfaces"
+	"github.com/tidwall/gjson"
+)
+
+// Codex tries the outgoing model first when its compaction hash changes. Only
+// that pre-turn switch may escape a pool quota wait; ordinary context-limit and
+// manual compaction must retain retry/auto-continue behavior.
+func isModelSwitchCompaction(rawJSON []byte) bool {
+	if !json.Valid(rawJSON) || gjson.GetBytes(rawJSON, "generate").Raw == "false" {
+		return false
+	}
+	metadata := gjson.GetBytes(rawJSON, "client_metadata.x-codex-turn-metadata")
+	if metadata.Type != gjson.String || !json.Valid([]byte(metadata.String())) {
+		return false
+	}
+	turn := gjson.Parse(metadata.String())
+	if turn.Get("request_kind").String() != "compaction" ||
+		turn.Get("compaction.trigger").String() != "auto" ||
+		turn.Get("compaction.reason").String() != "comp_hash_changed" ||
+		turn.Get("compaction.phase").String() != "pre_turn" ||
+		turn.Get("compaction.implementation").String() != "responses_compaction_v2" {
+		return false
+	}
+	input := gjson.GetBytes(rawJSON, "input")
+	if !input.IsArray() {
+		return false
+	}
+	for _, item := range input.Array() {
+		if item.Get("type").String() == "compaction_trigger" {
+			return true
+		}
+	}
+	return false
+}
+
+func shapeModelSwitchCompactionError(rawJSON []byte, msg *interfaces.ErrorMessage) *interfaces.ErrorMessage {
+	if msg == nil || msg.DirectResponse || msg.StatusCode != http.StatusTooManyRequests || !isModelSwitchCompaction(rawJSON) {
+		return msg
+	}
+	// The selector emits this typed marker only when all candidates are quota
+	// blocked. Do not infer exhausted usage from an arbitrary upstream 429/body.
+	var cooldown interface {
+		IsModelCooldown() bool
+		Error() string
+	}
+	if !errors.As(msg.Error, &cooldown) || !cooldown.IsModelCooldown() {
+		return msg
+	}
+	var payload struct {
+		Error map[string]any `json:"error"`
+	}
+	if err := unmarshalJSONWithNumber([]byte(cooldown.Error()), &payload); err != nil || payload.Error["code"] != "model_cooldown" {
+		return msg
+	}
+	seconds, ok := payload.Error["reset_seconds"].(json.Number)
+	if !ok {
+		return msg
+	}
+	reset, err := seconds.Int64()
+	if err != nil || reset < 0 {
+		return msg
+	}
+	payload.Error["type"] = "usage_limit_reached"
+	payload.Error["resets_in_seconds"] = seconds
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return msg
+	}
+	out := *msg
+	out.Error = &modelSwitchCompactionQuotaError{message: string(body), cause: msg.Error}
+	return &out
+}
+
+type modelSwitchCompactionQuotaError struct {
+	message string
+	cause   error
+}
+
+func (e *modelSwitchCompactionQuotaError) Error() string   { return e.message }
+func (e *modelSwitchCompactionQuotaError) Unwrap() error   { return e.cause }
+func (e *modelSwitchCompactionQuotaError) StatusCode() int { return http.StatusTooManyRequests }
+
+// IsModelSwitchCompactionQuotaError permits only the request-scoped fallback
+// error to reach a WebSocket client instead of the normal silent quota replay.
+func IsModelSwitchCompactionQuotaError(err error) bool {
+	var quota *modelSwitchCompactionQuotaError
+	return errors.As(err, &quota)
+}
diff --git a/sdk/api/handlers/openai_responses_compaction_error_test.go b/sdk/api/handlers/openai_responses_compaction_error_test.go
