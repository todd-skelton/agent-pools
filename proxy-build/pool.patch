+func TestOutageHoldEndsWhenClientAborts(t *testing.T) {
+	executor := &outageExecutor{identifier: holdTestProvider, status: http.StatusServiceUnavailable, until: time.Now().Add(time.Hour)}
+	manager := setupOutagePool(t, 1, executor, OutageHoldConfig{Enabled: true, MaxWait: 30 * time.Second, ProbeInterval: 100 * time.Millisecond})
+	ctx, cancel := context.WithCancel(context.Background())
+	go func() {
+		time.Sleep(400 * time.Millisecond)
+		cancel()
+	}()
+	started := time.Now()
+	_, err := manager.ExecuteStream(ctx, []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-abort"))
+	elapsed := time.Since(started)
+	if err == nil {
+		t.Fatal("expected an error after the client aborted")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("error = %v, want context.Canceled", err)
+	}
+	if elapsed > 1500*time.Millisecond {
+		t.Fatalf("hold ended %v after start, want within ~1s of the abort", elapsed)
+	}
+	if got := manager.OutageHoldStatus(); got.Active != 0 {
+		t.Fatalf("hold left active after abort: %+v", got)
+	}
+}
+
+func TestOutageHoldSingleProberPerModel(t *testing.T) {
+	executor := &outageExecutor{identifier: holdTestProvider, status: http.StatusServiceUnavailable, until: time.Now().Add(2500 * time.Millisecond), latency: 250 * time.Millisecond}
+	manager := setupOutagePool(t, 1, executor, OutageHoldConfig{Enabled: true, MaxWait: 20 * time.Second, ProbeInterval: 100 * time.Millisecond})
+	var wg sync.WaitGroup
+	errs := make([]error, 2)
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			// Stagger the starts past the executor latency so the initial
+			// attempts are not concurrent; only the probes could be.
+			time.Sleep(time.Duration(i) * 400 * time.Millisecond)
+			_, errs[i] = manager.ExecuteStream(context.Background(), []string{holdTestProvider}, cliproxyexecutor.Request{Model: holdTestModel}, holdOptions("turn-"+string(rune('x'+i))))
+		}(i)
+	}
+	wg.Wait()
+	for i, err := range errs {
+		if err != nil {
+			t.Fatalf("request %d failed: %v", i, err)
+		}
+	}
+	if peak := executor.peakInFlight(); peak != 1 {
+		t.Fatalf("peak concurrent upstream calls = %d, want 1 (one prober per model)", peak)
+	}
+}
+
+func TestOutageHoldTurnKeyAndBudget(t *testing.T) {
+	opts := holdOptions("abc")
+	if key := outageHoldTurnKey(opts); key != "turn:abc" {
+		t.Fatalf("turn key = %q", key)
+	}
+	opts = cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.CanonicalSessionIDMetadataKey: "sess-1"}}
+	if key := outageHoldTurnKey(opts); key != "session:sess-1" {
+		t.Fatalf("session key = %q", key)
+	}
+	if key := outageHoldTurnKey(cliproxyexecutor.Options{}); key != "" {
+		t.Fatalf("empty key = %q", key)
+	}
+	manager := NewManager(nil, nil, nil)
+	manager.SetOutageHoldConfig(OutageHoldConfig{Enabled: true, MaxWait: 10 * time.Minute, ClientMaxWait: map[string]time.Duration{"Claude-Cli": 8 * time.Minute}})
+	cfg := manager.outageHold.config.Load()
+	if got := cfg.budgetFor("claude-cli/2.1.0 (external, cli)"); got != 8*time.Minute {
+		t.Fatalf("claude-cli budget = %v", got)
+	}
+	if got := cfg.budgetFor("codex_cli_rs/0.154.0"); got != 10*time.Minute {
+		t.Fatalf("codex budget = %v", got)
+	}
+	if got := cfg.budgetFor(""); got != 10*time.Minute {
+		t.Fatalf("default budget = %v", got)
+	}
+}
+
+func TestOutageHoldEligibleError(t *testing.T) {
+	for status, want := range map[int]bool{408: true, 500: true, 502: true, 503: true, 504: true, 520: true, 526: true, 529: true, 429: true, 400: false, 401: false, 403: false, 404: false, 200: false} {
+		if got := outageHoldEligibleError(holdTestStatusErr{code: status}); got != want {
+			t.Errorf("status %d eligible = %v, want %v", status, got, want)
+		}
+	}
+	if !outageHoldEligibleError(&Error{Code: "auth_unavailable", Message: "no credential"}) {
+		t.Error("pick failure must be hold-eligible")
+	}
+	if outageHoldEligibleError(nil) {
+		t.Error("nil must not be eligible")
+	}
+}
