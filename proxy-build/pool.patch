+		t.Fatalf("after re-enable with a failed read registered %v, want the cached list", got)
+	}
+}
+
+func TestLiveModelsConcurrentPersistKeepsValidCache(t *testing.T) {
+	cache := filepath.Join(t.TempDir(), "live-models.json")
+	a := oauthAuth("live-claude-persist", "claude")
+	h := newLiveModelsHarness(t, cache, a)
+	h.lists[a.ID] = modelList("claude", "claude-sonnet-5-5")
+	h.manager.pass(context.Background(), true)
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); h.manager.persist() }()
+	}
+	wg.Wait()
+	data, err := os.ReadFile(cache)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed liveModelsCache
+	if err = json.Unmarshal(data, &parsed); err != nil || len(parsed.Lists) != 1 {
+		t.Fatalf("cache = %s (%v)", data, err)
+	}
+	if leftovers, _ := filepath.Glob(cache + ".*.tmp"); len(leftovers) != 0 {
+		t.Fatalf("temporary files left: %v", leftovers)
+	}
+}
+
+func TestLiveModelsReplacedAccountIsReadWithoutWaiting(t *testing.T) {
+	a := oauthAuth("live-codex-retry-replaced", "codex")
+	h := newLiveModelsHarness(t, "", a)
+	clock := time.Date(2026, 9, 28, 12, 0, 0, 0, time.UTC)
+	h.manager.now = func() time.Time { return clock }
+	h.lists[a.ID] = modelList("codex", "gpt-6-sol")
+	h.manager.pass(context.Background(), false)
+	replaced := oauthAuth(a.ID, "codex")
+	replaced.Metadata["email"] = "other@example.com"
+	if _, err := h.service.coreManager.Update(context.Background(), replaced); err != nil {
+		t.Fatal(err)
+	}
+	calls := h.calls.Load()
+	clock = clock.Add(5 * time.Second)
+	h.manager.pass(context.Background(), false)
+	if h.calls.Load() != calls+1 {
+		t.Fatal("replacement account waited for the previous account's retry interval")
+	}
+}
+
+func TestLiveModelsCredentialWithoutIdentityIsNotCached(t *testing.T) {
+	cache := filepath.Join(t.TempDir(), "live-models.json")
+	a := oauthAuth("live-claude-anonymous", "claude")
+	delete(a.Metadata, "email")
+	h := newLiveModelsHarness(t, cache, a)
+	h.lists[a.ID] = modelList("claude", "claude-sonnet-5-5")
+	h.service.registerModelsForAuth(context.Background(), a)
+	h.manager.pass(context.Background(), true)
+	if got := registeredIDs(a.ID); !reflect.DeepEqual(got, []string{"claude-sonnet-5-5"}) {
+		t.Fatalf("registered %v", got)
+	}
+	restarted := newLiveModelsHarness(t, cache, a)
+	restarted.manager.loadCache()
+	internalregistry.GetGlobalRegistry().UnregisterClient(a.ID)
+	restarted.service.registerModelsForAuth(context.Background(), a)
+	if got := registeredIDs(a.ID); len(got) != 0 {
+		t.Fatalf("a list without an account identity was restored: %v", got)
+	}
+}
