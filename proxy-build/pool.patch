+package executor
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	"github.com/tidwall/gjson"
+)
+
+const nativeTestBlob = "gAAAAnative-test-blob"
+
+type nativeFakeUpstream struct {
+	mu            sync.Mutex
+	compactions   [][]byte
+	handoffs      [][]byte
+	handoffStatus int
+	handoffDelay  time.Duration
+	summary       string
+}
+
+func (u *nativeFakeUpstream) handler(t *testing.T) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		isCompaction := false
+		for _, item := range gjson.GetBytes(body, "input").Array() {
+			if item.Get("type").String() == "compaction_trigger" {
+				isCompaction = true
+			}
+		}
+		u.mu.Lock()
+		if isCompaction {
+			u.compactions = append(u.compactions, body)
+		} else {
+			u.handoffs = append(u.handoffs, body)
+		}
+		status, delay, summary := u.handoffStatus, u.handoffDelay, u.summary
+		u.mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		if isCompaction {
+			fmt.Fprint(w, "data: "+`{"type":"response.created","response":{"id":"resp_native","status":"in_progress","output":[]}}`+"\n\n")
+			fmt.Fprint(w, "data: "+fmt.Sprintf(`{"type":"response.output_item.done","output_index":0,"item":{"id":"cmp_native","type":"compaction","encrypted_content":%q}}`, nativeTestBlob)+"\n\n")
+			fmt.Fprint(w, "data: "+`{"type":"response.completed","response":{"id":"resp_native","object":"response","status":"completed","output":[],"usage":{"input_tokens":900,"output_tokens":50,"total_tokens":950}}}`+"\n\n")
+			return
+		}
+		if delay > 0 {
+			time.Sleep(delay)
+		}
+		if status != 0 {
+			w.WriteHeader(status)
+			fmt.Fprint(w, `{"error":{"message":"fixture failure"}}`)
+			return
+		}
+		fmt.Fprint(w, "data: "+fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp_handoff","object":"response","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":%q}]}],"usage":{"input_tokens":280,"output_tokens":20,"total_tokens":300}}}`, summary)+"\n\n")
+	}
+}
+
+func (u *nativeFakeUpstream) counts() (int, int) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return len(u.compactions), len(u.handoffs)
+}
+
+func nativeTestSetup(t *testing.T, upstream *nativeFakeUpstream) (*config.Config, *coreauth.Auth, *httptest.Server) {
+	t.Helper()
+	cfg := portableTestConfig(t)
+	cfg.PortableCompactionNativeGPT = true
+	server := httptest.NewServer(upstream.handler(t))
+	t.Cleanup(server.Close)
+	auth := &coreauth.Auth{ID: "fixture", Provider: "codex", Attributes: map[string]string{"api_key": "test-key", "base_url": server.URL}}
+	return cfg, auth, server
+}
+
+const nativeCompactRequest = `{"model":"gpt-6-sol","reasoning":{"effort":"high"},"tools":[{"type":"function","name":"shell","parameters":{"type":"object","properties":{}}}],"input":[{"type":"message","role":"user","content":"ALPHA facts"},{"type":"compaction_trigger"}]}`
+
+func waitNativeHandoffStored(t *testing.T, cfg *config.Config, scope, native string) (string, bool) {
+	t.Helper()
+	ring, err := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitNativeHandoff(context.Background(), nativeHandoffJobKey(cfg.PortableCompactionKeyFile, scope, native), time.Now().Add(10*time.Second))
+	store, _ := helps.NewNativeHandoffStore(helps.NativeHandoffDir(cfg.PortableCompactionKeyFile), ring)
+	summary, ok, err := store.Get(scope, native)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return summary, ok
+}
+
+func TestNativeGPTCompactionPassesThroughAndStoresHandoff(t *testing.T) {
+	upstream := &nativeFakeUpstream{summary: "HANDOFF ALPHA facts preserved"}
+	cfg, auth, _ := nativeTestSetup(t, upstream)
+	exec := NewCodexAutoExecutor(cfg)
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(nativeCompactRequest)}
+	response, err := exec.Execute(context.Background(), auth, req, portableTestOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id := gjson.GetBytes(response.Payload, "id").String(); id != "resp_native" {
+		t.Fatalf("response id = %q, want the native id", id)
+	}
+	if got := gjson.GetBytes(response.Payload, "output.0.encrypted_content").String(); got != nativeTestBlob {
+		t.Fatalf("client checkpoint = %q, want the native blob unchanged", got)
+	}
+	if n := gjson.GetBytes(response.Payload, "output.#").Int(); n != 1 {
+		t.Fatalf("output items = %d", n)
+	}
+	if gjson.GetBytes(response.Payload, "usage.input_tokens").Int() != 900 {
+		t.Fatal("native usage replaced")
+	}
+	compaction := upstream.compactions[0]
+	if gjson.GetBytes(compaction, "tools.#(name==\"shell\")").Exists() == false || gjson.GetBytes(compaction, "tool_choice").String() == "none" {
+		t.Fatalf("native compaction request lost the caller's tools: %s", compaction)
+	}
+	if strings.Contains(string(compaction), "compacting a conversation") {
+		t.Fatal("native compaction was rewritten into a portable summary request")
+	}
+	summary, ok := waitNativeHandoffStored(t, cfg, "caller", nativeTestBlob)
+	if !ok || summary != "HANDOFF ALPHA facts preserved" {
+		t.Fatalf("handoff summary = %q, %v", summary, ok)
+	}
+	handoff := upstream.handoffs[0]
+	if gjson.GetBytes(handoff, "input.0.type").String() != "compaction" || gjson.GetBytes(handoff, "input.0.encrypted_content").String() != nativeTestBlob {
+		t.Fatalf("handoff did not read the native checkpoint: %s", handoff)
+	}
+	if gjson.GetBytes(handoff, "tools.#").Int() != 0 || gjson.GetBytes(handoff, "tool_choice").String() != "none" || gjson.GetBytes(handoff, "previous_response_id").Exists() {
+		t.Fatalf("handoff can act or references a parent: %s", handoff)
+	}
+	if gjson.GetBytes(handoff, "reasoning.effort").String() != "high" || gjson.GetBytes(handoff, "max_output_tokens").Exists() {
+		t.Fatalf("handoff changed caller reasoning or capped output: %s", handoff)
+	}
+
+	// Claude reads the stored summary in place of the native checkpoint.
+	claudeReq := coreexecutor.Request{Model: "claude-opus-5-5", Payload: []byte(fmt.Sprintf(`{"model":"claude-opus-5-5","input":[{"type":"message","role":"user","content":"ALPHA facts"},{"type":"compaction","id":"cmp_native","encrypted_content":%q},{"type":"message","role":"user","content":"continue"}]}`, nativeTestBlob))}
+	opts := portableTestOptions()
+	opts.OriginalRequest = claudeReq.Payload
+	expanded, expandedOpts, compact, err := preparePortableRequestContext(context.Background(), cfg, claudeReq, opts, false)
+	if err != nil || compact {
+		t.Fatalf("claude expansion err=%v compact=%v", err, compact)
+	}
+	for _, payload := range [][]byte{expanded.Payload, expandedOpts.OriginalRequest} {
+		if strings.Contains(string(payload), nativeTestBlob) || gjson.GetBytes(payload, "input.1.role").String() != "user" || !strings.Contains(gjson.GetBytes(payload, "input.1.content.0.text").String(), "HANDOFF ALPHA facts preserved") {
+			t.Fatalf("claude did not receive the handoff summary in place: %s", payload)
+		}
+	}
+
+	// GPT replays the native checkpoint byte-identically, without the keyring.
+	gptReq := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(fmt.Sprintf(`{"input":[{"type":"compaction","id":"cmp_native","encrypted_content":%q}]}`, nativeTestBlob))}
+	missing := &config.Config{PortableCompactionKeyFile: "missing-file", PortableCompactionNativeGPT: true}
+	got, _, _, err := preparePortableRequestContext(context.Background(), missing, gptReq, portableTestOptions(), true)
+	if err != nil || string(got.Payload) != string(gptReq.Payload) {
+		t.Fatalf("native GPT replay changed or needed the keyring: %v %s", err, got.Payload)
+	}
+}
+
+func TestNativeGPTCompactionStreamForwardsChunksUnchanged(t *testing.T) {
+	upstream := &nativeFakeUpstream{summary: "STREAM HANDOFF"}
+	cfg, auth, _ := nativeTestSetup(t, upstream)
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(nativeCompactRequest)}
+	opts := portableTestOptions()
+	opts.Stream = true
+	result, err := NewCodexAutoExecutor(cfg).ExecuteStream(context.Background(), auth, req, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var all strings.Builder
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+		all.Write(chunk.Payload)
+	}
+	text := all.String()
+	if !strings.Contains(text, nativeTestBlob) || !strings.Contains(text, "resp_native") || strings.Contains(text, helps.PortableCompactionNamespace) {
+		t.Fatalf("stream was not the native compaction: %s", text)
+	}
+	if summary, ok := waitNativeHandoffStored(t, cfg, "caller", nativeTestBlob); !ok || summary != "STREAM HANDOFF" {
+		t.Fatalf("stream handoff = %q %v", summary, ok)
+	}
+}
+
+func TestNativeGPTHandoffFailureLeavesGPTUnchangedAndClaudeFailsExplicitly(t *testing.T) {
+	upstream := &nativeFakeUpstream{handoffStatus: http.StatusInternalServerError}
+	cfg, auth, _ := nativeTestSetup(t, upstream)
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(nativeCompactRequest)}
+	response, err := NewCodexAutoExecutor(cfg).Execute(context.Background(), auth, req, portableTestOptions())
+	if err != nil || gjson.GetBytes(response.Payload, "output.0.encrypted_content").String() != nativeTestBlob {
+		t.Fatalf("GPT compaction affected by handoff failure: %v %s", err, response.Payload)
+	}
+	if _, ok := waitNativeHandoffStored(t, cfg, "caller", nativeTestBlob); ok {
+		t.Fatal("failed handoff stored a summary")
+	}
+	if compactions, handoffs := upstream.counts(); compactions != 1 || handoffs != 3 {
+		t.Fatalf("compactions=%d handoffs=%d, want native once and bounded handoff attempts", compactions, handoffs)
+	}
+	claudeReq := coreexecutor.Request{Payload: []byte(fmt.Sprintf(`{"input":[{"type":"compaction","encrypted_content":%q}]}`, nativeTestBlob))}
+	_, _, _, err = preparePortableRequestContext(context.Background(), cfg, claudeReq, portableTestOptions(), false)
+	if err == nil || !strings.Contains(err.Error(), "compact the task again") {
+		t.Fatalf("claude did not fail explicitly: %v", err)
+	}
+	// Another caller never sees this caller's handoff.
+	if _, ok := waitNativeHandoffStored(t, cfg, "other-caller", nativeTestBlob); ok {
+		t.Fatal("handoff leaked across callers")
+	}
+}
+
+func TestNativeGPTClaudeWaitsForInflightHandoff(t *testing.T) {
+	upstream := &nativeFakeUpstream{summary: "LATE HANDOFF", handoffDelay: 300 * time.Millisecond}
+	cfg, auth, _ := nativeTestSetup(t, upstream)
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(nativeCompactRequest)}
+	if _, err := NewCodexAutoExecutor(cfg).Execute(context.Background(), auth, req, portableTestOptions()); err != nil {
+		t.Fatal(err)
+	}
+	claudeReq := coreexecutor.Request{Payload: []byte(fmt.Sprintf(`{"input":[{"type":"compaction","encrypted_content":%q}]}`, nativeTestBlob))}
+	got, _, _, err := preparePortableRequestContext(context.Background(), cfg, claudeReq, portableTestOptions(), false)
+	if err != nil || !strings.Contains(string(got.Payload), "LATE HANDOFF") {
+		t.Fatalf("claude did not wait for the in-flight handoff: %v %s", err, got.Payload)
+	}
+}
+
+func TestNativeGPTCompactionWithoutKeyringStillCompactsNatively(t *testing.T) {
+	upstream := &nativeFakeUpstream{summary: "unused"}
+	_, auth, _ := nativeTestSetup(t, upstream)
+	cfg := &config.Config{PortableCompactionKeyFile: "missing-file", PortableCompactionNativeGPT: true}
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(nativeCompactRequest)}
+	response, err := NewCodexAutoExecutor(cfg).Execute(context.Background(), auth, req, portableTestOptions())
+	if err != nil || gjson.GetBytes(response.Payload, "output.0.encrypted_content").String() != nativeTestBlob {
+		t.Fatalf("native compaction needed the keyring: %v", err)
+	}
+	time.Sleep(100 * time.Millisecond)
+	if _, handoffs := upstream.counts(); handoffs != 0 {
+		t.Fatal("handoff attempted without a keyring")
+	}
+}
+
+func TestNativeGPTRejectsUnknownPoolCheckpointVersion(t *testing.T) {
+	upstream := &nativeFakeUpstream{summary: "unused"}
+	cfg, auth, _ := nativeTestSetup(t, upstream)
+	req := coreexecutor.Request{Model: "gpt-6-sol", Payload: []byte(`{"model":"gpt-6-sol","input":[{"type":"compaction","encrypted_content":"pool-compact-v9:test:abc"},{"type":"message","role":"user","content":"hi"}]}`)}
+	_, err := NewCodexAutoExecutor(cfg).Execute(context.Background(), auth, req, portableTestOptions())
+	if err == nil || !strings.Contains(err.Error(), "unsupported portable checkpoint version") {
+		t.Fatalf("unknown pool checkpoint version was not rejected: %v", err)
+	}
+	if compactions, handoffs := upstream.counts(); compactions+handoffs != 0 {
+		t.Fatal("unknown pool checkpoint reached the upstream")
+	}
+}
+
+func TestNativeCompactionCheckpointDetection(t *testing.T) {
+	cases := map[string]bool{
+		`{"status":"completed","output":[{"type":"compaction","encrypted_content":"n"}]}`:                                                   true,
+		`{"status":"incomplete","output":[{"type":"compaction","encrypted_content":"n"}]}`:                                                  false,
+		`{"status":"completed","output":[{"type":"compaction","encrypted_content":""}]}`:                                                    false,
+		`{"status":"completed","output":[{"type":"compaction","encrypted_content":"pool-compact-v1:k:x"}]}`:                                 false,
+		`{"status":"completed","output":[{"type":"compaction","encrypted_content":"n"},{"type":"message","content":[]}]}`:                   false,
+		`{"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"not compacted"}]}]}`: false,
+	}
+	for payload, want := range cases {
+		if _, got := nativeCompactionCheckpoint([]byte(payload)); got != want {
+			t.Errorf("%s: got %v want %v", payload, got, want)
+		}
+	}
+	var tracker nativeCompactionStreamTracker
+	tracker.observe([]byte(`data: {"type":"response.output_item.done","output_index":0,"item":{"type":"compaction","encrypted_content":"n"}}` + "\n\n"))
+	tracker.observe([]byte(`{"type":"response.incomplete","response":{"status":"incomplete","output":[]}}`))
+	if _, ok := tracker.checkpoint(); ok {
+		t.Fatal("incomplete stream reported a checkpoint")
+	}
+	if !errors.Is(helps.ErrNativeHandoffUnavailable, helps.ErrNativeHandoffUnavailable) {
+		t.Fatal("sentinel")
+	}
+}
