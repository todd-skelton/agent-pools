@@ -1,13 +1,57 @@
 package management
 
 import (
+	"errors"
 	"fmt"
 	"net/http"
+	"strconv"
 	"strings"
+	"time"
 
 	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
 )
 
+func (h *Handler) RecoverQuota(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(503, gin.H{"error": "core auth manager unavailable"})
+		return
+	}
+	var req struct {
+		AuthIndex     string    `json:"auth_index"`
+		Generation    string    `json:"generation"`
+		ObservedAfter time.Time `json:"observed_after"`
+	}
+	if errBind := c.ShouldBindJSON(&req); errBind != nil {
+		c.JSON(400, gin.H{"error": "invalid recovery request"})
+		return
+	}
+	generation, errGeneration := strconv.ParseUint(req.Generation, 10, 64)
+	if errGeneration != nil || req.AuthIndex == "" || req.ObservedAfter.IsZero() {
+		c.JSON(400, gin.H{"error": "auth_index, generation and observed_after are required"})
+		return
+	}
+	auth := h.authByIndex(req.AuthIndex)
+	if auth == nil {
+		c.JSON(404, gin.H{"error": "auth not found"})
+		return
+	}
+	updated, changed, errRecover := h.authManager.RecoverQuota(c.Request.Context(), auth.ID, generation, req.ObservedAfter)
+	if errors.Is(errRecover, coreauth.ErrQuotaRecoveryConflict) {
+		c.JSON(409, gin.H{"error": "routing changed; obtain fresh status"})
+		return
+	}
+	if errRecover != nil {
+		c.JSON(500, gin.H{"error": "quota recovery could not be persisted"})
+		return
+	}
+	if updated == nil {
+		c.JSON(404, gin.H{"error": "auth not found"})
+		return
+	}
+	c.JSON(200, gin.H{"changed": changed, "routing": coreauth.RoutingObservationForAuth(updated, time.Now())})
+}
