@@ -0,0 +1,67 @@
+package handlers
+
+import (
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/interfaces"
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexFailedChunkRewritesFatalOverloadCodes(t *testing.T) {
+	for _, code := range []string{"server_is_overloaded", "slow_down"} {
+		body := fmt.Sprintf(`{"error":{"type":"server_error","code":%q,"message":"The server is overloaded"}}`, code)
+		chunk := BuildOpenAIResponsesStreamFailedChunk(http.StatusServiceUnavailable, body, 3)
+		if got := gjson.GetBytes(chunk, "response.error.code").String(); got != "internal_server_error" {
+			t.Fatalf("code %s: response.error.code = %q, want internal_server_error: %s", code, got, chunk)
+		}
+		if got := gjson.GetBytes(chunk, "response.error.message").String(); got != "The server is overloaded" {
+			t.Fatalf("message changed: %q", got)
+		}
+		if got := gjson.GetBytes(chunk, "sequence_number").Int(); got != 3 {
+			t.Fatalf("sequence_number = %d", got)
+		}
+	}
+	// Non-Codex clients keep the upstream code.
+	chunk := BuildOpenAIResponsesStreamErrorChunk(http.StatusServiceUnavailable, `{"error":{"type":"server_error","code":"server_is_overloaded","message":"x"}}`, 0)
+	if got := gjson.GetBytes(chunk, "error.code").String(); got != "server_is_overloaded" {
+		t.Fatalf("legacy error chunk code = %q, want server_is_overloaded", got)
+	}
+}
+
+func TestShapeCodexErrorMessageRateLimit(t *testing.T) {
+	plain := &interfaces.ErrorMessage{StatusCode: http.StatusTooManyRequests, Error: fmt.Errorf(`{"error":{"type":"rate_limit_error","code":"rate_limit_exceeded","message":"Too many requests"}}`)}
+	shaped := ShapeCodexErrorMessage(plain)
+	if shaped.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("status = %d, want 503", shaped.StatusCode)
+	}
+	if got := gjson.Get(shaped.Error.Error(), "error.code").String(); got != "internal_server_error" {
+		t.Fatalf("code = %q, want internal_server_error: %s", got, shaped.Error.Error())
+	}
+	if got := gjson.Get(shaped.Error.Error(), "error.message").String(); got != "upstream rate limited, retry later: Too many requests" {
+		t.Fatalf("message = %q", got)
+	}
+
+	usage := &interfaces.ErrorMessage{StatusCode: http.StatusTooManyRequests, Error: fmt.Errorf(`{"error":{"type":"usage_limit_reached","message":"limit","plan_type":"plus","resets_in_seconds":120}}`)}
+	if got := ShapeCodexErrorMessage(usage); got != usage {
+		t.Fatalf("usage_limit_reached must be passed through unchanged, got %d %s", got.StatusCode, got.Error.Error())
+	}
+
+	overload := &interfaces.ErrorMessage{StatusCode: http.StatusServiceUnavailable, Error: fmt.Errorf(`{"error":{"type":"server_error","code":"server_is_overloaded","message":"busy"}}`)}
+	if got := ShapeCodexErrorMessage(overload); got.StatusCode != http.StatusServiceUnavailable || gjson.Get(got.Error.Error(), "error.code").String() != "internal_server_error" {
+		t.Fatalf("overload not shaped: %d %s", got.StatusCode, got.Error.Error())
+	}
+
+	generic := &interfaces.ErrorMessage{StatusCode: http.StatusBadGateway, Error: fmt.Errorf(`{"error":{"type":"server_error","code":"internal_server_error","message":"upstream reset"}}`)}
+	if got := ShapeCodexErrorMessage(generic); got != generic {
+		t.Fatal("generic 5xx must be unchanged")
+	}
+	if got := ShapeCodexErrorMessage(nil); got != nil {
+		t.Fatal("nil must stay nil")
+	}
+	direct := &interfaces.ErrorMessage{StatusCode: http.StatusTooManyRequests, DirectResponse: true, Error: fmt.Errorf("x")}
+	if got := ShapeCodexErrorMessage(direct); got != direct {
+		t.Fatal("direct responses must be unchanged")
+	}
+}
