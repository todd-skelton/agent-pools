+	var root any
+	if err := json.Unmarshal(rawJSON, &root); err != nil {
+		return rawJSON
+	}
+	var walk func(any)
+	walk = func(value any) {
+		switch node := value.(type) {
+		case []any:
+			for _, child := range node {
+				walk(child)
+			}
+		case map[string]any:
