new file mode 100644
index 0000000000000000000000000000000000000000..c432ad74209d89243d4d6330d5bc71906d83215c
--- /dev/null
+++ b/sdk/cliproxy/auth/refresh_failure.go
@@ -0,0 +1,70 @@
+package auth
+
+import (
+	"errors"
+	"strings"
+	"time"
+)
+
+// refreshFailureMessageLimit bounds the diagnostic kept on the credential and
+// shown by the management API.
+const refreshFailureMessageLimit = 512
+
+// Markers of an OAuth refresh grant the provider will never accept again.
+// Anthropic answers invalid_grant; OpenAI uses refresh_token_* codes.
+var reauthRefreshMarkers = []string{"invalid_grant", "refresh_token_reused", "refresh_token_expired", "refresh_token_invalidated"}
+
+// isReauthRefreshError reports whether a refresh failure can only be fixed by
+// signing in again. The error reaching the manager is the token endpoint's
+// verdict, so its body markers are authoritative.
+func isReauthRefreshError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if isUnauthorizedError(err) {
+		return true
+	}
+	raw := strings.ToLower(err.Error())
+	for _, marker := range reauthRefreshMarkers {
+		if strings.Contains(raw, marker) {
+			return true
+		}
+	}
+	return false
+}
+
+// refreshFailureHTTPStatus prefers the token endpoint status a refresh client
+// reports for diagnostics over the generic StatusCode used for classification.
+func refreshFailureHTTPStatus(err error) int {
+	type refreshStatusCoder interface{ RefreshHTTPStatus() int }
+	var coder refreshStatusCoder
+	if errors.As(err, &coder) && coder != nil {
+		return coder.RefreshHTTPStatus()
+	}
+	return statusCodeFromError(err)
+}
+
+// newRefreshFailure records err as the latest failure of a streak that began
+// with previous (nil for the first failure).
+func newRefreshFailure(previous *RefreshFailure, err error, now time.Time) *RefreshFailure {
+	message := safeErrorDiagnosticForLog(err)
+	if len(message) > refreshFailureMessageLimit {
+		message = strings.ToValidUTF8(message[:refreshFailureMessageLimit], "") + "..."
+	}
+	failure := &RefreshFailure{
+		Code:       RefreshFailureRetrying,
+		HTTPStatus: refreshFailureHTTPStatus(err),
+		Message:    message,
+		Since:      now,
+		At:         now,
+		Attempts:   1,
+	}
+	if isReauthRefreshError(err) {
+		failure.Code = RefreshFailureReauthRequired
+	}
+	if previous != nil {
+		failure.Since = previous.Since
+		failure.Attempts = previous.Attempts + 1
+	}
+	return failure
+}
