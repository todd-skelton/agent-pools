+	if gjson.GetBytes(got, "input").Raw != gjson.GetBytes(payload, "input").Raw {
+		t.Fatalf("input changed when instructions were present: %s", got)
+	}
+}
+
+func TestInjectCodexRuntimeIdentityHandlesStringDeveloperContentAndSkipsUserOnly(t *testing.T) {
+	t.Parallel()
+
+	asString := []byte(`{"model":"gpt-6-astra","input":[{"type":"message","role":"system","content":"Base prompt."},{"type":"message","role":"user","content":"hi"}]}`)
+	if got := gjson.GetBytes(injectCodexRuntimeIdentity(asString), "input.0.content").String(); !strings.HasPrefix(got, "Base prompt.\n\n"+codexRuntimeIdentityMarker) {
+		t.Fatalf("string content not extended: %q", got)
