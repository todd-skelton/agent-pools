diff --git a/sdk/cliproxy/service_readiness.go b/sdk/cliproxy/service_readiness.go
new file mode 100644
index 0000000000000000000000000000000000000000..8e5b285f89fccd3f78449175e3cecd31d427215c
--- /dev/null
+++ b/sdk/cliproxy/service_readiness.go
@@ -0,0 +1,96 @@
+package cliproxy
+
+import (
+	"context"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// modelRoutingReadyPoll is the spacing between quiescence checks.
+	modelRoutingReadyPoll = 50 * time.Millisecond
+	// modelRoutingReadyQuietPolls is how many consecutive quiet checks are
+	// needed: the watcher hands updates to the service through two queues, so
+	// a single empty observation can sit between hops.
+	modelRoutingReadyQuietPolls = 3
+	// modelRoutingReadyTimeout bounds the not-ready window so a stuck or slow
+	// load can never turn every unroutable model into a 503 forever. It covers
+	// the first live model list pass (client version wait plus one read).
+	modelRoutingReadyTimeout = 45 * time.Second
+)
+
+// modelRoutingLoadState is what the readiness loop observes; the service
+// backs it with the watcher backlog and its own auth update queue.
+type modelRoutingLoadState interface {
+	pendingAuthUpdates() int
+	authUpdatesIdle() bool
+	// liveModelsSettled reports that the first live model list pass is done,
+	// so a model a credential newly gained is registered.
+	liveModelsSettled() bool
+}
+
+type serviceLoadState struct {
+	service *Service
+	watcher *WatcherWrapper
+}
+
+func (s serviceLoadState) pendingAuthUpdates() int {
+	return s.watcher.PendingAuthUpdates()
+}
+
+func (s serviceLoadState) liveModelsSettled() bool {
+	return s.service == nil || s.service.liveModels.settledFirstPass()
+}
+
+// authUpdatesIdle reports that nothing is queued for the service and no
+// handleAuthUpdates call is in progress.
+func (s serviceLoadState) authUpdatesIdle() bool {
+	if s.service == nil {
+		return true
+	}
+	if s.service.authUpdates != nil && len(s.service.authUpdates) > 0 {
+		return false
+	}
+	if !s.service.authUpdateMu.TryLock() {
+		return false
+	}
+	s.service.authUpdateMu.Unlock()
+	return true
+}
+
+// markModelRoutingReadyWhenLoaded flips the handlers' readiness flag once the
+// initial auth load has drained into the model registry and the first live
+// model list pass is done, or once the timeout passes. It returns whether readiness was reached by quiescence.
+func markModelRoutingReadyWhenLoaded(ctx context.Context, state modelRoutingLoadState, poll, timeout time.Duration, quietPolls int) bool {
+	defer handlers.SetModelRoutingReady(true)
+	if state == nil {
+		return true
+	}
+	started := time.Now()
+	deadline := time.NewTimer(timeout)
+	defer deadline.Stop()
+	ticker := time.NewTicker(poll)
+	defer ticker.Stop()
+	quiet := 0
+	for {
+		select {
+		case <-ctx.Done():
+			return false
+		case <-deadline.C:
+			log.Warnf("model routing marked ready after %s without observing a quiet auth load", time.Since(started).Round(time.Millisecond))
+			return false
+		case <-ticker.C:
+			if state.pendingAuthUpdates() == 0 && state.authUpdatesIdle() && state.liveModelsSettled() {
+				quiet++
+			} else {
+				quiet = 0
+			}
+			if quiet >= quietPolls {
+				log.Infof("model routing ready after initial auth load (%s)", time.Since(started).Round(time.Millisecond))
+				return true
+			}
+		}
+	}
+}
diff --git a/sdk/cliproxy/service_readiness_test.go b/sdk/cliproxy/service_readiness_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0c76bfc68370bc14d19adce9846b83e07e540b40
--- /dev/null
+++ b/sdk/cliproxy/service_readiness_test.go
@@ -0,0 +1,121 @@
+package cliproxy
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+)
+
+type fakeLoadState struct {
+	pending atomic.Int32
+	busy    atomic.Bool
+	polls   atomic.Int32
+	// liveReading: the first live model list pass is still running.
+	liveReading atomic.Bool
+}
+
+func (f *fakeLoadState) pendingAuthUpdates() int {
+	f.polls.Add(1)
+	return int(f.pending.Load())
+}
+
+func (f *fakeLoadState) authUpdatesIdle() bool { return !f.busy.Load() }
+
+func (f *fakeLoadState) liveModelsSettled() bool { return !f.liveReading.Load() }
+
+func TestMarkModelRoutingReadyWaitsForQuietLoad(t *testing.T) {
+	handlers.SetModelRoutingReady(false)
+	t.Cleanup(func() { handlers.SetModelRoutingReady(true) })
+
+	state := &fakeLoadState{}
+	state.pending.Store(3)
+	done := make(chan bool, 1)
+	go func() {
+		done <- markModelRoutingReadyWhenLoaded(context.Background(), state, 5*time.Millisecond, 5*time.Second, 3)
+	}()
+
+	time.Sleep(40 * time.Millisecond)
+	if handlers.ModelRoutingReady() {
+		t.Fatal("became ready while updates were pending")
+	}
+	// Drain the watcher backlog but keep the service handler busy: still not ready.
+	state.pending.Store(0)
+	state.busy.Store(true)
+	time.Sleep(40 * time.Millisecond)
+	if handlers.ModelRoutingReady() {
+		t.Fatal("became ready while handleAuthUpdates was running")
+	}
+	state.busy.Store(false)
+
+	select {
+	case quiet := <-done:
+		if !quiet {
+			t.Fatal("expected readiness by quiescence, got timeout")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("readiness loop did not finish")
+	}
+	if !handlers.ModelRoutingReady() {
+		t.Fatal("flag not set after quiet load")
+	}
+}
+
+func TestMarkModelRoutingReadyTimesOutToReady(t *testing.T) {
+	handlers.SetModelRoutingReady(false)
+	t.Cleanup(func() { handlers.SetModelRoutingReady(true) })
+
+	state := &fakeLoadState{}
+	state.pending.Store(1)
+	started := time.Now()
+	quiet := markModelRoutingReadyWhenLoaded(context.Background(), state, 5*time.Millisecond, 60*time.Millisecond, 3)
+	if quiet {
+		t.Fatal("expected timeout, got quiescence")
+	}
+	if elapsed := time.Since(started); elapsed < 50*time.Millisecond || elapsed > time.Second {
+		t.Fatalf("timeout fired at %s", elapsed)
+	}
+	if !handlers.ModelRoutingReady() {
+		t.Fatal("flag must be set after the timeout so 503s can never persist")
+	}
+}
+
+func TestMarkModelRoutingReadyOnCancelledContext(t *testing.T) {
+	handlers.SetModelRoutingReady(false)
+	t.Cleanup(func() { handlers.SetModelRoutingReady(true) })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	state := &fakeLoadState{}
+	state.pending.Store(1)
+	markModelRoutingReadyWhenLoaded(ctx, state, 5*time.Millisecond, time.Second, 3)
+	if !handlers.ModelRoutingReady() {
+		t.Fatal("flag must be set when the service context ends")
+	}
+}
+func TestMarkModelRoutingReadyWaitsForFirstLiveModelPass(t *testing.T) {
+	handlers.SetModelRoutingReady(false)
+	t.Cleanup(func() { handlers.SetModelRoutingReady(true) })
+
+	state := &fakeLoadState{}
+	state.liveReading.Store(true)
+	done := make(chan bool, 1)
+	go func() {
+		done <- markModelRoutingReadyWhenLoaded(context.Background(), state, 5*time.Millisecond, 5*time.Second, 3)
+	}()
+	time.Sleep(60 * time.Millisecond)
+	if handlers.ModelRoutingReady() {
+		t.Fatal("became ready while the first live model pass was running")
+	}
+	state.liveReading.Store(false)
+	select {
+	case quiet := <-done:
+		if !quiet || !handlers.ModelRoutingReady() {
+			t.Fatalf("quiet=%v ready=%v", quiet, handlers.ModelRoutingReady())
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("never became ready after the pass settled")
+	}
+}
