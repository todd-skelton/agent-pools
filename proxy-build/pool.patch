+// A summary cut off at the provider's output limit gets one shorter retry of
+// the same history instead of failing the compaction outright.
+func TestPortableCompactionRetriesTooLongSummaryOnce(t *testing.T) {
+	cfg := portableTestConfig(t)
+	opts := portableTestOptions()
+	request := coreexecutor.Request{Model: "claude-opus-5-5", Payload: []byte(`{"input":[{"role":"user","content":"ALPHA"},{"type":"compaction_trigger"}]}`)}
+	var instructions []string
+	responses := []string{
+		`{"status":"incomplete","incomplete_details":{"reason":"max_output_tokens"},"output":[{"type":"message","content":[{"type":"output_text","text":"partial"}]}]}`,
+		`{"status":"completed","output":[{"type":"message","content":[{"type":"output_text","text":"short ALPHA summary"}]}]}`,
+	}
+	execute := func(ctx context.Context, _ *coreauth.Auth, req coreexecutor.Request, o coreexecutor.Options) (coreexecutor.Response, error) {
+		if !helps.IsPortableSummary(ctx) || string(o.OriginalRequest) != string(req.Payload) {
+			t.Fatal("retry lost summary guard or original request")
+		}
+		instructions = append(instructions, gjson.GetBytes(req.Payload, "instructions").String())
+		return coreexecutor.Response{Payload: []byte(responses[len(instructions)-1])}, nil
+	}
+	response, err := executePortableCompaction(context.Background(), cfg, nil, request, opts, false, execute)
+	if err != nil || len(instructions) != 2 || !strings.Contains(instructions[1], "shorter summary") || strings.Contains(instructions[0], "shorter summary") {
+		t.Fatalf("retry calls=%d err=%v", len(instructions), err)
+	}
+	ring, _ := helps.LoadPortableKeyring(cfg.PortableCompactionKeyFile)
+	if checkpoint, err := ring.Open(gjson.GetBytes(response.Payload, "output.0.encrypted_content").String(), "caller"); err != nil || checkpoint.Summary != "short ALPHA summary" {
+		t.Fatalf("checkpoint after retry: %v", err)
+	}
+	instructions = nil
+	responses[1] = responses[0]
+	if _, err = executePortableCompaction(context.Background(), cfg, nil, request, opts, false, execute); err == nil || len(instructions) != 2 {
+		t.Fatalf("unbounded too-long retries: calls=%d err=%v", len(instructions), err)
+	}
+	ctx := coreexecutor.WithDownstreamWebsocket(context.Background())
+	live := coreexecutor.Request{Payload: []byte(`{"previous_response_id":"resp-live","input":[{"type":"compaction_trigger"}]}`)}
+	instructions = nil
+	_, err = executePortableCompaction(ctx, cfg, &coreauth.Auth{Attributes: map[string]string{"websockets": "true"}}, live, opts, true, execute)
+	if !coreexecutor.IsUpstreamWebsocketReplayRequired(err) || len(instructions) != 1 {
+		t.Fatalf("live continuation must replay full input: calls=%d err=%v", len(instructions), err)
+	}
+}
