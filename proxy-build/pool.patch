new file mode 100644
index 0000000000000000000000000000000000000000..f840bab8110b8f2c4b128ad75524fbd6e25fab5b
--- /dev/null
+++ b/internal/runtime/executor/claude_executor_search_provenance.go
@@ -0,0 +1,378 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"net/http"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// Anthropic binds the encrypted parts of a server-side web search to the account
+// that ran it: web_search_result.encrypted_content and the encrypted_index of a
+// web_search_result_location citation. Measured 2026-10-18 against two pool
+// accounts: a history created on one account replays on that account and is
+// rejected on the other with
+//
+//	messages.1.content.0: Invalid `encrypted_content` in `search_result` block
+//	messages.1.content.2.citations.0: Invalid `encrypted_index` in `text` block
+//
+// (the second once the results are gone), while thinking signatures from the
+// same account replay on the other one. The pool moves a session to another
+// account when its own is unavailable, so a conversation that once searched the
+// web could not continue anywhere but on its original account (incident
+// 2026-10-18 17:52 CDT: a DNS timeout on one account moved a Codex chat to
+// another and every request after that failed with the encrypted_index 400).
+//
+// Recovery: on exactly that rejection, drop the account-bound search data (the
+// encrypted result entries and the citations that carry an encrypted_index) and
+// resend once on the same account. The answer text, the query and the
+// server_tool_use/web_search_tool_result pairing stay, so the model still sees
+// that it searched and what it concluded; only the source excerpts and citation
+// links are lost. The conversation is then remembered for that account, so its
+// later requests are stripped before sending instead of being rejected first.
+
+// claudeSearchProvenanceRejectionPattern matches Anthropic's message for a
+// search result or citation it cannot decrypt.
+var claudeSearchProvenanceRejectionPattern = regexp.MustCompile("Invalid `encrypted_(?:content|index)` in `[a-z_]+` block")
+
+const (
+	claudeSearchProvenanceMemoTTL        = 24 * time.Hour
+	claudeSearchProvenanceMemoMaxEntries = 4096
+	// Error bodies are a few hundred bytes; anything larger is not this error.
+	claudeSearchProvenanceErrorBodyLimit = 1 << 20
+)
+
+// isClaudeSearchProvenanceRejection reports whether an upstream response body is
+// Anthropic refusing the encrypted search data in the request history.
+func isClaudeSearchProvenanceRejection(status int, body []byte) bool {
+	if status != http.StatusBadRequest {
+		return false
+	}
+	if gjson.GetBytes(body, "error.type").String() != "invalid_request_error" {
+		return false
+	}
+	return claudeSearchProvenanceRejectionPattern.MatchString(gjson.GetBytes(body, "error.message").String())
+}
+
+type claudeSearchProvenanceStripReport struct {
+	Citations int
+	Results   int
+}
+
+func (r claudeSearchProvenanceStripReport) changed() bool {
+	return r.Citations > 0 || r.Results > 0
+}
+
+// stripClaudeSearchProvenance removes every encrypted web search result and every
+// citation carrying an encrypted_index from the request messages. Other citation
+// kinds (document locations) and web_search_tool_result_error content are kept.
+// Block positions never change, so message indices stay valid.
+func stripClaudeSearchProvenance(body []byte) ([]byte, claudeSearchProvenanceStripReport) {
+	var report claudeSearchProvenanceStripReport
+	messages := gjson.GetBytes(body, "messages")
+	if !messages.IsArray() {
+		return body, report
+	}
+	out := body
+	messages.ForEach(func(messageIndex, message gjson.Result) bool {
+		content := message.Get("content")
+		if !content.IsArray() {
+			return true
+		}
+		content.ForEach(func(blockIndex, block gjson.Result) bool {
+			path := fmt.Sprintf("messages.%d.content.%d", messageIndex.Int(), blockIndex.Int())
+			switch block.Get("type").String() {
+			case "text":
+				kept, dropped := filterRawArray(block.Get("citations"), "encrypted_index")
+				if dropped == 0 {
+					return true
+				}
+				report.Citations += dropped
+				if kept == nil {
+					out, _ = sjson.DeleteBytes(out, path+".citations")
+				} else {
+					out, _ = sjson.SetRawBytes(out, path+".citations", kept)
+				}
+			case "web_search_tool_result":
+				kept, dropped := filterRawArray(block.Get("content"), "encrypted_content")
+				if dropped == 0 {
+					return true
+				}
+				report.Results += dropped
+				if kept == nil {
+					// An empty result list is accepted next to its server_tool_use.
+					kept = []byte(`[]`)
+				}
+				out, _ = sjson.SetRawBytes(out, path+".content", kept)
+			}
+			return true
+		})
+		return true
+	})
+	if !report.changed() {
+		return body, report
+	}
+	return out, report
+}
+
+// filterRawArray drops the entries of array that carry a non-empty field. It
+// returns the kept entries (nil when none are left) and how many were dropped.
+func filterRawArray(array gjson.Result, field string) ([]byte, int) {
+	if !array.IsArray() {
+		return nil, 0
+	}
+	var kept []string
+	dropped := 0
+	array.ForEach(func(_, entry gjson.Result) bool {
+		if strings.TrimSpace(entry.Get(field).String()) != "" {
+			dropped++
+			return true
+		}
+		kept = append(kept, entry.Raw)
+		return true
+	})
+	if dropped == 0 || len(kept) == 0 {
+		return nil, dropped
+	}
+	return []byte("[" + strings.Join(kept, ",") + "]"), dropped
+}
+
+// claudeSearchProvenanceFingerprint identifies a conversation by the first
+// encrypted search value in its history. A history only grows at the end, so the
+// value stays the same for every later request of the conversation (and of its
+// forks) until compaction removes it. Empty when the history has none.
+func claudeSearchProvenanceFingerprint(body []byte) string {
+	first := ""
+	gjson.GetBytes(body, "messages").ForEach(func(_, message gjson.Result) bool {
+		message.Get("content").ForEach(func(_, block gjson.Result) bool {
+			switch block.Get("type").String() {
+			case "text":
+				first = firstNonEmptyField(block.Get("citations"), "encrypted_index")
+			case "web_search_tool_result":
+				first = firstNonEmptyField(block.Get("content"), "encrypted_content")
+			}
+			return first == ""
+		})
+		return first == ""
+	})
+	if first == "" {
+		return ""
+	}
+	sum := sha256.Sum256([]byte(first))
+	return hex.EncodeToString(sum[:])
+}
+
+func firstNonEmptyField(array gjson.Result, field string) string {
+	found := ""
+	array.ForEach(func(_, entry gjson.Result) bool {
+		found = strings.TrimSpace(entry.Get(field).String())
+		return found == ""
+	})
+	return found
+}
+
+// claudeSearchProvenanceMemo remembers conversations an account has refused, by
+// account ID and fingerprint. It only saves the rejected round trip: losing an
+// entry (TTL, eviction, restart) costs one more 400 and resend, never a failure.
+type claudeSearchProvenanceMemo struct {
+	mu      sync.Mutex
+	entries map[string]time.Time
+	now     func() time.Time
+}
+
+var claudeSearchProvenanceRejections = &claudeSearchProvenanceMemo{}
+
+func claudeSearchProvenanceMemoKey(authID, fingerprint string) string {
+	return authID + "\x00" + fingerprint
+}
+
+func (m *claudeSearchProvenanceMemo) clock() time.Time {
+	if m.now != nil {
+		return m.now()
+	}
+	return time.Now()
+}
+
+func (m *claudeSearchProvenanceMemo) empty() bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return len(m.entries) == 0
+}
+
+func (m *claudeSearchProvenanceMemo) remember(authID, fingerprint string) {
+	if fingerprint == "" {
+		return
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	now := m.clock()
+	if m.entries == nil {
+		m.entries = make(map[string]time.Time)
+	}
+	if len(m.entries) >= claudeSearchProvenanceMemoMaxEntries {
+		oldestKey, oldestAt := "", time.Time{}
+		for key, at := range m.entries {
+			if now.Sub(at) > claudeSearchProvenanceMemoTTL {
+				delete(m.entries, key)
+				continue
+			}
+			if oldestKey == "" || at.Before(oldestAt) {
+				oldestKey, oldestAt = key, at
+			}
+		}
+		if len(m.entries) >= claudeSearchProvenanceMemoMaxEntries && oldestKey != "" {
+			delete(m.entries, oldestKey)
+		}
+	}
+	m.entries[claudeSearchProvenanceMemoKey(authID, fingerprint)] = now
+}
+
+// rejected reports whether the account refused this conversation recently, and
+// refreshes the entry so an active conversation does not expire mid-use.
+func (m *claudeSearchProvenanceMemo) rejected(authID, fingerprint string) bool {
+	if fingerprint == "" {
+		return false
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	key := claudeSearchProvenanceMemoKey(authID, fingerprint)
+	at, ok := m.entries[key]
+	if !ok {
+		return false
+	}
+	now := m.clock()
+	if now.Sub(at) > claudeSearchProvenanceMemoTTL {
+		delete(m.entries, key)
+		return false
+	}
+	m.entries[key] = now
+	return true
+}
+
+func claudeSearchProvenanceAuthID(auth *cliproxyauth.Auth) string {
+	if auth == nil {
+		return ""
+	}
+	return auth.ID
+}
+
+// claudeBodyMayCarrySearchProvenance is a byte scan that lets ordinary requests
+// skip parsing the whole history.
+func claudeBodyMayCarrySearchProvenance(body []byte) bool {
+	return bytes.Contains(body, []byte(`"encrypted_index"`)) || bytes.Contains(body, []byte(`"encrypted_content"`))
+}
+
+// stripKnownRejectedClaudeSearchProvenance strips the search data of a
+// conversation this account has already refused. It runs before signing, on the
+// body about to be sent.
+func stripKnownRejectedClaudeSearchProvenance(ctx context.Context, auth *cliproxyauth.Auth, body []byte) []byte {
+	if claudeSearchProvenanceRejections.empty() || !claudeBodyMayCarrySearchProvenance(body) {
+		return body
+	}
+	fingerprint := claudeSearchProvenanceFingerprint(body)
+	if !claudeSearchProvenanceRejections.rejected(claudeSearchProvenanceAuthID(auth), fingerprint) {
+		return body
+	}
+	stripped, report := stripClaudeSearchProvenance(body)
+	if report.changed() {
+		helps.LogWithRequestID(ctx).Debugf("claude: stripped web search provenance this account refused before (citations=%d results=%d)", report.Citations, report.Results)
+	}
+	return stripped
+}
+
+// doClaudeUpstreamRequestWithSearchProvenanceRecovery sends httpReq. When
+// Anthropic rejects the request because its history holds web search data from
+// another account, it resends once on the same account with that data removed
+// (re-signed when resign is set) and returns the second response. Any other
+// response is returned to the caller unchanged, body included.
+func doClaudeUpstreamRequestWithSearchProvenanceRecovery(
+	ctx context.Context,
+	cfg *config.Config,
+	client *http.Client,
+	httpReq *http.Request,
+	auth *cliproxyauth.Auth,
+	body []byte,
+	resign bool,
+	requestLog helps.UpstreamRequestLog,
+) (*http.Response, error) {
+	httpResp, err := doClaudeUpstreamRequest(client, httpReq)
+	if err != nil || httpResp == nil || httpResp.StatusCode != http.StatusBadRequest {
+		return httpResp, err
+	}
+	if !claudeBodyMayCarrySearchProvenance(body) {
+		return httpResp, nil
+	}
+	stripped, report := stripClaudeSearchProvenance(body)
+	if !report.changed() {
+		return httpResp, nil
+	}
+
+	raw, readErr := io.ReadAll(io.LimitReader(httpResp.Body, claudeSearchProvenanceErrorBodyLimit+1))
+	if readErr != nil || len(raw) > claudeSearchProvenanceErrorBodyLimit {
+		// Hand back what was read followed by the rest, so the caller's error
+		// handling sees the same body it would have seen without this check.
+		httpResp.Body = struct {
+			io.Reader
+			io.Closer
+		}{io.MultiReader(bytes.NewReader(raw), httpResp.Body), httpResp.Body}
+		return httpResp, nil
+	}
+	_ = httpResp.Body.Close()
+	httpResp.Body = io.NopCloser(bytes.NewReader(raw))
+	decodedReader, decErr := decodeResponseBody(io.NopCloser(bytes.NewReader(raw)), claudeResponseContentEncoding(httpResp.Header))
+	if decErr != nil {
+		return httpResp, nil
+	}
+	decoded, decErr := io.ReadAll(decodedReader)
+	_ = decodedReader.Close()
+	if decErr != nil || !isClaudeSearchProvenanceRejection(httpResp.StatusCode, decoded) {
+		return httpResp, nil
+	}
+
+	authID := claudeSearchProvenanceAuthID(auth)
+	claudeSearchProvenanceRejections.remember(authID, claudeSearchProvenanceFingerprint(body))
+	helps.RecordAPIResponseMetadata(ctx, cfg, httpResp.StatusCode, httpResp.Header.Clone())
+	helps.AppendAPIResponseChunk(ctx, cfg, decoded)
+	helps.LogWithRequestID(ctx).Infof(
+		"claude: auth %s rejected web search data from another account (%s); resending without it (citations=%d results=%d)",
+		authID, gjson.GetBytes(decoded, "error.message").String(), report.Citations, report.Results,
+	)
+
+	if resign {
+		var errSign error
+		stripped, errSign = signAnthropicMessagesBody(stripped)
+		if errSign != nil {
+			return nil, fmt.Errorf("re-sign Claude request without web search provenance: %w", errSign)
+		}
+	}
+	retryReq := httpReq.Clone(ctx)
+	retryReq.Body = io.NopCloser(bytes.NewReader(stripped))
+	retryReq.ContentLength = int64(len(stripped))
+	retryReq.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(stripped)), nil
+	}
+	// A resend is a new request to Anthropic; native clients give each one its own id.
+	for name := range retryReq.Header {
+		if strings.EqualFold(name, "x-client-request-id") {
+			retryReq.Header[name] = []string{uuid.New().String()}
+		}
+	}
+	requestLog.Headers = retryReq.Header.Clone()
+	requestLog.Body = stripped
+	helps.RecordAPIRequest(ctx, cfg, requestLog)
+	return doClaudeUpstreamRequest(client, retryReq)
+}
