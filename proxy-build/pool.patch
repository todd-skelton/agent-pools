+func TestLiveModelsRouteEachAccountOnItsOwnList(t *testing.T) {
+	a, b, c := oauthAuth("live-claude-a", "claude"), oauthAuth("live-claude-b", "claude"), oauthAuth("live-claude-c", "claude")
+	h := newLiveModelsHarness(t, "", a, b, c)
+	h.lists[a.ID] = modelList("claude", "claude-sonnet-5-5", "claude-opus-5-5")
+	h.lists[b.ID] = modelList("claude", "claude-sonnet-5-5", "claude-opus-5-5")
+	h.lists[c.ID] = modelList("claude", "claude-opus-5-5")
+	for _, auth := range []*coreauth.Auth{a, b, c} {
+		h.service.registerModelsForAuth(context.Background(), auth)
+	}
+	// Before the first read no credential serves anything: the static
+	// catalog lists models an account may not reach.
+	for _, auth := range []*coreauth.Auth{a, b, c} {
+		if got := registeredIDs(auth.ID); len(got) != 0 {
+			t.Fatalf("%s registered %v before its live list was read", auth.ID, got)
+		}
+	}
+	h.manager.pass(context.Background(), true)
+
+	reg := internalregistry.GetGlobalRegistry()
+	for _, auth := range []*coreauth.Auth{a, b} {
+		if !reg.ClientSupportsModel(auth.ID, "claude-sonnet-5-5") {
+			t.Fatalf("%s should serve claude-sonnet-5-5", auth.ID)
+		}
+	}
+	if reg.ClientSupportsModel(c.ID, "claude-sonnet-5-5") {
+		t.Fatal("credential without the model in its live list must not be routed to it")
+	}
+	if got := registeredIDs(c.ID); !reflect.DeepEqual(got, []string{"claude-opus-5-5"}) {
+		t.Fatalf("c registered %v, want only its live list", got)
+	}
+	if status, ok := livemodels.Lookup(a.ID); !ok || status.Source != livemodels.SourceLive || status.Models != 2 {
+		t.Fatalf("status = %+v", status)
+	}
+}
